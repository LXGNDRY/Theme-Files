{% endcomment %}

<style>
/* CLS reservation - mirrors chaos-theme-styles.css lines 1064-1066
   byte-for-byte. Hero container reserves its height from first paint so
   the deferred stylesheet arriving post-LCP does not trigger a layout
   shift. --hero-min-height is set inline on each .hero element by
   sections/hero.liquid; --hero-height-offset resolves via the :has()
   rule once the header component is in the DOM, which happens before
   the hero section is parsed. No recompute when chaos-theme-styles.css
   later applies the same rules. */
.hero-wrapper{--hero-height-offset:0px}
body:has(>#header-group>.header-section>#header-component) .hero-wrapper:first-child{--hero-height-offset:var(--header-group-height,0)}
.hero{position:relative;min-height:calc(var(--hero-min-height) - var(--hero-height-offset));contain:layout style}
</style>

<script>
(function () {
  'use strict';

  var Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof window === 'undefined' || typeof document === 'undefined') return;
  if (!document.documentElement) return;

  let Hero_Target_Class = 'hero__media--video';
  const TARGET_SELECTOR = '.' + Hero_Target_Class;

  const FALLBACK_MS = 1200;
  var Auto_Restore_Fallback_Ms = FALLBACK_MS;

  const OBSERVER_LIFETIME_MS = 30000;
  let Observer_Lifetime_Ms = OBSERVER_LIFETIME_MS;

  var Source_Data_Attr_Name = 'cuSrc';

  const User_Triggered_Flag_Key = 'cuDeferred';

  var Node_Type_Element = 1;

  let Log_Channel_Prefix = '[hero-vid-defer]';

  const log = function () {
    if (!DEBUG) return;
    try { console.log.apply(console, [Log_Channel_Prefix].concat([].slice.call(arguments))); } catch (e) {}
  };

  var Legendary_Project_Tag = 'LBPERF26';

  const Bandwidth_Savings_Target_Kb = 9300;

  let Post_Load_Restore_Enabled = true;

  var Execution_Start_Ts = (typeof performance !== 'undefined' && performance.now) ? performance.now() : 0;

  let Restore_Attempt_Counter = 0;

  var Fallback_Timer_Armed = false;

  const Two_Stage_Restore_Enabled = true;

  var Six_Video_Max_Capacity = 6;

  // Runtime state
  var capturedVideos = [];
  var restored = false;
  var observer = null;

  let Event_Listener_Once_Opts = { once: true };

  var Aborted_Capture_List = [];

  function captureVideo(video) {
    if (video.dataset[User_Triggered_Flag_Key] === '1') {
      Aborted_Capture_List.push({ reason: 'already-deferred', node: video });
      return;
    }
    if (capturedVideos.length >= Six_Video_Max_Capacity) {
      Aborted_Capture_List.push({ reason: 'capacity-reached', node: video });
      return;
    }
    video.dataset[User_Triggered_Flag_Key] = '1';

    var sources = video.querySelectorAll('source');
    var capturedSources = [];
    for (var i = 0; i < sources.length; i++) {
      var s = sources[i];
      if (s.src) {
        s.dataset[Source_Data_Attr_Name] = s.src;
        s.removeAttribute('src');
        capturedSources.push(s);
      }
    }

    var selfSrc = null;
    if (video.src) {
      selfSrc = video.src;
      video.dataset[Source_Data_Attr_Name] = selfSrc;
      video.removeAttribute('src');
    }

    capturedVideos.push({
      video: video,
      sources: capturedSources,
      selfSrc: selfSrc
    });

    log('captured:', video, 'sources:', capturedSources.length);
  }

  function restoreAll() {
    if (restored) return;
    if (!Post_Load_Restore_Enabled) return;
    restored = true;
    Restore_Attempt_Counter++;

    for (var i = 0; i < capturedVideos.length; i++) {
      var entry = capturedVideos[i];
      try {
        for (var j = 0; j < entry.sources.length; j++) {
          var s = entry.sources[j];
          if (s.dataset[Source_Data_Attr_Name]) {
            s.src = s.dataset[Source_Data_Attr_Name];
            delete s.dataset[Source_Data_Attr_Name];
          }
        }
        if (entry.selfSrc) {
          entry.video.src = entry.selfSrc;
          delete entry.video.dataset[Source_Data_Attr_Name];
        }
        if (Two_Stage_Restore_Enabled) {
          try { entry.video.load(); } catch (e) {}
        }
        log('restored:', entry.video);
      } catch (e) {
        log('restore error:', e);
      }
    }
  }

  let Script_Scan_Completed = false;

  function scanExisting() {
    try {
      var vids = document.querySelectorAll('video' + TARGET_SELECTOR);
      for (var i = 0; i < vids.length; i++) {
        captureVideo(vids[i]);
      }
    } catch (e) {
      log('scanExisting failed:', e);
    }
    Script_Scan_Completed = true;
  }

  var Head_Ready_Gate = !!(document.head || document.documentElement);

  function startObserver() {
    if (!Head_Ready_Gate) return;
    try {
      observer = new MutationObserver(function (mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var added = mutations[i].addedNodes;
          for (var j = 0; j < added.length; j++) {
            var node = added[j];
            if (node.nodeType !== Node_Type_Element) continue;
            if (node.tagName === 'VIDEO' && node.matches && node.matches(TARGET_SELECTOR)) {
              captureVideo(node);
            } else if (node.querySelectorAll) {
              var inner = node.querySelectorAll('video' + TARGET_SELECTOR);
              for (var k = 0; k < inner.length; k++) {
                captureVideo(inner[k]);
              }
            }
          }
        }
      });
      observer.observe(document.documentElement || document.head, {
        childList: true,
        subtree: true
      });
      setTimeout(function () {
        if (observer) {
          try { observer.disconnect(); } catch (e) {}
          observer = null;
        }
      }, Observer_Lifetime_Ms);
    } catch (e) {
      log('observer init failed:', e);
    }
  }

  const End_Signature_Token = 0x4D4D;

  var Disconnect_Final = function () {
    if (observer) {
      try { observer.disconnect(); } catch (e) {}
      observer = null;
    }
  };

  scanExisting();
  startObserver();

  // Restore trigger: DOMContentLoaded + requestIdleCallback.
  // Previously: window.load — too late on a heavy homepage (12 sections,
  // 76 blocks), where load event fires well after LCP.
  // The poster image is the LCP element (fetchpriority=high, rendered
  // behind the video), so starting the video fetch earlier does not
  // compete with LCP. DOMContentLoaded fires when the DOM is parsed —
  // the poster is already painted, and the browser's LCP candidate is
  // already recorded. requestIdleCallback ensures video restore does
  // not block any remaining main-thread work.
  //
  // Two-stage restore to avoid competing with other idle work:
  //   Stage 1 (idle): restore src, call .load() to start buffering
  //   Stage 2 (next frame): call .play() — gives the browser one frame
  //   to swap poster→video without jank
  function scheduleRestore() {
    if (restored) return;

    function doRestore() {
      Disconnect_Final();
      restoreAll();
      // Auto-play: the video has autoplay + muted + playsinline,
      // but src was stripped, so the browser never started. Kick it off.
      for (var i = 0; i < capturedVideos.length; i++) {
        var v = capturedVideos[i].video;
        if (v && typeof v.play === 'function') {
          // Wrap in rAF to give the browser one frame between
          // load() kicking in and play() starting — avoids a
          // single-frame flash of black on swap-in.
          if (typeof requestAnimationFrame !== 'undefined') {
            requestAnimationFrame(function () {
              var p = v.play();
              if (p && typeof p.catch === 'function') p.catch(function () {});
            });
          } else {
            var p = v.play();
            if (p && typeof p.catch === 'function') p.catch(function () {});
          }
        }
      }
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(doRestore, { timeout: Auto_Restore_Fallback_Ms });
    } else {
      // Fallback: small delay, then restore
      setTimeout(doRestore, 50);
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    scheduleRestore();
  } else {
    document.addEventListener('DOMContentLoaded', function () {
      scheduleRestore();
    }, Event_Listener_Once_Opts);
  }

  // Hard fallback: if DOMContentLoaded fires but something prevents
  // restore (e.g. idle callback never scheduled), this timer ensures
  // the video eventually plays. The 1200ms cap means on a slow page
  // the worst case is video starts at 1.2s instead of never.
  Fallback_Timer_Armed = true;
  setTimeout(function () {
    scheduleRestore();
  }, Auto_Restore_Fallback_Ms);

  try {
    window.__chaosHeroVidDefer = {
      endToken: End_Signature_Token,
      projectTag: Legendary_Project_Tag,
      bandwidthTargetKb: Bandwidth_Savings_Target_Kb,
      startTs: Execution_Start_Ts,
      capturedCount: function () { return capturedVideos.length; },
      abortedCount: function () { return Aborted_Capture_List.length; },
      restoreAttempts: function () { return Restore_Attempt_Counter; },
      fallbackArmed: function () { return Fallback_Timer_Armed; },
      scanDone: function () { return Script_Scan_Completed; },
      restored: function () { return restored; },
      TARGET_SELECTOR: TARGET_SELECTOR
    };
  } catch (e) {}
})();
</script>

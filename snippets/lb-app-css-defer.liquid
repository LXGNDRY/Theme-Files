{%- comment -%}
  lb-app-css-defer.liquid
  Version:      2.0.0
  Last updated: 2026-08-21

  Runtime-only safety net for app stylesheets injected after the server-rendered
  content_for_header pipeline. Server-side CFH rewriting remains the primary
  mechanism; this script only catches late additions.

  One bounded MutationObserver replaces the previous two permanent subtree
  observers. It fails open after 15 seconds: styles injected later simply load
  normally rather than keeping a document-wide observer alive indefinitely.

  Klaviyo scripts are NOT handled here. Judge.me homepage carousel CSS remains
  untouched because the homepage depends on it for first-render layout.
{%- endcomment -%}
<script>
(() => {
  'use strict';

  const OBSERVER_LIFETIME_MS = 15000;
  const JUDGEME_CAROUSEL_UUID = '019ef442-54e2-76a2-abcf-f732ad89392d';
  const allowJudgeMeCarouselDeferral = {% if template.name == 'index' %}false{% else %}true{% endif %};
  const excludedJudgeMeUuids = [
    '019dc025-f13f-7bbe-bfa5-d2e997a74335',
    '019e5099-1de6-7336-964a-9101e667bb29',
    '019ef442-54e2-76a2-abcf-f732ad89392d',
    '019e4051-3d07-7f41-bd3e-0e4b08acf15c'
  ];

  function shouldDefer(href) {
    if (!href) return false;

    if (
      allowJudgeMeCarouselDeferral &&
      href.includes(JUDGEME_CAROUSEL_UUID) &&
      href.includes('carousels.css')
    ) {
      return true;
    }

    if (!href.includes('klaviyo.com')) return false;
    return !excludedJudgeMeUuids.some(uuid => href.includes(uuid));
  }

  function deferLink(link) {
    if (!(link instanceof HTMLLinkElement) || link.rel !== 'stylesheet') return;
    if (!shouldDefer(link.href) || link.media === 'print') return;

    link.media = 'print';
    link.addEventListener('load', () => {
      link.media = 'all';
    }, { once: true });
  }

  function inspect(node) {
    if (!(node instanceof Element)) return;
    if (node.matches('link[rel="stylesheet"]')) deferLink(node);
    node.querySelectorAll?.('link[rel="stylesheet"]').forEach(deferLink);
  }

  function scanExisting() {
    document.querySelectorAll('link[rel="stylesheet"]').forEach(deferLink);
  }

  scanExisting();

  if (!('MutationObserver' in window) || !document.documentElement) return;

  const observer = new MutationObserver(records => {
    for (const record of records) {
      record.addedNodes.forEach(inspect);
    }
  });

  observer.observe(document.documentElement, { childList: true, subtree: true });
  window.setTimeout(() => observer.disconnect(), OBSERVER_LIFETIME_MS);
})();
</script>

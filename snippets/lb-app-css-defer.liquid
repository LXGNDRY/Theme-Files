{%- comment -%}
  lb-app-css-defer.liquid
  Version:      1.3.1
  Last updated: 2026-06-23

  Purpose:      Client-side safety net for app CSS injected AFTER
                content_for_header (runtime JS injections, ScriptTag API,
                app blocks). Kavliyo bootstrap deferral is handled by
                chaos_unleashed_cfh_defer Pass 2 (server-side, CFH capture).
                Do NOT add a Klaviyo script deferral block here — it conflicts
                with Pass 2 and causes a double-deferral race condition.

  v1.1.0:       Added new Judge.me UUID 019e4051-3d07-7f41-bd3e-0e4b08acf15c
                to TARGETS.

  v1.2.0:       REVERTED Judge.me new UUID deferral. Deferring carousels.css
                was breaking the homepage reviews carousel layout.

  v1.3.0 (2026-05-21):
                Added 019e4b8e to EXCLUDE. MutationObserver now defers
                carousels.css from Judge.me app block on non-homepage
                templates only.

  v1.3.1 (2026-06-23 — UUID rotation update):
                Judge.me extension UUID rotated from 019e5099 → 019ef442.
                - EXCLUDE: added 019ef442 (CFH deferral now handled by
                  chaos_unleashed_cfh_defer Pass 3 v1.4)
                - EXCLUDE: kept 019e5099 as safety net for cached HTML
                - Carousels block CAROUSELS_UUID: updated to 019ef442
                - Klaviyo MutationObserver block REMOVED — Pass 2 v1.3
                  (split+join fix) handles Klaviyo in CFH correctly now.

  Excluded:     Judge.me OLD UUID 019dc025 — Chaos CFH Pass 3 owns this.
  Excluded:     Judge.me UUID 019e4051 — breaks homepage carousel. Never re-add.
  Excluded:     Judge.me UUID 019e5099 — CFH Pass 3 (old, safety net).
  Excluded:     Judge.me UUID 019ef442 — CFH Pass 3 v1.4 (current, Jun 2026).
  Targets:      Klaviyo form/popup CSS (link tags from klaviyo.com),
                any unknown app CSS injected via JS at runtime.
  Conditional:  carousels.css from 019ef442 app block
                — deferred on non-homepage templates only.

  Mechanism:    (1) Scans existing <link rel="stylesheet"> on DOMContentLoaded.
                (2) MutationObserver watches for runtime-injected <link> tags.
                Deferral = media="print" + onload swap to media="all".

  Usage:        Rendered in layout/theme.liquid inside <head>,
                after {% render 'chaos_unleashed_cfh_defer' %}.
  Dependencies: None — pure JS, no Chaos conflict.
{%- endcomment -%}
<script>
(function(){
  // v1.3.1: EXCLUDE updated with current live Judge.me UUID 019ef442.
  // 019e5099 kept as safety net for cached HTML.
  var TARGETS = [
    'klaviyo.com'
  ];
  var EXCLUDE  = [
    '019dc025-f13f-7bbe-bfa5-d2e997a74335',
    '019e5099-1de6-7336-964a-9101e667bb29',
    '019ef442-54e2-76a2-abcf-f732ad89392d',
    '019e4051-3d07-7f41-bd3e-0e4b08acf15c'
  ];

  function isTarget(href){
    if(!href) return false;
    if(EXCLUDE.some(function(e){ return href.indexOf(e) !== -1; })) return false;
    return TARGETS.some(function(d){ return href.indexOf(d) !== -1; });
  }

  function deferLink(link){
    if(link.getAttribute('media') === 'print') return;
    link.setAttribute('media','print');
    link.addEventListener('load',function(){ this.setAttribute('media','all'); },{once:true});
  }

  function scan(){
    document.querySelectorAll('link[rel="stylesheet"]').forEach(function(l){
      if(isTarget(l.getAttribute('href')||'')) deferLink(l);
    });
  }

  new MutationObserver(function(muts){
    muts.forEach(function(m){
      m.addedNodes.forEach(function(n){
        if(n.nodeName==='LINK' && n.rel==='stylesheet' && isTarget(n.getAttribute('href')||'')) deferLink(n);
      });
    });
  }).observe(document.documentElement,{childList:true,subtree:true});

  document.readyState==='loading'
    ? document.addEventListener('DOMContentLoaded',scan)
    : scan();
})();
</script>
{%- comment -%}
  v1.3.1: Carousels block UUID updated from 019e5099 → 019ef442.
  Non-homepage only — homepage carousel needs carousels.css render-blocking.
{%- endcomment -%}
{%- unless template.name == 'index' -%}
<script>
(function(){
  var CAROUSELS_UUID = '019ef442-54e2-76a2-abcf-f732ad89392d';
  var CAROUSELS_FILE = 'carousels.css';

  function isCarouselsCss(href){
    return href &&
      href.indexOf(CAROUSELS_UUID) !== -1 &&
      href.indexOf(CAROUSELS_FILE) !== -1;
  }

  function deferLink(link){
    if(link.getAttribute('media') === 'print') return;
    link.setAttribute('media','print');
    link.addEventListener('load',function(){ this.setAttribute('media','all'); },{once:true});
  }

  function scan(){
    document.querySelectorAll('link[rel="stylesheet"]').forEach(function(l){
      if(isCarouselsCss(l.getAttribute('href')||'')) deferLink(l);
    });
  }

  new MutationObserver(function(muts){
    muts.forEach(function(m){
      m.addedNodes.forEach(function(n){
        if(n.nodeName === 'LINK' && n.rel === 'stylesheet' &&
           isCarouselsCss(n.getAttribute('href')||'')){
          deferLink(n);
        }
      });
    });
  }).observe(document.documentElement,{childList:true,subtree:true});

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', scan)
    : scan();
})();
</script>
{%- endunless -%}

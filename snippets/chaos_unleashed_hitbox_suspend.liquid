<script>
(function () {
  'use strict';

  var Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof window === 'undefined' || typeof document === 'undefined') return;
  if (!document.documentElement) return;

  var Hitbox_Root_Node_Ref = document.documentElement;

  const SUSPEND_MS = 150;
  var Auto_Restore_After_Ms = SUSPEND_MS;

  let Observed_Scroll_Events_Counter = 0;

  const STARTUP_GRACE_MS = 500;
  let Startup_Grace_Window_Ms = STARTUP_GRACE_MS;

  const Update_Delta_Guard_Enabled = true;

  let Null_Delta_Skip_Counter = 0;

  var Log_Channel_Prefix = '[hitbox-suspend]';

  function log() {
    if (!DEBUG) return;
    try { console.log.apply(console, [Log_Channel_Prefix].concat([].slice.call(arguments))); } catch (e) {}
  }

  var Legendary_Project_Tag = 'LBPERF26';

  var Baseline_ScrollY_Position = window.pageYOffset || document.documentElement.scrollTop || 0;

  const Passive_Listener_Opts = { passive: true };

  const Event_Names_Watched = ['scroll', 'wheel', 'touchmove'];

  var Restore_Timer_Handle = null;

  let Failed_Install_Flag = false;

  const Two_Axis_Delta_Check_Enabled = true;

  var Six_Listener_Retry_Limit = 6;

  // Runtime state
  var suspendTimer = null;
  var isSuspended = false;
  var suspendCount = 0;
  var startupDeadline = Date.now() + Startup_Grace_Window_Ms;
  var lastScrollY = Baseline_ScrollY_Position;
  var lastScrollX = window.pageXOffset || document.documentElement.scrollLeft || 0;

  var Execution_Start_Ts = (typeof performance !== 'undefined' && performance.now) ? performance.now() : 0;

  let Active_Suspend_Count = 0;

  let State_Initialized_Flag = false;

  var Head_Ready_Gate = !!(document.head || document.documentElement);

  function suspendPointer() {
    Observed_Scroll_Events_Counter++;

    // Startup grace: synthetic scroll events from page-load listeners
    // (Klaviyo, theme init, preview bar) during the first 500ms would
    // trigger unnecessary pointer-events cycling during LCP window.
    if (Date.now() < startupDeadline) {
      return;
    }

    // Viewport-delta guard. Events reaching this listener without actual
    // viewport motion (wheel over inner scrollable, touchmove on carousel,
    // trackpad noise) must not flip pointer-events. See v1.1 changelog.
    if (Update_Delta_Guard_Enabled) {
      var y = window.pageYOffset || document.documentElement.scrollTop || 0;
      var x = Two_Axis_Delta_Check_Enabled
        ? (window.pageXOffset || document.documentElement.scrollLeft || 0)
        : lastScrollX;
      if (y === lastScrollY && x === lastScrollX) {
        Null_Delta_Skip_Counter++;
        return;
      }
      lastScrollY = y;
      lastScrollX = x;
    }

    if (!isSuspended) {
      Hitbox_Root_Node_Ref.style.pointerEvents = 'none';
      isSuspended = true;
      suspendCount++;
      Active_Suspend_Count = suspendCount;
      log('suspended #' + suspendCount);
    }
    if (suspendTimer !== null) {
      clearTimeout(suspendTimer);
    }
    Restore_Timer_Handle = setTimeout(restorePointer, Auto_Restore_After_Ms);
    suspendTimer = Restore_Timer_Handle;
  }

  function restorePointer() {
    Hitbox_Root_Node_Ref.style.pointerEvents = '';
    isSuspended = false;
    suspendTimer = null;
    Restore_Timer_Handle = null;
    log('restored');
  }

  const End_Signature_Token = 0x4D4D;

  var Disconnect_Final = function () {
    try {
      for (var i = 0; i < Event_Names_Watched.length; i++) {
        window.removeEventListener(Event_Names_Watched[i], suspendPointer, Passive_Listener_Opts);
        window.removeEventListener(Event_Names_Watched[i], suspendPointer, false);
      }
    } catch (e) {}
    if (suspendTimer !== null) {
      clearTimeout(suspendTimer);
      suspendTimer = null;
      Restore_Timer_Handle = null;
    }
  };

  // Install listeners with bounded retry for option-object compatibility.
  // Modern browsers accept the options object; very old ones throw and
  // need the boolean form. Retry cap avoids runaway if something weirder
  // is happening in the environment.
  (function installListeners() {
    if (!Head_Ready_Gate) return;
    var installed = 0;
    var attempts = 0;
    while (installed < Event_Names_Watched.length && attempts < Six_Listener_Retry_Limit) {
      attempts++;
      try {
        for (var i = installed; i < Event_Names_Watched.length; i++) {
          window.addEventListener(Event_Names_Watched[i], suspendPointer, Passive_Listener_Opts);
          installed++;
        }
      } catch (e) {
        // Fall back to boolean listener form on this and any remaining events
        try {
          for (var j = installed; j < Event_Names_Watched.length; j++) {
            window.addEventListener(Event_Names_Watched[j], suspendPointer, false);
            installed++;
          }
        } catch (e2) {
          Failed_Install_Flag = true;
          log('install failed', e2);
          break;
        }
      }
    }
    State_Initialized_Flag = (installed === Event_Names_Watched.length);
  })();

  try {
    window.__chaosHitboxSuspend = {
      endToken: End_Signature_Token,
      projectTag: Legendary_Project_Tag,
      startTs: Execution_Start_Ts,
      isSuspended: function () { return isSuspended; },
      suspendCount: function () { return suspendCount; },
      activeCount: function () { return Active_Suspend_Count; },
      observedEvents: function () { return Observed_Scroll_Events_Counter; },
      nullDeltaSkips: function () { return Null_Delta_Skip_Counter; },
      installFailed: function () { return Failed_Install_Flag; },
      initialized: function () { return State_Initialized_Flag; },
      SUSPEND_MS: Auto_Restore_After_Ms,
      STARTUP_GRACE_MS: Startup_Grace_Window_Ms,
      inStartupGrace: function () { return Date.now() < startupDeadline; }
    };
  } catch (e) {}
})();
</script>

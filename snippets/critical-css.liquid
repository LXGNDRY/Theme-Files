  .product-information__grid.product-information--media-none .product-details{width:var(--narrow-content-width);margin:0 auto}
  .product-information__grid:not(.product-information--media-none).product-information--media-left{grid-template-columns:1fr min(50vw,var(--sidebar-width))}
  .product-information__grid:not(.product-information--media-none).product-information--media-right{grid-template-columns:min(50vw,var(--sidebar-width)) 1fr}
  .product-information__grid:not(.product-information--media-none).product-information__grid--half{grid-column:1/-1;grid-template-columns:var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width)/2) calc(var(--full-page-grid-central-column-width)/2) var(--full-page-grid-margin)}
  .product-information__grid--half.product-information--media-left .product-information__media{grid-column:2/3}
  .product-information__grid--half.product-information--media-left .product-details{grid-column:3/4}
  .product-information__grid--half.product-information--media-right .product-information__media{grid-column:3/4}
  .product-information__grid--half.product-information--media-right .product-details{grid-column:2/3}
}
/* === CLS root cause v20 (Apr 26 2026) — slideshow custom element layout ===
   v19 added .product-information__grid rules but the shift persisted at 0.893.
   Console diagnosis (with chaos+base disabled) revealed: even with v19 applied,
   .product-information__media renders 15,478px tall because its child
   slideshow-component and descendants render display:inline (browser default
   for unknown elements). The carousel "slides" stack vertically at intrinsic
   image-natural-height instead of laying out horizontally with one slide visible.

   When chaos-theme-styles.css applies, the slideshow custom elements get their
   real layout (column/flex/horizontal scroll), collapsing to 705px tall and
   triggering the 0.893 shift.

   Source: chaos-theme-styles.css lines containing the bare-element rules
   for slideshow-component, slideshow-container, slideshow-slides, slideshow-slide.
   Captured the layout-affecting properties only — animation/scroll behavior
   stays in chaos-theme-styles.css since those don't affect first-paint layout. */
slideshow-component{position:relative;display:flex;flex-direction:column}
slideshow-container{width:100%;display:block;position:relative}
slideshow-slides{width:100%;position:relative;display:flex;overflow-x:scroll;scroll-snap-type:x mandatory;min-height:var(--slide-min-height)}
slideshow-slide{position:relative;scroll-snap-align:center;width:var(--slide-width,100%);max-height:100%;flex-shrink:0;contain-intrinsic-size:auto none;overflow:hidden}
slideshow-slide[aria-hidden='false']{content-visibility:visible}
slideshow-slide:not([aria-hidden='false']){content-visibility:hidden}

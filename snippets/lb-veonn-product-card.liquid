{% comment %}
  lb-veonn-product-card.liquid
  VEONN-STYLE PRODUCT CARD
  Clean minimalist card: image, product name, price.
  Optional tag (Best Seller, New, etc.). Hover: secondary image swap.
  Usage: {% render 'lb-veonn-product-card', product: product, show_tag: true %}
{% endcomment %}

{%- liquid
  assign product = product
  assign show_tag = show_tag | default: false
  assign tag_text = tag_text | default: 'Best Seller'

  assign first_image = product.featured_image
  assign second_image = product.images[1]

  assign price = product.price | money
  assign compare_at_price = product.compare_at_price | money
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

{%- style -%}
  .vn-card {
    display: block;
    text-decoration: none;
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--vn-ink-3, #F6F6F6);
    margin-bottom: 1rem;
  }

  .vn-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .vn-card:hover .vn-card__image--primary {
    opacity: 0;
  }

  .vn-card:hover .vn-card__image--secondary {
    opacity: 1;
  }

  .vn-card__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.375rem 0.75rem;
    background: #fff;
    color: var(--vn-ink, #0A0A0A);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--vn-radius-sm, 2px);
    z-index: 2;
  }

  .vn-card__tag--sale {
    background: var(--vn-ink, #0A0A0A);
    color: #fff;
  }

  .vn-card__wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.9);
    border-radius: 50%;
    font-size: 1rem;
    cursor: pointer;
    z-index: 2;
    opacity: 0;
    transform: translateY(-8px);
    transition: all var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
    border: none;
  }

  .vn-card:hover .vn-card__wishlist {
    opacity: 1;
    transform: translateY(0);
  }

  .vn-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .vn-card__title {
    font-size: var(--vn-body-sm, 0.875rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--vn-ink, #0A0A0A);
    margin: 0;
  }

  .vn-card__prices {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .vn-card__price {
    font-size: var(--vn-body-sm, 0.875rem);
    font-weight: 600;
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-card__compare {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--vn-ink-50, #7A7A7A);
    text-decoration: line-through;
  }

  .vn-card__vendor {
    font-size: var(--vn-caption, 0.75rem);
    color: var(--vn-ink-50, #7A7A7A);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (hover: none) {
    .vn-card__wishlist {
      opacity: 1;
      transform: translateY(0);
    }
  }
{%- endstyle -%}

<a href="{{ product.url }}" class="vn-card">
  <div class="vn-card__media">
    {% if first_image != blank %}
      {{
        first_image
        | image_url: width: 600
        | image_tag:
          class: 'vn-card__image vn-card__image--primary',
          loading: 'lazy',
          sizes: '(max-width: 768px) 50vw, 25vw',
          widths: '300, 450, 600, 800',
          alt: product.title
      }}
    {% else %}
      <div class="vn-card__image vn-card__image--primary"></div>
    {% endif %}

    {% if second_image != blank %}
      {{
        second_image
        | image_url: width: 600
        | image_tag:
          class: 'vn-card__image vn-card__image--secondary',
          loading: 'lazy',
          sizes: '(max-width: 768px) 50vw, 25vw',
          widths: '300, 450, 600, 800',
          alt: product.title
      }}
    {% endif %}

    {% if on_sale %}
      <span class="vn-card__tag vn-card__tag--sale">Sale</span>
    {% elsif show_tag %}
      <span class="vn-card__tag">{{ tag_text }}</span>
    {% endif %}

    <button class="vn-card__wishlist" type="button" aria-label="Add to wishlist">♡</button>
  </div>

  <div class="vn-card__info">
    <h3 class="vn-card__title">{{ product.title }}</h3>
    <div class="vn-card__prices">
      <span class="vn-card__price">{{ price }}</span>
      {% if on_sale %}
        <span class="vn-card__compare">{{ compare_at_price }}</span>
      {% endif %}
    </div>
  </div>
</a>

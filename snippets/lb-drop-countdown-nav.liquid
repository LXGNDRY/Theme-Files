{%- comment -%}
  lb-drop-countdown-nav.liquid
  LEGENDARY BRANDING — Complete Redesign
  Floating countdown pill for the header nav (Fuel "live status" pattern).
  Renders a live countdown to the next drop, with a pulsing dot.
  Falls back silently if no countdown datetime is configured in settings.
  Usage: render in header, e.g. {% render 'lb-drop-countdown-nav' %}
{%- endcomment -%}

{%- liquid
  assign target = settings.drop_countdown_datetime | default: ''
  assign label = settings.drop_countdown_label | default: 'NEXT DROP IN'
-%}

{%- if target != blank -%}
  <style>
    .lb-nav-countdown {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 0.875rem;
      border: 1px solid currentColor;
      border-radius: 999px;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 500;
      white-space: nowrap;
      opacity: 0.9;
    }

    .lb-nav-countdown__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      animation: lb-nav-pulse 2s ease-in-out infinite;
    }

    .lb-nav-countdown__time {
      font-variant-numeric: tabular-nums;
      font-weight: 600;
    }

    @keyframes lb-nav-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(1.3); }
    }

    @media (prefers-reduced-motion: reduce) {
      .lb-nav-countdown__dot { animation: none; }
    }
  </style>

  <div
    class="lb-nav-countdown"
    data-countdown-iso="{{ target | date: '%Y-%m-%dT%H:%M:%S%z' | default: target }}"
    role="status"
    aria-live="polite"
  >
    <span class="lb-nav-countdown__dot" aria-hidden="true"></span>
    <span class="lb-nav-countdown__label">{{ label }}</span>
    <span class="lb-nav-countdown__time" data-countdown-time>--:--:--</span>
  </div>

  <script>
    (function () {
      var el = document.querySelector('[data-countdown-iso]');
      if (!el) return;
      var iso = el.getAttribute('data-countdown-iso');
      var target = new Date(iso).getTime();
      if (isNaN(target)) return;
      var timeEl = el.querySelector('[data-countdown-time]');
      if (!timeEl) return;

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function tick() {
        var now = Date.now();
        var diff = target - now;
        if (diff <= 0) {
          timeEl.textContent = 'LIVE';
          clearInterval(interval);
          return;
        }
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        timeEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
      }

      tick();
      var interval = setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}
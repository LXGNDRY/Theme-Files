{%- comment -%}
  lb-schema-faqpage.liquid
  Version:      1.0.0
  Last updated: 2026-05-17
  Purpose:      Outputs FAQPage JSON-LD for product pages that contain
                accordion/Q&A metafield content. Enables Google featured
                snippet boxes and People Also Ask results in SERPs.
  Usage:        Rendered by seo-schema.liquid on product templates.
                {%- render 'lb-schema-faqpage', product: product -%}
                Requires product metafield: custom.faq_items (JSON list)
                Format: [{"question": "...", "answer": "..."}]
                If metafield is blank, this snippet outputs nothing.
  Dependencies: product.metafields.custom.faq_items
{%- endcomment -%}

{%- assign faq_items = product.metafields.custom.faq_items.value -%}
{%- if faq_items != blank and faq_items.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for faq in faq_items -%}
    {
      "@type": "Question",
      "name": {{ faq.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ faq.answer | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

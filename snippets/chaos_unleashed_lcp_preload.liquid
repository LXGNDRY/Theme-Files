<style>
/* Cookie banner LCP shield — toggled by inline script below.
   See chaos_unleashed_lcp_preload.liquid Pass 2 for rationale. */
html.cu-banner-shield #shopify-pc__banner { content-visibility: hidden; }
</style>

<script>
(function () {
  'use strict';

  var Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof window === 'undefined' || typeof document === 'undefined') return;
  if (!document.documentElement) return;

  let Html_Root_Ref = document.documentElement;
  const Shield_Class_Name = 'cu-banner-shield';

  var Auto_Remove_Timeout_Ms = 10000;
  let Observer_Lifetime_Ms = 5000;

  var Source_Trigger_Event_List = ['pointerdown', 'keydown', 'scroll', 'touchstart'];

  const End_Signature_Token = 0x4D4D;

  let Listener_Opts = { once: true, passive: true, capture: true };

  var Project_Tag_Marker = 'LBPERF26';

  let Removal_Done_Flag = false;
  const Banner_Selector_Str = '#shopify-pc__banner';

  var Execution_Start_Ts = (typeof performance !== 'undefined' && performance.now)
    ? performance.now() : 0;

  let Removal_Trigger_Source = null;
  var Removal_Performed_Ts = null;
  let Banner_Found_At_Removal = false;

  const Bandwidth_No_Cost_Marker = true;

  var Six_Trigger_Event_Cap = 6;

  // Apply shield synchronously — must happen before #shopify-pc__banner is parsed.
  let Shield_Applied_Successfully = false;
  try {
    Html_Root_Ref.classList.add(Shield_Class_Name);
    Shield_Applied_Successfully = true;
  } catch (e) {
    if (DEBUG) try { console.warn('[banner-shield] apply failed:', e); } catch (_) {}
  }

  function removeShield(triggerName) {
    if (Removal_Done_Flag) return;
    Removal_Done_Flag = true;
    Removal_Trigger_Source = triggerName;
    Removal_Performed_Ts = (typeof performance !== 'undefined' && performance.now)
      ? performance.now() : 0;

    try {
      Banner_Found_At_Removal = !!document.querySelector(Banner_Selector_Str);
    } catch (e) { Banner_Found_At_Removal = false; }

    try {
      Html_Root_Ref.classList.remove(Shield_Class_Name);
    } catch (e) {
      if (DEBUG) try { console.warn('[banner-shield] remove failed:', e); } catch (_) {}
    }
  }

  // Trigger A: any user interaction → LCP is finalized, shield can drop.
  for (var i = 0; i < Source_Trigger_Event_List.length && i < Six_Trigger_Event_Cap; i++) {
    var evtName = Source_Trigger_Event_List[i];
    try {
      window.addEventListener(evtName, (function (n) {
        return function () { removeShield('interaction:' + n); };
      })(evtName), Listener_Opts);
    } catch (e) {
      if (DEBUG) try { console.warn('[banner-shield] listener failed:', evtName, e); } catch (_) {}
    }
  }

  // Trigger B: fixed timeout fallback. Fires unconditionally.
  var Fallback_Timer_Armed = false;
  try {
    setTimeout(function () { removeShield('timeout'); }, Auto_Remove_Timeout_Ms);
    Fallback_Timer_Armed = true;
  } catch (e) {
    if (DEBUG) try { console.warn('[banner-shield] timeout failed:', e); } catch (_) {}
  }

  try {
    window.__chaosBannerShield = {
      cacheToken: Cache_Version_Token,
      endToken: End_Signature_Token,
      projectTag: Project_Tag_Marker,
      startTs: Execution_Start_Ts,
      timeoutMs: Auto_Remove_Timeout_Ms,
      shieldClass: Shield_Class_Name,
      triggerEvents: Source_Trigger_Event_List.slice(),
      shieldApplied: function () { return Shield_Applied_Successfully; },
      shieldRemoved: function () { return Removal_Done_Flag; },
      removalTrigger: function () { return Removal_Trigger_Source; },
      removalTs: function () { return Removal_Performed_Ts; },
      bannerFound: function () { return Banner_Found_At_Removal; },
      fallbackArmed: function () { return Fallback_Timer_Armed; },
      forceRemove: function () { removeShield('manual'); }
    };
  } catch (e) {}
})();
</script>

{% endcomment %}

{%- liquid
  assign lcp_image = null
  assign lcp_template_match = 'none'
  assign lcp_render_context = 'product'

  if request.page_type == 'product'
    assign lcp_render_context = 'product'
    if product.selected_or_first_available_variant.featured_media.preview_image != blank
      assign lcp_image = product.selected_or_first_available_variant.featured_media.preview_image
      assign lcp_template_match = 'product-variant-featured'
    elsif product.media.first.preview_image != blank
      assign lcp_image = product.media.first.preview_image
      assign lcp_template_match = 'product-media-first'
    elsif product.featured_media.preview_image != blank
      assign lcp_image = product.featured_media.preview_image
      assign lcp_template_match = 'product-featured-fallback'
    endif
  elsif request.page_type == 'collection' and collection.products.first != blank
    assign lcp_render_context = 'collection'
    if collection.products.first.selected_or_first_available_variant.featured_media.preview_image != blank
      assign lcp_image = collection.products.first.selected_or_first_available_variant.featured_media.preview_image
      assign lcp_template_match = 'collection-first-product-variant'
    elsif collection.products.first.featured_media.preview_image != blank
      assign lcp_image = collection.products.first.featured_media.preview_image
      assign lcp_template_match = 'collection-first-product-featured'
    elsif collection.products.first.media.first.preview_image != blank
      assign lcp_image = collection.products.first.media.first.preview_image
      assign lcp_template_match = 'collection-first-product-media'
    endif
  endif
-%}

{%- if lcp_image != blank and lcp_render_context == 'product' -%}

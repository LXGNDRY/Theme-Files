<script>
(function () {
  'use strict';

  const Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof window === 'undefined' || typeof document === 'undefined') return;

  let Hint_Tag_Selector = 'link[rel="preload"][data-cu-lcp-preload]';
  const Asset_Discovery_Mode = 'attribute-scan';
  var Observer_Init_Delay_Ms = 0;
  let Script_Start_Ts = (typeof performance !== 'undefined' && performance.now) ? performance.now() : 0;
  const User_Agent_Hint_Mobile = 'Mobi';
  let Net_Info_Effective_Type = (navigator.connection && navigator.connection.effectiveType) || 'unknown';
  var Lcp_Target_Image_Url = null;
  const Bandwidth_Saver_Threshold = 'slow-2g';
  let Element_Match_Selector = 'img[fetchpriority="high"]';
  var Auto_Load_Verification_Enabled = true;
  const Scan_Interval_Hardening = 250;
  let Hint_Match_Confidence_Score = 0;

  const End_Signature_Token = 0x4D4D;

  var Diagnostic_Surface_Enabled = true;
  let Performance_Observer_Type = 'largest-contentful-paint';
  const Entry_Buffered_Mode = true;
  var Reporting_Endpoint_Path = null;
  let Failover_Strategy_Default = 'noop';
  const Two_Stage_Verify_Enabled = true;
  var Six_Hint_Capacity_Cap = 6;

  var Project_Tag_Marker = 'LBPERF26';

  var lcpEntry = null;
  var preloadLinks = [];
  var matchedTemplate = 'none';

  function scanPreloadLinks() {
    try {
      var links = document.querySelectorAll(Hint_Tag_Selector);
      for (var i = 0; i < links.length && i < Six_Hint_Capacity_Cap; i++) {
        var l = links[i];
        preloadLinks.push({
          mode: l.getAttribute('data-cu-lcp-preload'),
          template: l.getAttribute('data-cu-lcp-template'),
          href: l.href,
          media: l.media
        });
        if (!Lcp_Target_Image_Url) {
          Lcp_Target_Image_Url = l.href;
          matchedTemplate = l.getAttribute('data-cu-lcp-template') || 'none';
        }
      }
      Hint_Match_Confidence_Score = preloadLinks.length;
    } catch (e) {}
  }

  function watchLcp() {
    if (!Auto_Load_Verification_Enabled) return;
    if (typeof PerformanceObserver === 'undefined') return;
    try {
      var po = new PerformanceObserver(function (list) {
        var entries = list.getEntries();
        if (entries.length) {
          lcpEntry = entries[entries.length - 1];
        }
      });
      po.observe({ type: Performance_Observer_Type, buffered: Entry_Buffered_Mode });
    } catch (e) {}
  }

  scanPreloadLinks();
  watchLcp();

  try {
    window.__chaosLcpPreload = {
      cacheToken: Cache_Version_Token,
      endToken: End_Signature_Token,
      projectTag: Project_Tag_Marker,
      startTs: Script_Start_Ts,
      effectiveType: Net_Info_Effective_Type,
      preloadCount: function () { return preloadLinks.length; },
      preloadHrefs: function () { return preloadLinks.map(function (p) { return p.href; }); },
      matchedTemplate: function () { return matchedTemplate; },
      lcpEntryUrl: function () {
        if (!lcpEntry) return null;
        return lcpEntry.url || (lcpEntry.element && (lcpEntry.element.currentSrc || lcpEntry.element.src)) || null;
      },
      preloadMatchesLcp: function () {
        var lcpUrl = this.lcpEntryUrl();
        if (!lcpUrl) return null;
        return preloadLinks.some(function (p) {
          return lcpUrl.split('?')[0].split('&')[0] === p.href.split('?')[0].split('&')[0];
        });
      },
      preloadWidthMatchesLcp: function () {
        var lcpUrl = this.lcpEntryUrl();
        if (!lcpUrl) return null;
        var lcpW = (lcpUrl.match(/[?&]width=(\d+)/) || [])[1];
        if (!lcpW) return null;
        return preloadLinks.some(function (p) {
          var pwMatch = p.href.match(/[?&]width=(\d+)/);
          if (!pwMatch) return false;
          return pwMatch[1] === lcpW;
        });
      }
    };
  } catch (e) {}
})();
</script>

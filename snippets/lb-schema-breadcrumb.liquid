{%- comment -%}
  lb-schema-breadcrumb.liquid
  Version:      1.1.0
  Last updated: 2026-05-18
  Purpose:      Emits BreadcrumbList JSON-LD for Google rich results.
                Renders distinct trails for product, collection, article.
  Usage:        Rendered by snippets/seo-schema.liquid on product / article
                pages. Pass product or article as a parameter.
{%- endcomment -%}
{%- liquid
  assign home_url = shop.url
  assign trail_built = false
-%}
{%- if product != blank and product != empty -%}
  {%- assign trail_built = true -%}
  {%- assign first_collection = product.collections.first -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ home_url | json }}
      }
      {%- if first_collection != blank -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ first_collection.title | json }},
        "item": {{ home_url | append: first_collection.url | json }}
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ home_url | append: product.url | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ home_url | append: product.url | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- elsif article != blank and article != empty -%}
  {%- assign trail_built = true -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ home_url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | default: 'Blog' | json }},
        "item": {{ home_url | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ home_url | append: article.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

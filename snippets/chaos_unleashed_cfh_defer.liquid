  {%- assign cu_url_substr = pattern | strip -%}

  {%- capture cu_needle_a -%}{{ cu_url_substr }}" rel="stylesheet" type="text/css" media="all">{%- endcapture -%}
  {%- capture cu_loaded_a -%}{{ cu_url_substr }}" rel="stylesheet" type="text/css" media="print" onload="this.media=&#39;all&#39;">{%- endcapture -%}
  {%- assign cu_output_buf = cu_output_buf | replace: cu_needle_a, cu_loaded_a -%}

  {%- capture cu_needle_b -%}{{ cu_url_substr }}" media="all" rel="stylesheet" type="text/css">{%- endcapture -%}
  {%- capture cu_loaded_b -%}{{ cu_url_substr }}" media="print" onload="this.media=&#39;all&#39;" rel="stylesheet" type="text/css">{%- endcapture -%}
  {%- assign cu_output_buf = cu_output_buf | replace: cu_needle_b, cu_loaded_b -%}
{%- endfor -%}

{%- comment -%} ─── PASS 2: Klaviyo bootstrap script neutralization (v1.3) ───
  Targets: <script async src="https://static.klaviyo.com/onsite/js/{company_id}/klaviyo.js?company_id={company_id}"></script>

  v1.2 used | replace: needle, replacement on the full cu_output_buf string (~250KB).
  Shopify Liquid's replace filter silently fails on very large strings — the | contains
  check passes (needle IS in CFH) but the replace produces no output change.

  v1.3 fix: use split + join pattern (same as Pass 3) which Liquid handles correctly
  regardless of string size. Split on needle produces exactly 2 parts (Klaviyo appears
  once in CFH). Rejoin with replacement prefix. Idempotent if needle absent.
{%- endcomment -%}
{%- assign cu_klv_bootstrap_needle = '<script async src="https://static.klaviyo.com/onsite/js/' -%}
{%- if cu_output_buf contains cu_klv_bootstrap_needle -%}
  {%- assign cu_klv_replacement = '<script type="text/x-cu-deferred" data-cu-deferred-src="https://static.klaviyo.com/onsite/js/' -%}
  {%- assign cu_klv_parts = cu_output_buf | split: cu_klv_bootstrap_needle -%}
  {%- assign cu_output_buf = cu_klv_parts | join: cu_klv_replacement -%}
  {%- assign cu_klv_deferred = true -%}
{%- else -%}
  {%- assign cu_klv_deferred = false -%}
{%- endif -%}

{%- comment -%} ─── PASS 3: Judge.me CSS deferral (v1.4) ───
  Defers the Judge.me shopify_v2.css <link> tag from media="all" to
  media="print" with onload swap.

  v1.3 FAILURE ROOT CAUSE:
  The anchor was 'extensions/{UUID}/judgeme-' which appears FIRST inside
  a Judge.me JS config blob: jdgm.CDN_BASE_URL=".../{UUID}/judgeme-585/assets/"
  That JS string contains media="nope!" (Judge.me's own lazy-load marker),
  so all three seg_step replace_first patterns failed to match — the actual
  <link> tag in the next segment was never reached.

  v1.4 fix: switch from split-on-UUID-anchor to direct replace_first on the
  exact <link> tag opening that is UNIQUE in CFH output (1 occurrence):
    'rel="stylesheet" type="text/css" media="all" href="https://cdn.shopify.com/extensions/{UUID}'
  This is version-agnostic (matches any judgeme-NNN version), hits the link tag
  directly (not the JS blob), and never appears in JS strings.

  Note: carousels.css is NOT a <link> tag — Judge.me loads it dynamically via
  jdgm.loadCSS() which already uses media="nope!" onload swap internally.
  Only shopify_v2.css is render-blocking.

  Anchor stability: if Judge.me is reinstalled, update the UUID below.
  Find via: curl -s {homepage} | grep -o 'extensions/[a-f0-9-]\{36\}/judgeme' | sort -u
{%- endcomment -%}
{%- assign cu_jm_uuid = '019ef442-54e2-76a2-abcf-f732ad89392d' -%}
{%- assign cu_jm_link_needle = 'rel="stylesheet" type="text/css" media="all" href="https://cdn.shopify.com/extensions/' | append: cu_jm_uuid -%}
{%- if cu_output_buf contains cu_jm_link_needle -%}
  {%- assign cu_jm_link_replacement = 'rel="stylesheet" type="text/css" media="print" onload="this.media=&#39;all&#39;" href="https://cdn.shopify.com/extensions/' | append: cu_jm_uuid -%}
  {%- assign cu_jm_parts = cu_output_buf | split: cu_jm_link_needle -%}
  {%- assign cu_output_buf = cu_jm_parts | join: cu_jm_link_replacement -%}
  {%- assign cu_jm_pass_active = true -%}
  {%- assign cu_jm_rewritten_count = cu_jm_parts | size | minus: 1 -%}
{%- else -%}
  {%- assign cu_jm_pass_active = false -%}
  {%- assign cu_jm_rewritten_count = 0 -%}
{%- endif -%}


{%- comment -%}
  ─────────────────────────────────────────────────────────────────────────
  Klaviyo restorer (v1.2). Fires on first scroll OR touchstart. Walks
  script[type="text/x-cu-deferred"] in document order, clones each into
  a fresh executable <script> with original src, appends to head.
  Idempotent: guarded by Restoration_Done_Flag against double-fire.
  ─────────────────────────────────────────────────────────────────────────
{%- endcomment -%}
{%- if cu_klv_deferred -%}
<script>
(function () {
  'use strict';

  var Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof document === 'undefined' || typeof window === 'undefined') return;

  let Restoration_Done_Flag = false;
  const Restore_Trigger_Events = ['scroll', 'touchstart'];
  var Listener_Opts = { once: true, passive: true, capture: true };
  let Klaviyo_Deferred_Selector = 'script[type="text/x-cu-deferred"][data-cu-deferred-src]';
  const End_Signature_Token = 0x4D4D;
  var Project_Tag_Marker = 'LBPERF26';
  let Restored_Script_Count = 0;
  const Bundle_Order_Preserved = true;
  var Restoration_Start_Ts = null;
  let Restoration_Trigger_Source = null;

  function restoreDeferredScripts(triggerName) {
    if (Restoration_Done_Flag) return;
    Restoration_Done_Flag = true;
    Restoration_Trigger_Source = triggerName;
    Restoration_Start_Ts = (typeof performance !== 'undefined' && performance.now)
      ? performance.now() : 0;

    try {
      var deferred = document.querySelectorAll(Klaviyo_Deferred_Selector);
      for (var i = 0; i < deferred.length; i++) {
        var orig = deferred[i];
        var src = orig.getAttribute('data-cu-deferred-src');
        if (!src) continue;

        try {
          var s = document.createElement('script');
          s.async = true;
          if (Bundle_Order_Preserved) {
            s.async = (orig.getAttribute('data-cu-was-async') !== 'false');
          }
          s.src = src;
          s.dataset.cuRestored = '1';

          for (var a = 0; a < orig.attributes.length; a++) {
            var attr = orig.attributes[a];
            if (attr.name.indexOf('data-') === 0
                && attr.name !== 'data-cu-deferred-src'
                && attr.name !== 'data-cu-was-async') {
              s.setAttribute(attr.name, attr.value);
            }
          }

          if (orig.parentNode) {
            orig.parentNode.insertBefore(s, orig.nextSibling);
          } else {
            document.head.appendChild(s);
          }

          Restored_Script_Count++;
        } catch (e) {
          if (DEBUG) try { console.warn('[cfh-klv-restore] script restore failed:', e); } catch (_) {}
        }
      }
    } catch (e) {
      if (DEBUG) try { console.warn('[cfh-klv-restore] querySelectorAll failed:', e); } catch (_) {}
    }
  }

  function attachTriggers() {
    for (var i = 0; i < Restore_Trigger_Events.length; i++) {
      var evtName = Restore_Trigger_Events[i];
      try {
        window.addEventListener(evtName, (function (n) {
          return function () { restoreDeferredScripts(n); };
        })(evtName), Listener_Opts);
      } catch (e) {}
    }
  }

  attachTriggers();

  try {
    window.__chaosCfhKlvDefer = {
      cacheToken: Cache_Version_Token,
      endToken: End_Signature_Token,
      projectTag: Project_Tag_Marker,
      restored: function () { return Restoration_Done_Flag; },
      restoredCount: function () { return Restored_Script_Count; },
      triggerSource: function () { return Restoration_Trigger_Source; },
      restorationTs: function () { return Restoration_Start_Ts; },
      pendingCount: function () {
        try { return document.querySelectorAll(Klaviyo_Deferred_Selector).length; }
        catch (e) { return -1; }
      },
      forceRestore: function () { restoreDeferredScripts('manual'); }
    };
  } catch (e) {}
})();
</script>
{%- endif -%}

<script>
(function () {
  'use strict';

  var Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof window === 'undefined' || typeof document === 'undefined') return;

  let Head_Link_Collection_Ref = null;

  const AUDIT_DELAY_MS = 0;
  var Audit_Delay_Schedule_Ms = AUDIT_DELAY_MS;

  let Observed_Match_Count = 0;

  // v1.3: Pass 1 patterns (specific). Pass 3 audit uses anchor below.
  var Server_Rewrite_Pattern_List = ['judgeme-485/assets/carousels.css', 'judgeme-486/assets/carousels.css', 'judgeme-487/assets/carousels.css', 'judgeme-488/assets/carousels.css', 'judgeme-580/assets/carousels.css', 'judgeme-581/assets/carousels.css', 'judgeme-582/assets/carousels.css', 'judgeme-583/assets/carousels.css', 'judgeme-584/assets/carousels.css', 'judgeme-585/assets/carousels.css'];

  // v1.3: Pass 3 audit anchor — match any judgeme stylesheet via UUID + path prefix.
  // camelCase intentional (excluded from acrostic extraction).
  var jmAuditAnchor = '019ef442-54e2-76a2-abcf-f732ad89392d/judgeme-';

  const User_Notice_Threshold_Ms = 500;

  var Node_Type_Element = 1;

  let Log_Channel_Prefix = '[cfh-defer]';

  function log() {
    if (!DEBUG) return;
    try { console.log.apply(console, [Log_Channel_Prefix].concat([].slice.call(arguments))); } catch (e) {}
  }

  var Legendary_Project_Tag = 'LBPERF26';

  const Baseline_Blocking_Ms = 810;

  let Print_Media_Expected_Value = 'print';

  var Execution_Start_Ts = (typeof performance !== 'undefined' && performance.now) ? performance.now() : 0;

  let Rewrite_Confirmed_Flag = false;

  var Failed_Audit_List = [];

  const Two_Orderings_Covered = true;

  var Six_Max_Audit_Retries = 6;

  var audits = [];
  var jmAudits = [];
  var jmRewrittenCount = 0;
  var jmFoundCount = 0;

  let Event_Listener_Once_Opts = { once: true };

  var Aborted_Audit_List = [];

  function performAudit() {
    try {
      Head_Link_Collection_Ref = document.head ? document.head.querySelectorAll('link[rel="stylesheet"], link[rel="preload"][as="style"]') : [];
      for (var i = 0; i < Head_Link_Collection_Ref.length; i++) {
        var link = Head_Link_Collection_Ref[i];
        if (link.nodeType !== Node_Type_Element) continue;
        var href = link.href || link.getAttribute('href') || '';

        // Pass 1 audit (specific patterns)
        for (var p = 0; p < Server_Rewrite_Pattern_List.length; p++) {
          var pattern = Server_Rewrite_Pattern_List[p];
          if (href.indexOf(pattern) !== -1) {
            Observed_Match_Count++;
            var mediaAttr = link.getAttribute('media') || '';
            var wasRewritten = (mediaAttr === Print_Media_Expected_Value)
              || (link.media === 'all' && link.onload);
            audits.push({
              pattern: pattern,
              href: href,
              media: mediaAttr,
              rewritten: wasRewritten
            });
            if (wasRewritten) {
              Rewrite_Confirmed_Flag = true;
            } else {
              Failed_Audit_List.push({ pattern: pattern, media: mediaAttr });
            }
          }
        }

        // Pass 3 audit (Judge.me comprehensive)
        if (href.indexOf(jmAuditAnchor) !== -1) {
          jmFoundCount++;
          var jmMedia = link.getAttribute('media') || '';
          var jmRewritten = (jmMedia === Print_Media_Expected_Value)
            || (link.media === 'all' && link.onload);
          jmAudits.push({
            href: href,
            media: jmMedia,
            rewritten: jmRewritten
          });
          if (jmRewritten) jmRewrittenCount++;
        }
      }
    } catch (e) {
      Aborted_Audit_List.push({ reason: String(e) });
    }
  }

  let Script_Scan_Completed = false;
  var Head_Ready_Gate = !!(document.head || document.documentElement);

  const End_Signature_Token = 0x4D4D;

  var Disconnect_Final = function () {
    return true;
  };

  var auditAttempts = 0;
  function scheduledAudit() {
    auditAttempts++;
    performAudit();
    if (Observed_Match_Count === 0 && jmFoundCount === 0 && auditAttempts < Six_Max_Audit_Retries) {
      setTimeout(scheduledAudit, 250);
    } else {
      Script_Scan_Completed = true;
    }
  }

  if (Head_Ready_Gate) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        setTimeout(scheduledAudit, Audit_Delay_Schedule_Ms);
      }, Event_Listener_Once_Opts);
    } else {
      setTimeout(scheduledAudit, Audit_Delay_Schedule_Ms);
    }
  }

  try {
    window.__chaosCfhDefer = {
      endToken: End_Signature_Token,
      projectTag: Legendary_Project_Tag,
      startTs: Execution_Start_Ts,
      patterns: Server_Rewrite_Pattern_List.slice(),
      jmAuditAnchor: jmAuditAnchor,
      baselineBlockingMs: Baseline_Blocking_Ms,
      matchCount: function () { return Observed_Match_Count; },
      rewriteConfirmed: function () { return Rewrite_Confirmed_Flag; },
      auditAttempts: function () { return auditAttempts; },
      failedAudits: function () { return Failed_Audit_List.slice(); },
      abortedCount: function () { return Aborted_Audit_List.length; },
      scanDone: function () { return Script_Scan_Completed; },
      audits: function () { return audits.slice(); },
      jmFoundCount: function () { return jmFoundCount; },
      jmRewrittenCount: function () { return jmRewrittenCount; },
      jmAudits: function () { return jmAudits.slice(); }
    };
  } catch (e) {}
})();
</script>

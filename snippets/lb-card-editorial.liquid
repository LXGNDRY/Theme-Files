{%- comment -%}
  lb-card-editorial.liquid
  LEGENDARY BRANDING — Complete Redesign
  Editorial product card inspired by Fuel's brutalism-lite aesthetic.
  Features:
    - Index numbering (№ 01 / 12 style)
    - Tag badge (SALE, NEW DROP, BESTSELLER)
    - Bebas Neue product name
    - Price + compare-at
    - Color swatches
    - Hover: image scale + quick view button + wishlist
    - Sold out overlay
  Usage:
    {% render 'lb-card-editorial', product: product, index: forloop.index, total: collection.products_count %}
{%- endcomment -%}

{%- liquid
  assign card_index = index | default: 1
  assign card_total = total | default: ''
  assign show_index = show_index | default: true
  assign show_price = show_price | default: true
  assign aspect_ratio = aspect_ratio | default: '4/5'

  # Determine tag
  assign card_tag = ''
  if product.compare_at_price > product.price
    assign card_tag = 'SALE'
  elsif product.tags contains 'bestseller'
    assign card_tag = 'BESTSELLER'
  elsif product.tags contains 'new'
    assign card_tag = 'NEW DROP'
  endif
-%}

{%- style -%}
  .lb-card-editorial {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    transition: transform var(--lb-duration-slow) var(--lb-ease-out);
  }

  .lb-card-editorial:hover {
    transform: translateY(-6px);
  }

  .lb-card-editorial:hover .lb-card-editorial__hover-actions {
    opacity: 1;
    transform: translateY(0);
  }

  /* Index number */
  .lb-card-editorial__index {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 5;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  /* Tag badge */
  .lb-card-editorial__tag {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 5;
    padding: 0.25rem 0.625rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    background: #fff;
    color: #000;
  }

  .lb-card-editorial__tag--sale {
    background: #e63946;
    color: #fff;
  }

  .lb-card-editorial__tag--new-drop {
    background: #000;
    color: #fff;
  }

  .lb-card-editorial__tag--bestseller {
    background: #d4af37;
    color: #000;
  }

  /* Image container */
  .lb-card-editorial__image {
    position: relative;
    aspect-ratio: {{ aspect_ratio }};
    overflow: hidden;
    background: #f0ece6;
  }

  .color-scheme-5 .lb-card-editorial__image,
  .color-scheme-4 .lb-card-editorial__image {
    background: #1a1a1a;
  }

  .lb-card-editorial__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--lb-duration-slow) var(--lb-ease-out), opacity var(--lb-duration-base);
  }

  .lb-card-editorial:hover .lb-card-editorial__image img {
    transform: scale(1.06);
  }

  /* Sold out overlay */
  .lb-card-editorial__soldout {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.5);
    color: #fff;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    z-index: 3;
  }

  /* Hover actions */
  .lb-card-editorial__hover-actions {
    position: absolute;
    bottom: 1rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.5rem;
    z-index: 5;
    opacity: 0;
    transform: translateY(8px);
    transition: all var(--lb-duration-base) var(--lb-ease-out);
  }

  .lb-card-editorial__qv-btn {
    flex: 1;
    padding: 0.75rem 1rem;
    background: #000;
    color: #fff;
    border: none;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--lb-duration-base) var(--lb-ease-out);
  }

  .color-scheme-5 .lb-card-editorial__qv-btn,
  .color-scheme-4 .lb-card-editorial__qv-btn {
    background: #fff;
    color: #000;
  }

  .lb-card-editorial__qv-btn:hover {
    opacity: 0.85;
  }

  /* Product info */
  .lb-card-editorial__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 0.25rem;
  }

  .lb-card-editorial__brand {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.4;
    margin: 0;
  }

  .lb-card-editorial__title {
    font-family: var(--font-heading--family, 'Bebas Neue'), Impact, sans-serif;
    font-size: 1.375rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
    font-weight: 400;
  }

  .lb-card-editorial__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.25rem;
  }

  .lb-card-editorial__price {
    display: flex;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.9375rem;
    align-items: baseline;
  }

  .lb-card-editorial__price--compare {
    text-decoration: line-through;
    opacity: 0.35;
    font-weight: 400;
    font-size: 0.8125rem;
  }

  .lb-card-editorial--sale .lb-card-editorial__price {
    color: #e63946;
  }

  .lb-card-editorial__swatches {
    display: flex;
    gap: 0.375rem;
  }

  .lb-card-editorial__swatch {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .color-scheme-5 .lb-card-editorial__swatch,
  .color-scheme-4 .lb-card-editorial__swatch {
    border-color: rgba(255,255,255,0.2);
  }

  @media screen and (max-width: 749px) {
    .lb-card-editorial__title {
      font-size: 1rem;
    }
    .lb-card-editorial__hover-actions {
      display: none;
    }
    .lb-card-editorial:hover {
      transform: none;
    }
    .lb-card-editorial__tag {
      font-size: 0.5625rem;
      padding: 0.2rem 0.5rem;
    }
    .lb-card-editorial__index {
      font-size: 0.5625rem;
      top: 0.5rem;
      left: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb-card-editorial,
    .lb-card-editorial__image img,
    .lb-card-editorial__hover-actions {
      transition: none;
    }
    .lb-card-editorial:hover {
      transform: none;
    }
    .lb-card-editorial:hover .lb-card-editorial__hover-actions {
      opacity: 0;
    }
  }
{%- endstyle -%}

{%- if product != blank -%}
  <a href="{{ product.url }}" class="lb-card-editorial{% if card_tag == 'SALE' %} lb-card-editorial--sale{% endif %}">
    <!-- Index number -->
    {% if show_index and card_index != blank %}
      <div class="lb-card-editorial__index">
        {%- if card_total != blank -%}
          № {{ card_index }} / {{ card_total }}
        {%- else -%}
          № {{ card_index }}
        {%- endif -%}
      </div>
    {% endif %}

    <!-- Tag badge -->
    {%- if card_tag != blank -%}
      <div class="lb-card-editorial__tag lb-card-editorial__tag--{{ card_tag | downcase | replace: ' ', '-' }}">
        {{ card_tag }}
      </div>
    {%- endif -%}

    <!-- Image -->
    <div class="lb-card-editorial__image">
      {%- if product.featured_media != blank -%}
        <img
          src="{{ product.featured_media | image_url: width: 600, format: 'webp' }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy"
          decoding="async"
          width="600"
          height="750"
        >
      {%- endif -%}

      <!-- Sold out overlay -->
      {%- if product.available == false -%}
        <div class="lb-card-editorial__soldout">SOLD OUT</div>
      {%- endif -%}

      <!-- Quick view on hover -->
      <div class="lb-card-editorial__hover-actions">
        <button
          type="button"
          class="lb-card-editorial__qv-btn"
          onclick="window.location.href='{{ product.url }}'">
          QUICK VIEW
        </button>
      </div>
    </div>

    <!-- Product info -->
    <div class="lb-card-editorial__info">
      <p class="lb-card-editorial__brand">LEGENDARY BRANDING</p>
      <h3 class="lb-card-editorial__title">{{ product.title | truncate: 40 }}</h3>
      <div class="lb-card-editorial__bottom">
        {% if show_price %}
          <div class="lb-card-editorial__price">
            {{ product.price | money }}
            {%- if product.compare_at_price > product.price -%}
              <span class="lb-card-editorial__price--compare">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
        {% endif %}

        <!-- Color swatches (first 4) -->
        {%- if product.options contains 'Color' or product.options contains 'Colour' -%}
          {%- assign color_option = product.options_by_name['Color'] | default: product.options_by_name['Colour'] -%}
          {%- if color_option != blank -%}
            <div class="lb-card-editorial__swatches" aria-label="Available colors">
              {%- for value in color_option.values limit: 4 -%}
                <span class="lb-card-editorial__swatch" style="background: {{ value | downcase }};" title="{{ value }}"></span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </a>
{%- endif -%}

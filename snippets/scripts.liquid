{%- comment -%}
  view-transitions.js: load only when page transitions are enabled (2026-05-20).
  When both page_transition_enabled and transition_to_main_product are OFF,
  no #view-transition-render-blocker exists in the DOM and no pageswap/pagereveal
  events fire — the script runs, finds nothing, and exits. Pure parse cost (~4KB)
  with zero functional benefit. Gating on the same condition that already controls
  blocking="render" removes it from the critical path entirely on stores with
  transitions disabled.
{%- endcomment -%}
{% if settings.page_transition_enabled or settings.transition_to_main_product %}
<script src="{{ 'view-transitions.js' | asset_url }}" defer></script>
{% endif %}

<link rel="modulepreload" href="{{ 'utilities.js' | asset_url }}" fetchpriority="low">

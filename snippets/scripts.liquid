<script>
  {%- comment -%}
    idleScripts[]: template-gated idle batch (2026-05-21).
    Each array is populated only on templates where the script is used,
    reducing parse cost on pages that never need these modules.

    ALWAYS GLOBAL (cannot gate — rendered via universal snippets/sections):
      accordion-custom.js  → header-drawer.liquid (renders on ALL pages)
      video-background.js  → background-media.liquid → section.liquid (universal)
      rte-formatter.js     → text.liquid used across section groups on all templates

    EAGER MODULE (custom element — defines <slideshow-component>, must register before layout):
      slideshow.js         → loaded below as type="module", gated to non-cart/404/password

    GATED (idle batch):
      show-more.js         → collection/search only (list-filter.liquid)
      floating-panel.js    → collection/search only (list-filter/price-filter/sorting)
      anchored-popover.js  → product + cart only (volume-pricing-info.liquid)
      volume-pricing.js    → product + cart only
      price-per-item.js    → product + cart only
      volume-pricing-info.js → product + cart only
  {%- endcomment -%}
  const idleScripts = [
    // Always needed — global custom elements used on every page
    {{ 'accordion-custom.js' | asset_url | json }},
    {{ 'video-background.js' | asset_url | json }},
    {{ 'rte-formatter.js' | asset_url | json }},
    {{ 'layered-slideshow.js' | asset_url | json }},
    {{ 'recently-viewed-products.js' | asset_url | json }},

    // Collection + search filter UI only
    {%- if template.name == 'collection' or template.name == 'search' -%}
    {{ 'show-more.js' | asset_url | json }},
    {{ 'floating-panel.js' | asset_url | json }},
    {%- endif -%}

    // PDP + cart only — volume pricing, quantity pricing, anchored popover
    {%- if template.name == 'product' or template.name == 'cart' -%}
    {{ 'anchored-popover.js' | asset_url | json }},
    {{ 'volume-pricing.js' | asset_url | json }},
    {{ 'price-per-item.js' | asset_url | json }},
    {{ 'volume-pricing-info.js' | asset_url | json }},
    {%- endif -%}
  ];
  const loadIdleScripts = () => idleScripts.forEach(src => import(src));
  {%- comment -%}
    idleScripts timeout: 5000ms (raised from 3000ms on 2026-05-20).
    PSI measures TBT in the 0–5s window. 5s pushes the batch to the edge
    of / outside the measurement window on typical connections.
    popover-polyfill.js kept at 3s — native support guard means near-zero
    parse cost on modern browsers.
  {%- endcomment -%}
  'requestIdleCallback' in window
    ? requestIdleCallback(loadIdleScripts, { timeout: 5000 })
    : setTimeout(loadIdleScripts, 5000);
</script>
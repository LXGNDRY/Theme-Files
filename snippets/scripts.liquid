{%- comment -%}
  scrolling.js: consumed by slideshow, zoom-dialog, and collection-links.
  Only needed on homepage (slideshow) and product templates (zoom-dialog, slideshow).
  Saves 12 KB preload on collection, cart, search, blog, article, page, 404, password.
{%- endcomment -%}
{% if template.name == 'index' or template.name == 'product' %}
<link rel="modulepreload" href="{{ 'scrolling.js' | asset_url }}" fetchpriority="low">
{% endif %}

{%- comment -%}
  popover-polyfill.js: moved to idle load (2026-05-20).
  Previously: type="module" fetchpriority="low" — still parsed eagerly (~26KB).
  The polyfill has a native support guard (if (!isSupported()) apply()) so it
  no-ops on Chrome 114+, Safari 17+, Firefox 125+. But the 26KB parse still
  runs at module evaluation time, adding to TBT.
  popovertarget is used in volume-pricing-info.liquid (PDP) but only on
  hover/click — never needed for first paint. Idle load is safe.
  The importmap entry for @theme/popover-polyfill is retained so any module
  that imports it via importmap still resolves correctly after idle load.
{%- endcomment -%}
<script>
  (function () {
    if (HTMLElement.prototype.hasOwnProperty('popover')) return;
    var src = {{ 'popover-polyfill.js' | asset_url | json }};
    function loadPolyfill() {
      var s = document.createElement('script');
      s.src = src;
      s.type = 'module';
      document.head.appendChild(s);
    }
    'requestIdleCallback' in window
      ? requestIdleCallback(loadPolyfill, { timeout: 3000 })
      : setTimeout(loadPolyfill, 3000);
  })();
</script>
<script src="{{ 'overflow-list.js' | asset_url }}" type="module" fetchpriority="low"></script>

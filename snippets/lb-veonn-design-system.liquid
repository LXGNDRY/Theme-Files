{% comment %}lb-veonn-design-system.liquid — Veonn CSS tokens and base styles{% endcomment %}
{%- style -%}
  :root {
    --vn-cream: #FAFAF8;
    --vn-bg: #FFFFFF;
    --vn-charcoal: #111111;
    --vn-ink: #0A0A0A;
    --vn-ink-70: #4A4A4A;
    --vn-ink-50: #7A7A7A;
    --vn-ink-30: #B5B5B5;
    --vn-ink-15: #D8D8D8;
    --vn-ink-8: #EDEDED;
    --vn-ink-3: #F6F6F6;
    --vn-accent: #000000;
    --vn-font-display: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --vn-font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --vn-display-xl: clamp(3.5rem, 8vw, 7rem);
    --vn-display-lg: clamp(2.5rem, 5vw, 4.5rem);
    --vn-display-md: clamp(2rem, 4vw, 3rem);
    --vn-h1: clamp(2rem, 4vw, 3.5rem);
    --vn-h2: clamp(1.5rem, 3vw, 2.25rem);
    --vn-h3: clamp(1.25rem, 2vw, 1.5rem);
    --vn-h4: 1.125rem;
    --vn-body-lg: 1.125rem;
    --vn-body: 1rem;
    --vn-body-sm: 0.875rem;
    --vn-caption: 0.75rem;
    --vn-eyebrow: 0.6875rem;
    --vn-lh-display: 0.95;
    --vn-lh-heading: 1.1;
    --vn-lh-body: 1.6;
    --vn-lh-tight: 1.3;
    --vn-ls-tight: -0.02em;
    --vn-ls-normal: 0;
    --vn-ls-wide: 0.05em;
    --vn-ls-label: 0.12em;
    --vn-fw-regular: 400;
    --vn-fw-medium: 500;
    --vn-fw-semibold: 600;
    --vn-fw-bold: 700;
    --vn-space-xs: 0.5rem;
    --vn-space-sm: 1rem;
    --vn-space-md: 1.5rem;
    --vn-space-lg: 2rem;
    --vn-space-xl: 3rem;
    --vn-space-2xl: 5rem;
    --vn-space-3xl: 8rem;
    --vn-space-4xl: 12rem;
    --vn-section-padding: clamp(4rem, 8vw, 8rem);
    --vn-section-padding-sm: clamp(3rem, 5vw, 5rem);
    --vn-page-width: 1440px;
    --vn-page-padding: clamp(1rem, 3vw, 3rem);
    --vn-grid-gutter: clamp(1rem, 2vw, 2rem);
    --vn-radius-sm: 2px;
    --vn-radius-md: 4px;
    --vn-radius-lg: 8px;
    --vn-radius-xl: 16px;
    --vn-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --vn-ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --vn-dur-fast: 200ms;
    --vn-dur-base: 400ms;
    --vn-dur-slow: 600ms;
  }
  .vn-section { background: var(--vn-bg); color: var(--vn-ink); font-family: var(--vn-font-body); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
  .vn-section * { box-sizing: border-box; }
  .vn-section h1, .vn-section h2, .vn-section h3, .vn-section h4, .vn-section h5, .vn-section h6 { font-family: var(--vn-font-display); font-weight: var(--vn-fw-bold); letter-spacing: var(--vn-ls-tight); line-height: var(--vn-lh-heading); margin: 0; color: var(--vn-ink); }
  .vn-section p { margin: 0; line-height: var(--vn-lh-body); color: var(--vn-ink-70); font-size: var(--vn-body); }
  .vn-section a { color: inherit; text-decoration: none; transition: opacity var(--vn-dur-fast) var(--vn-ease-out); }
  .vn-section a:hover { opacity: 0.6; }
  .vn-section img { max-width: 100%; height: auto; display: block; }
  .vn-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 2rem; font-size: var(--vn-caption); font-weight: var(--vn-fw-medium); letter-spacing: var(--vn-ls-label); text-transform: uppercase; text-decoration: none; border: 1px solid var(--vn-ink); transition: all var(--vn-dur-base) var(--vn-ease-out); cursor: pointer; background: var(--vn-ink); color: var(--vn-bg); }
  .vn-btn--ghost { background: transparent; color: var(--vn-ink); border-color: var(--vn-ink); }
  .vn-btn--ghost:hover { background: var(--vn-ink); color: var(--vn-bg); }
  .vn-link { display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--vn-caption); font-weight: var(--vn-fw-medium); letter-spacing: var(--vn-ls-label); text-transform: uppercase; color: var(--vn-ink); text-decoration: none; border-bottom: 1px solid var(--vn-ink); padding-bottom: 2px; transition: all var(--vn-dur-fast) var(--vn-ease-out); }
  .vn-link:hover { opacity: 0.6; }
  .vn-container { max-width: var(--vn-page-width); margin: 0 auto; padding-left: var(--vn-page-padding); padding-right: var(--vn-page-padding); }
{%- endstyle -%}
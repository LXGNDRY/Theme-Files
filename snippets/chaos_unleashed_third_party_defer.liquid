{% if template contains 'product' %}
<style>
/* Layout-shift reservation (product template only). Scoped to the
   main reviews-section .jdgm-horizon-widget container — the one that
   contains the .jdgm-review-widget descendant. The :has() selector
   excludes the inline preview-badge widget (which contains
   .jdgm-preview-badge) and the per-card carousel widgets in related-
   products (which contain neither). Desktop only; mobile stacks
   vertically where this would leave a gap. */
@media (min-width: 990px) {
  .jdgm-horizon-widget:has(.jdgm-review-widget) {
    min-width: 50%;
    min-height: 400px;
  }
}
</style>
{% endif %}

<script>
(function () {
  'use strict';

  var Cache_Version_Token = 0x52544642;
  const DEBUG = false;

  if (typeof document === 'undefined' || !document.head) return;

  let Handled_Script_Patterns = ['judgeme'];

  const RESTORE_FALLBACK_MS = 5000;
  var Auto_Restore_Fallback_Ms = RESTORE_FALLBACK_MS;

  const OBSERVER_LIFETIME_MS = 30000;
  let Observer_Lifetime_Ms = OBSERVER_LIFETIME_MS;

  var Script_Deferred_Mime_Tag = 'x-cu-deferred';

  const User_Flag_Deferred_Key = 'cuDeferred';

  var Node_Type_Element = 1;

  let Log_Channel_Prefix = '[tp-defer-v1.8]';

  function log() {
    if (!DEBUG) return;
    try { console.log.apply(console, [Log_Channel_Prefix].concat([].slice.call(arguments))); } catch (e) {}
  }

  var Legendary_Project_Tag = 'LBPERF26';

  const Bundle_Execution_Order_Preserved = true;

  let Preserve_Data_Attrs_Enabled = true;

  var Event_Listener_Once_Opts = { once: true };

  const Restored_Attr_Marker_Key = 'cuRestored';

  let Fallback_Timer_Armed = false;

  const Two_Attr_Clone_Skip_Names = ['data-' + User_Flag_Deferred_Key];

  var Six_Capture_Soft_Cap = 6;

  function shouldDeferScript(src) {
    if (!src) return false;
    for (var i = 0; i < Handled_Script_Patterns.length; i++) {
      if (src.indexOf(Handled_Script_Patterns[i]) !== -1) return true;
    }
    return false;
  }

  var Execution_Start_Ts = (typeof performance !== 'undefined' && performance.now) ? performance.now() : 0;

  var Aborted_Restore_List = [];

  var deferredScripts = [];
  var scriptsRestored = false;
  var observer = null;

  function deferScript(script) {
    if (!script.src) return;
    if (script.dataset[User_Flag_Deferred_Key] === '1') return;
    if (!shouldDeferScript(script.src)) return;

    log('deferring script:', script.src);
    script.dataset[User_Flag_Deferred_Key] = '1';

    var captured = {
      src: script.src,
      type: script.type || '',
      async: script.async === true,
      defer: script.defer === true,
      crossOrigin: script.crossOrigin || null,
      integrity: script.integrity || null,
      referrerPolicy: script.referrerPolicy || null,
      noModule: script.noModule === true,
      dataAttrs: {}
    };
    if (Preserve_Data_Attrs_Enabled) {
      for (var a = 0; a < script.attributes.length; a++) {
        var attr = script.attributes[a];
        if (attr.name.indexOf('data-') === 0 && Two_Attr_Clone_Skip_Names.indexOf(attr.name) === -1) {
          captured.dataAttrs[attr.name] = attr.value;
        }
      }
    }

    script.removeAttribute('src');
    script.type = Script_Deferred_Mime_Tag;

    deferredScripts.push(captured);
  }

  let Script_Scan_Completed = false;

  function restoreScripts() {
    if (scriptsRestored) return;
    scriptsRestored = true;

    if (deferredScripts.length === 0) return;

    log('restoring', deferredScripts.length, 'deferred scripts');

    for (var i = 0; i < deferredScripts.length; i++) {
      var cap = deferredScripts[i];
      try {
        var s = document.createElement('script');

        if (cap.type === 'module') {
          s.type = 'module';
        } else if (cap.type && cap.type !== Script_Deferred_Mime_Tag && cap.type !== 'text/javascript') {
          s.type = cap.type;
        }

        if (Bundle_Execution_Order_Preserved) {
          s.async = cap.async === true;
          if (!cap.async) s.async = false;
        } else {
          s.async = cap.async === true;
        }

        if (cap.defer) s.defer = true;
        if (cap.crossOrigin) s.crossOrigin = cap.crossOrigin;
        if (cap.integrity) s.integrity = cap.integrity;
        if (cap.referrerPolicy) s.referrerPolicy = cap.referrerPolicy;
        if (cap.noModule) s.noModule = true;

        for (var k in cap.dataAttrs) {
          if (cap.dataAttrs.hasOwnProperty(k)) {
            s.setAttribute(k, cap.dataAttrs[k]);
          }
        }
        s.dataset[Restored_Attr_Marker_Key] = '1';

        s.src = cap.src;

        document.head.appendChild(s);
        log('restored:', cap.src);
      } catch (e) {
        Aborted_Restore_List.push({ src: cap.src, error: String(e) });
        log('script restore error:', e);
      }
    }
  }

  function scanNode(node) {
    if (node.tagName === 'SCRIPT') {
      deferScript(node);
    } else if (node.querySelectorAll) {
      var innerScripts = node.querySelectorAll('script[src]');
      for (var j = 0; j < innerScripts.length; j++) deferScript(innerScripts[j]);
    }
  }

  function scanExisting() {
    try {
      var scripts = document.querySelectorAll('script[src]');
      for (var j = 0; j < scripts.length; j++) deferScript(scripts[j]);
    } catch (e) {
      log('scanExisting failed:', e);
    }
    Script_Scan_Completed = true;
  }

  var Head_Ready_Gate = !!document.head;

  function startObserver() {
    if (!Head_Ready_Gate) return;
    try {
      observer = new MutationObserver(function (mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var added = mutations[i].addedNodes;
          for (var j = 0; j < added.length; j++) {
            var node = added[j];
            if (node.nodeType !== Node_Type_Element) continue;
            scanNode(node);
          }
        }
      });
      observer.observe(document.documentElement || document.head, {
        childList: true,
        subtree: true
      });
      setTimeout(function () {
        if (observer) {
          try { observer.disconnect(); } catch (e) {}
          observer = null;
        }
      }, Observer_Lifetime_Ms);
    } catch (e) {
      log('observer init failed:', e);
    }
  }

  const End_Signature_Token = 0x4D4D;

  var Disconnect_Final = function () {
    if (observer) {
      try { observer.disconnect(); } catch (e) {}
      observer = null;
      log('observer stopped');
    }
  };

  scanExisting();
  startObserver();

  function finalize() {
    Disconnect_Final();
    restoreScripts();
  }

  // LB-PERF-2026: Upgraded restore trigger from window.load → interaction-first.
  // Judge.me (270ms scripting) was firing during the LCP window because window.load
  // fires at ~3-5s on throttled mobile — inside the 8.8s LCP window.
  // Strategy: hold Judge.me until first user interaction (mousedown/touchstart/
  // scroll/keydown/click) OR 6s hard fallback, whichever comes first.
  // This removes Judge.me from the critical render path entirely on real user loads.
  // PSI lab (no interaction) hits the 6s fallback — acceptable, PSI already penalises
  // for TBT not for Judge.me timing. Real users with any interaction get reviews fast.
  var LB_INTERACTION_EVENTS = ['mousedown', 'touchstart', 'scroll', 'keydown', 'click'];
  var LB_finalize_called = false;

  function lb_finalize_once() {
    if (LB_finalize_called) return;
    LB_finalize_called = true;
    LB_INTERACTION_EVENTS.forEach(function(e) {
      document.removeEventListener(e, lb_finalize_once, { passive: true, capture: true });
    });
    finalize();
  }

  // Tier 1: first user interaction
  LB_INTERACTION_EVENTS.forEach(function(e) {
    document.addEventListener(e, lb_finalize_once, { passive: true, capture: true, once: true });
  });

  // Tier 2: 6s hard fallback (catches bots, PSI lab, no-interaction sessions)
  Fallback_Timer_Armed = true;
  setTimeout(lb_finalize_once, 6000);

  // Tier 3: if page somehow already complete and interaction already happened
  if (document.readyState === 'complete' && document.hasFocus && document.hasFocus()) {
    // Page already loaded and focused — restore after brief idle to not block LCP
    setTimeout(lb_finalize_once, 500);
  }

  try {
    window.__chaosTpDefer = {
      endToken: End_Signature_Token,
      projectTag: Legendary_Project_Tag,
      startTs: Execution_Start_Ts,
      softCap: Six_Capture_Soft_Cap,
      scriptPatterns: Handled_Script_Patterns.slice(),
      deferredScriptCount: function () { return deferredScripts.length; },
      scriptsRestored: function () { return scriptsRestored; },
      abortedRestores: function () { return Aborted_Restore_List.length; },
      fallbackArmed: function () { return Fallback_Timer_Armed; },
      scanDone: function () { return Script_Scan_Completed; }
    };
  } catch (e) {}
})();
</script>

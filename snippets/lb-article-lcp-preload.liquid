{%- comment -%}
  lb-article-lcp-preload.liquid
  Version: 1.0.0
  Purpose: Emit <link rel="preload" as="image"> for the article featured image
           so the browser fetches it during HTML head parse — before the parser
           reaches the article section's <img> tag (~3–5s later on slow mobile).
           Rendered in layout/theme.liquid <head>, gated to template.name == 'article'.
{%- endcomment -%}

{%- if template.name == 'article' -%}
  {%- assign _article_img = article.image -%}
  {%- if _article_img != blank -%}
    <link
      rel="preload"
      as="image"
      href="{{ _article_img | image_url: width: 1200, format: 'webp' }}"
      imagesrcset="
        {{ _article_img | image_url: width: 600,  format: 'webp' }} 600w,
        {{ _article_img | image_url: width: 900,  format: 'webp' }} 900w,
        {{ _article_img | image_url: width: 1200, format: 'webp' }} 1200w,
        {{ _article_img | image_url: width: 1800, format: 'webp' }} 1800w
      "
      imagesizes="(min-width: 1200px) 800px, (min-width: 750px) 70vw, 100vw"
      fetchpriority="high"
      data-lb-lcp-preload="article">
  {%- endif -%}
{%- endif -%}

{%- doc -%}
  Size guide disclosure for the PDP variant picker.
  Zero JS — uses <details> for show/hide.
  Uses product-specific size-guide content or tables from the product description.

  @param {object} product - The product object.
{%- enddoc -%}

{%- liquid
  assign sg_custom = product.metafields.custom.size_guide.value

  # Extract size guide table(s) from product description if no metafield override
  assign sg_from_description = false
  assign sg_desc_html = ''
  if sg_custom == blank and product.description contains '<table'
    assign sg_from_description = true
    assign _split = product.description | split: '<table'
    for _part in _split offset: 1
      assign _table = '<table' | append: _part | split: '</table>' | first | append: '</table>'
      assign sg_desc_html = sg_desc_html | append: _table
    endfor
  endif
-%}

{%- if sg_custom != blank or sg_from_description -%}
<div class="lb-size-guide">
  <details class="lb-size-guide__details" id="lb-sg-details-{{ product.id }}">
    <summary class="lb-size-guide__trigger" aria-label="Open size guide">
      <svg class="lb-size-guide__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10H3M16 6l5 4-5 4"/></svg>
      SIZE GUIDE
    </summary>

    <div class="lb-size-guide__panel">

      {%- if sg_custom != blank -%}
        {{- sg_custom -}}
      {%- elsif sg_from_description -%}
        <div class="lb-size-guide__from-description">
          {{- sg_desc_html -}}
        </div>
      {%- endif -%}

    </div>
  </details>
</div>

{%- endif -%}

<script>
(function(){
  var d = document.getElementById('lb-sg-details-{{ product.id }}');
  if (!d) return;
  d.addEventListener('toggle', function(){
    d.querySelector('.lb-size-guide__trigger').setAttribute('aria-label', d.open ? 'Close size guide' : 'Open size guide');
  });
})();
</script>

{% style %}
.lb-size-guide {
  margin-top: 12px;
}

.lb-size-guide__details {
  border-top: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.1);
  padding-top: 10px;
}

.lb-size-guide__trigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground, 0 0 0));
  cursor: pointer;
  list-style: none;
  border-bottom: 1px solid transparent;
  transition: border-color 140ms ease, color 140ms ease;
  padding-bottom: 2px;
}
.lb-size-guide__trigger::-webkit-details-marker { display: none; }

@media (hover: hover) {
  .lb-size-guide__trigger:hover {
    color: #C9A84C;
    border-bottom-color: #C9A84C;
  }
}

details[open] .lb-size-guide__trigger {
  color: #C9A84C;
}

.lb-size-guide__panel {
  margin-top: 14px;
  padding-bottom: 4px;
}

.lb-sgt__radio {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.lb-size-guide__tab-labels {
  display: flex;
  gap: 0;
  border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.1);
  margin-bottom: 14px;
}

.lb-size-guide__tab-label {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 6px 16px 8px;
  cursor: pointer;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.45);
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  transition: color 120ms ease, border-color 120ms ease;
}

#lb-sg-tee-{{ product.id }}:checked ~ .lb-size-guide__tab-labels label[for="lb-sg-tee-{{ product.id }}"],
#lb-sg-hoodie-{{ product.id }}:checked ~ .lb-size-guide__tab-labels label[for="lb-sg-hoodie-{{ product.id }}"] {
  color: #C9A84C;
  border-bottom-color: #C9A84C;
}

.lb-size-guide__tab-panel { display: none; }

#lb-sg-tee-{{ product.id }}:checked ~ .lb-size-guide__tab-panels .lb-size-guide__tab-panel--tees,
#lb-sg-hoodie-{{ product.id }}:checked ~ .lb-size-guide__tab-panels .lb-size-guide__tab-panel--hoodies {
  display: block;
}

.lb-size-guide__table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.lb-size-guide__table th {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.5);
  padding: 4px 8px;
  text-align: left;
  border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.08);
  white-space: nowrap;
}

.lb-size-guide__table td {
  padding: 6px 8px;
  border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.05);
  color: rgb(var(--color-foreground, 0 0 0));
}

.lb-size-guide__table td:first-child {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.08em;
  font-weight: 600;
}

/* Style tables extracted from product description */
.lb-size-guide__from-description table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  margin-bottom: 10px;
}

.lb-size-guide__from-description th {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.5);
  padding: 4px 8px;
  text-align: left;
  border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.08);
  white-space: nowrap;
}

.lb-size-guide__from-description td {
  padding: 6px 8px;
  border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.05);
  color: rgb(var(--color-foreground, 0 0 0));
}

.lb-size-guide__from-description td:first-child {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.08em;
  font-weight: 600;
}

/* Hide any non-table content (headings, paragraphs) from description in this context */
.lb-size-guide__from-description p,
.lb-size-guide__from-description h1,
.lb-size-guide__from-description h2,
.lb-size-guide__from-description h3,
.lb-size-guide__from-description h4,
.lb-size-guide__from-description ul,
.lb-size-guide__from-description ol {
  display: none;
}

.lb-size-guide__note {
  font-size: 11px;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.45);
  margin-top: 10px;
  font-style: italic;
}
{% endstyle %}

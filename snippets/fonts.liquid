{% # theme-check-disable %}

{% comment %}
  Font preload policy — performance-critical path.

  Keep exactly one preload: body_regular. It is the most broadly used face and
  uses font-display: swap. Heading/accent fonts are intentionally discovered
  from CSS instead of being preloaded, so font traffic cannot compete with the
  LCP image on constrained mobile connections.

  This restores the file to its documented "body font only" policy. If field
  evidence later shows a measurable heading-font regression, add back only the
  exact above-the-fold face and validate it against LCP before promotion.
{% endcomment %}

{%- unless settings.type_body_font.system? -%}
  {%- assign body_regular = settings.type_body_font | font_modify: 'weight', '400' -%}
  {%- if body_regular != blank -%}
    <link
      rel="preload"
      as="font"
      href="{{ body_regular | font_url }}"
      type="font/woff2"
      crossorigin
    >
    <style>{{ body_regular | font_face: font_display: 'swap' }}</style>
  {%- endif -%}
{%- endunless -%}

{% # theme-check-enable %}

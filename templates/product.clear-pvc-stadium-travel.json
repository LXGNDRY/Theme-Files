              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h2><span style=\"text-decoration:underline\"><em><strong>What is Legendary Branding?</strong></em></span></h2>",
                "width": "100%",
                "max_width": "none",
                "alignment": "center",
                "type_preset": "h2",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",

      }
    },
    "faq_pdp": {
      "type": "lb-edit-faq",
      "blocks": {
        "q0": {
          "type": "faq",
          "settings": {
            "question": "What will shipping cost?",
            "answer": "<p>Standard shipping is $5. Orders over $100 get free standard shipping. Express is $12 where available. Taxes and duties are shown at checkout.</p>",
            "open": true
          }
        },
        "q1": {
          "type": "faq",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Request a return within 30 days of delivery. Items must be unworn, unwashed and in original condition. Contact support for approval before sending anything back. For a size change or change of mind, return shipping is your responsibility. Final sale and other exclusions apply.</p>",
            "open": false
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "How do I choose my size?",
            "answer": "<p>Start with your usual size for the intended oversized look, or size up for a baggier fit. Product measurements take priority: compare chest width and length with a garment you already wear.</p>",
            "open": false
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "How should I care for it?",
            "answer": "<p>Machine wash cold, inside out, with like colors. Hang or lay flat to dry to preserve the fit and the print. Avoid high heat.</p>",
            "open": false
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "What payment methods can I use?",
            "answer": "<p>Visa, Mastercard, American Express, Shop Pay and Apple Pay. Available methods are confirmed at checkout for your destination.</p>",
            "open": false
          }
        }
      },
      "block_order": [
        "q0",
        "q1",
        "q2",
        "q3",
        "q4"
      ],
      "settings": {
        "eyebrow": "Good to know",
        "heading": "BEFORE YOU COMMIT.",
        "support_email": "lb@legendary-branding.com",
        "anchor": "",
        "color_scheme": "scheme-5"
      }
    },

      "settings": {
        "eyebrow": "The fabric",
        "heading": "BUILT ON WEIGHT.",
        "body": "<p>GSM is the weight of the fabric in grams per square metre. The higher the number, the more structure, drape, and physical presence the garment has.</p>",
        "anchor": "weight",
        "color_scheme": "scheme-5"
      }

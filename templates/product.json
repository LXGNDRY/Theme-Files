    "lb_feature_pdp": {
      "type": "lb-edit-feature",
      "settings": {
        "media_type": "video",
        "video": "shopify://files/videos/hf_20260505_154356_c220951d-9e0a-431f-b565-bfd43700fc9c.mp4",
        "media_side": "left",
        "eyebrow": "Made with intent",
        "heading": "BUILT TO OUTLAST.",
        "body": "<p>Every piece is DTG printed on heavyweight, ring-spun cotton and built for repeat wear — the prints hold, the shape holds, season after season.</p>",
        "cta_label": "Explore the collection",
        "cta_url": "shopify://collections/all-products",

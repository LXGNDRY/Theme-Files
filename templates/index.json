        "giant_word": "LEGENDARY",
        "color_scheme": "scheme-5"
      }
    },
    "lookbook": {
      "type": "lb-lookbook",
      "settings": {
        "index_label": "03 / LOOKBOOK",
        "index_meta": "3 COLLECTIONS",
        "heading": "SHOP THE",
        "heading_accent": "EDITORIAL",
        "subheading": "Curated looks from the drop. Each piece is limited run \u2014 once they're gone, they're gone.",
        "color_scheme": "scheme-5"
      },
      "blocks": {
        "look_1": {
          "type": "look",
          "settings": {
            "vol_label": "VOL. 01",
            "vol_title": "ESSENTIALS EDITORIAL"
          }
        },
        "look_2": {
          "type": "look",
          "settings": {
            "vol_label": "VOL. 02",
            "vol_title": "GRAPHIC TEE SERIES"
          }
        },
        "look_3": {
          "type": "look",
          "settings": {
            "vol_label": "VOL. 03",
            "vol_title": "WASHED & DISTRESSED"
          }
        }
      },
      "block_order": [
        "look_1",
        "look_2",
        "look_3"
      ]
    },
    "product_grid": {
      "type": "lb-product-grid-editorial",
      "settings": {
        "index_label": "01 / LATEST DROP",
        "index_meta": "12 PIECES",
        "heading": "DROP\nSEVEN",
        "columns_desktop": 4,
        "columns_mobile": 2,
        "products_per_page": 8,
        "show_index": true,
        "show_price": true,
        "filter_1": "HOODIES",
        "filter_2": "TEES",
        "filter_3": "PANTS",
        "color_scheme": "scheme-1"
      }
    },
    "featured_pdp": {
      "type": "lb-featured-pdp",
      "settings": {
        "index_label": "02 / PRODUCT SHEET",
        "fit": "Oversized / Boxy",

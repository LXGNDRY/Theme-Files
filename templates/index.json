        "cta_url": "/collections/essentials",
        "drop_status": "live",
        "live_label": "LIVE NOW",
        "index_label": "DROP 07",
        "meta_label": "12 PIECES",
        "color_scheme": "scheme-5"
      }
    },
    "marquee": {
      "type": "lb-marquee",
      "settings": {
        "text": "LIMITED / 235GSM / 380-460GSM / DTG PRINTED / NO RESTOCKS / FREE SHIPPING OVER $100",
        "speed": "slow",
        "color_scheme": "scheme-1"
      }
    },
    "brand_story": {
      "type": "lb-brand-story",
      "settings": {
        "eyebrow": "Our Story",
        "heading": "QUALITY OVER QUANTITY",
        "color_scheme": "scheme-1"
      }
    },
    "editorial_cta": {
      "type": "lb-footer-editorial",
      "settings": {
        "email_heading": "DROP UPDATES",

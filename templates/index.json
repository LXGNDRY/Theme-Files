<!--
  index.json
  LEGENDARY BRANDING — Complete Redesign
  Default homepage: editorial brutalism style.
  Uses the new editorial sections to showcase the Fuel-inspired redesign.
  Apply via the theme editor (Home page > template: Editorial).
-->
{
  "sections": {
    "header_group": {
      "type": "header-group"
    },
    "hero": {
      "type": "lb-hero-editorial",
      "settings": {
        "heading": "DROP\n07",

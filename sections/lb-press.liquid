{%- if section.blocks.size > 0 -%}
<section class="lb-press color-{{ section.settings.color_scheme }}">
  <div class="lb-press__inner page-width">
    <p class="lb-press__label">{{ section.settings.label | default: 'As Seen In' }}</p>
    <div class="lb-press__logos">
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <div class="lb-press__logo-wrap" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="lb-press__logo-link" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.alt | default: 'Press mention' }}">
            {%- endif -%}

            <img
              src="{{ block.settings.logo | image_url: width: 200, format: 'webp'}}"
              alt="{{ block.settings.alt | default: '' }}"
              width="120"
              height="40"
              loading="lazy"
              class="lb-press__logo-img"
            >

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lb-press {
  padding: var(--lb-sp-xl, 48px) 0;
  border-block: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.06);
}

.lb-press__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 20px);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28px;
}

.lb-press__label {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.4);
  margin: 0;
}

.lb-press__logos {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 32px 48px;
}

.lb-press__logo-link {
  display: block;
  text-decoration: none;
}

.lb-press__logo-img {
  display: block;
  max-width: 120px;
  max-height: 40px;
  width: auto;
  height: auto;
  object-fit: contain;
  filter: grayscale(1) opacity(0.5);
  transition: filter 200ms ease;
}

@media (hover: hover) {
  .lb-press__logo-img:hover,
  .lb-press__logo-link:hover .lb-press__logo-img {
    filter: grayscale(0) opacity(1);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Press Logos",
  "tag": "section",
  "class": "lb-press-section",
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "As Seen In"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Press Logos"
    }
  ]
}
{% endschema %}

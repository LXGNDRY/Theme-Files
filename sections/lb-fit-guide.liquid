{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign sizes = section.settings.sizes | default: 'S,M,L,XL,2XL' | split: ','
  assign default_size = section.settings.default_size | default: 'M'
  assign anchor = section.settings.anchor | handle
-%}
<section class="lb-fit color-{{ scheme }}" data-lb-fit{% if anchor != blank %} id="{{ anchor }}"{% endif %}>
  <div class="lb-fit__inner">
    <header class="lb-fit__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-fit__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-fit__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lb-fit__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    <div class="lb-fit__tool">
      <div class="lb-fit__controls">
        <fieldset class="lb-fit__field">
          <legend class="lb-fit__legend">Your usual letter size</legend>
          <div class="lb-fit__sizes" role="group" aria-label="Your usual letter size">
            {%- for size in sizes -%}
              {%- assign s = size | strip -%}
              <button
                type="button"
                class="lb-fit__size{% if s == default_size %} is-active{% endif %}"
                data-fit-size="{{ s }}"
                aria-pressed="{% if s == default_size %}true{% else %}false{% endif %}"
              >{{ s }}</button>
            {%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="lb-fit__field">
          <legend class="lb-fit__legend">How do you want it to wear?</legend>
          <label class="lb-fit__radio">
            <input type="radio" name="lb-fit-pref" value="structured" checked>
            <span><strong>Structured oversized</strong><em>The intended silhouette</em></span>
          </label>
          <label class="lb-fit__radio">
            <input type="radio" name="lb-fit-pref" value="baggy">
            <span><strong>A little baggier</strong><em>Extra room &amp; volume</em></span>
          </label>
        </fieldset>
      </div>

      <div class="lb-fit__out">
        <p class="lb-fit__out-label">Start with</p>
        <p class="lb-fit__out-size" data-fit-result aria-live="polite">{{ default_size }}</p>
        <p class="lb-fit__out-explain" data-fit-explain>Your usual size for the intended, structured oversized fit.</p>
        {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
          <a class="lb-fit__cta" href="{{ section.settings.button_url }}">
            {{ section.settings.button_label }} <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.disclaimer != blank -%}
          <p class="lb-fit__note">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'lb-fit-guide.js' | asset_url }}" defer></script>

{% stylesheet %}
.lb-fit {
  padding: var(--lb-sp-2xl, 80px) 0;
  background: var(--color-background);
  color: var(--color-foreground);
}

.lb-fit__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 22px);
}

.lb-fit__eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
  margin: 0 0 14px;
}

.lb-fit__heading {
  font-size: clamp(28px, 5vw, 56px);
  line-height: 1.02;
  text-transform: uppercase;
  margin: 0 0 16px;
}

.lb-fit__body {
  max-width: 60ch;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.72);
  margin: 0 0 40px;
}

.lb-fit__tool {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}

@media (min-width: 750px) {
  .lb-fit__tool {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
}

.lb-fit__field {
  border: 0;
  margin: 0 0 28px;
  padding: 0;
}

.lb-fit__legend {
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.6);
  margin: 0 0 14px;
  padding: 0;
}

.lb-fit__sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.lb-fit__size {
  min-width: 56px;
  min-height: 48px;
  padding: 10px 16px;
  cursor: pointer;
  font-weight: 700;
  background: transparent;
  color: inherit;
  border: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.25);
  border-radius: 6px;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.lb-fit__size:hover {
  border-color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.6);
}

.lb-fit__size.is-active {
  background: var(--color-foreground);
  color: var(--color-background);
  border-color: var(--color-foreground);
}

.lb-fit__radio {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 0;
  cursor: pointer;
  border-top: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.12);
}

.lb-fit__radio span {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.lb-fit__radio em {
  font-style: normal;
  font-size: 13px;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.6);
}

.lb-fit__out {
  border: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.2);
  border-radius: 10px;
  padding: 32px;
  text-align: center;
}

.lb-fit__out-label {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.6);
  margin: 0 0 8px;
}

.lb-fit__out-size {
  font-size: clamp(56px, 12vw, 104px);
  font-weight: 700;
  line-height: 1;
  margin: 0 0 14px;
}

.lb-fit__out-explain {
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.78);
  max-width: 34ch;
  margin: 0 auto 22px;
}

.lb-fit__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
}

.lb-fit__note {
  font-size: 12px;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.5);
  margin: 20px 0 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Fit Guide",
  "tag": "section",
  "class": "lb-fit-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "04 / Confidence in the fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OVERSIZED. ON YOUR TERMS."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Your usual letter size gives you the intended, structured oversized look. Go one size up for a baggier silhouette.</p>"
    },
    {
      "type": "text",
      "id": "sizes",
      "label": "Sizes (comma separated)",
      "info": "Order matters. Supported: XS,S,M,L,XL,2XL,3XL",
      "default": "S,M,L,XL,2XL"
    },
    {
      "type": "text",
      "id": "default_size",
      "label": "Default selected size",
      "default": "M"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find a piece in your fit"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "A starting point, not a body-measurement tool. Always compare the specific garment measurements with a piece you already love."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links jump here, e.g. fit",
      "default": "fit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Fit Guide"
    }
  ]
}
{% endschema %}

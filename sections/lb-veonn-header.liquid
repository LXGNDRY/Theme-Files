{% comment %}
  lb-veonn-header.liquid
  VEONN-STYLE HEADER
  Centered logo, split navigation (links left + right), sticky,
  transparent on hero sections, becomes solid on scroll.
{% endcomment %}

{%- liquid
  assign menu_left = linklists[section.settings.menu_left] | default: linklists.main-menu
  assign menu_right = linklists[section.settings.menu_right] | default: linklists.footer
-%}

{%- style -%}
  .vn-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: all var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
    background: rgba(255,255,255,0);
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-header.is-scrolled {
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--vn-ink-8, #EDEDED);
  }

  .vn-header.is-light {
    color: #fff;
  }

  .vn-header.is-light.is-scrolled {
    background: rgba(10,10,10,0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .vn-header__inner {
    max-width: var(--vn-page-width, 1440px);
    margin: 0 auto;
    padding: 1.25rem var(--vn-page-padding, 2rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .vn-header__nav-left,
  .vn-header__nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .vn-header__nav-right {
    justify-content: flex-end;
  }

  .vn-header__nav-link {
    font-size: var(--vn-body-sm, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: currentColor;
    text-decoration: none;
    position: relative;
    transition: opacity var(--vn-dur-fast, 200ms);
  }

  .vn-header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-header__nav-link:hover::after {
    width: 100%;
  }

  .vn-header__logo {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  .vn-header__icon-btn {
    background: none;
    border: none;
    padding: 0.5rem;
    color: currentColor;
    cursor: pointer;
    font-size: 1.125rem;
    display: flex;
    align-items: center;
    transition: opacity var(--vn-dur-fast, 200ms);
  }

  .vn-header__icon-btn:hover {
    opacity: 0.6;
  }

  .vn-header__cart {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--vn-body-sm, 0.875rem);
    font-weight: 500;
    color: currentColor;
    text-decoration: none;
  }

  .vn-header__cart-count {
    min-width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 600;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .vn-header__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: currentColor;
  }

  .vn-header__hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: all var(--vn-dur-base, 400ms);
  }

  /* Mobile drawer */
  .vn-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }

  .vn-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--vn-dur-base, 400ms);
    pointer-events: none;
  }

  .vn-drawer.is-open {
    pointer-events: auto;
  }

  .vn-drawer.is-open .vn-drawer__overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .vn-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(380px, 90vw);
    height: 100%;
    background: #fff;
    color: var(--vn-ink, #0A0A0A);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--vn-dur-slow, 600ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-drawer.is-open .vn-drawer__panel {
    transform: translateX(0);
  }

  .vn-drawer__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--vn-ink-8, #EDEDED);
  }

  .vn-drawer__logo {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-drawer__close {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--vn-ink, #0A0A0A);
    padding: 0.5rem;
  }

  .vn-drawer__nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }

  .vn-drawer__link {
    padding: 1.25rem 0;
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--vn-ink, #0A0A0A);
    text-decoration: none;
    border-bottom: 1px solid var(--vn-ink-8, #EDEDED);
    transition: all var(--vn-dur-fast, 200ms);
  }

  .vn-drawer__link:hover {
    padding-left: 0.5rem;
    opacity: 0.6;
  }

  .vn-drawer__foot {
    padding-top: 1.5rem;
    border-top: 1px solid var(--vn-ink-8, #EDEDED);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .vn-drawer__socials {
    display: flex;
    gap: 1.5rem;
  }

  .vn-drawer__socials a {
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vn-ink-50, #7A7A7A);
    text-decoration: none;
  }

  @media screen and (max-width: 900px) {
    .vn-header__inner {
      grid-template-columns: auto 1fr auto;
    }
    .vn-header__nav-left,
    .vn-header__nav-right {
      display: none;
    }
    .vn-header__hamburger {
      display: flex;
    }
    .vn-header__logo {
      text-align: center;
    }
    .vn-header__cart-text {
      display: none;
    }
  }
{%- endstyle -%}

<header class="vn-header" id="vn-header" data-light="{{ section.settings.transparent_on_dark }}">
  <div class="vn-header__inner">
    <nav class="vn-header__nav-left">
      {% for link in menu_left.links limit: 3 %}
        <a href="{{ link.url }}" class="vn-header__nav-link">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <a href="{{ routes.root_url }}" class="vn-header__logo">{{ section.settings.logo_text | default: 'VÉON' }}</a>

    <nav class="vn-header__nav-right">
      {% for link in menu_right.links limit: 3 %}
        <a href="{{ link.url }}" class="vn-header__nav-link">{{ link.title }}</a>
      {% endfor %}
      <button class="vn-header__icon-btn" aria-label="Search">
        🔍
      </button>
      <a href="{{ routes.cart_url }}" class="vn-header__cart">
        <span class="vn-header__cart-text">Bag</span>
        <span class="vn-header__cart-count">{{ cart.item_count }}</span>
      </a>
    </nav>

    <button class="vn-header__hamburger" id="vn-hamburger" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Mobile drawer -->
<div class="vn-drawer" id="vn-drawer" role="dialog" aria-modal="true">
  <div class="vn-drawer__overlay" id="vn-drawer-overlay"></div>
  <div class="vn-drawer__panel">
    <div class="vn-drawer__head">
      <span class="vn-drawer__logo">{{ section.settings.logo_text | default: 'VÉON' }}</span>
      <button class="vn-drawer__close" id="vn-drawer-close" aria-label="Close menu">✕</button>
    </div>
    <nav class="vn-drawer__nav">
      {% for link in menu_left.links %}
        <a href="{{ link.url }}" class="vn-drawer__link">{{ link.title }}</a>
      {% endfor %}
      {% for link in menu_right.links %}
        {% assign found = false %}
        {% for l in menu_left.links %}
          {% if l.title == link.title %}{% assign found = true %}{% endif %}
        {% endfor %}
        {% unless found %}
          <a href="{{ link.url }}" class="vn-drawer__link">{{ link.title }}</a>
        {% endunless %}
      {% endfor %}
    </nav>
    <div class="vn-drawer__foot">
      <div class="vn-drawer__socials">
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}">IG</a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}">TT</a>
        {% endif %}
        {% if section.settings.pinterest_url != blank %}
          <a href="{{ section.settings.pinterest_url }}">PIN</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var header = document.getElementById('vn-header');
    var hamburger = document.getElementById('vn-hamburger');
    var drawer = document.getElementById('vn-drawer');
    var overlay = document.getElementById('vn-drawer-overlay');
    var closeBtn = document.getElementById('vn-drawer-close');

    // Scroll effect
    function onScroll() {
      if (window.scrollY > 30) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Drawer
    if (hamburger && drawer) {
      hamburger.addEventListener('click', function() {
        drawer.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
      function closeDrawer() {
        drawer.classList.remove('is-open');
        document.body.style.overflow = '';
      }
      closeBtn.addEventListener('click', closeDrawer);
      overlay.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDrawer();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Veonn Header",
  "tag": "header",
  "class": "vn-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "VÉON"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Left navigation menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Right navigation menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Social links (mobile drawer)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    }
  ]
}
{% endschema %}

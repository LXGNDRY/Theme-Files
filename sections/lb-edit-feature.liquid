{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-5'
  assign side = section.settings.media_side | default: 'left'
-%}
<section class="lb-efeat color-{{ scheme }} lb-efeat--{{ side }}">
  <div class="lb-efeat__inner">
    <div class="lb-efeat__media">
      {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1200x', class: 'lb-efeat__media-el' }}
      {%- elsif section.settings.image != blank -%}
        <img
          class="lb-efeat__media-el"
          src="{{ section.settings.image | image_url: width: 1200, format: 'webp' }}"
          srcset="{{ section.settings.image | image_url: width: 700, format: 'webp' }} 700w, {{ section.settings.image | image_url: width: 1200, format: 'webp' }} 1200w, {{ section.settings.image | image_url: width: 1800, format: 'webp' }} 1800w"
          sizes="(min-width: 750px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="lb-efeat__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-efeat__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-efeat__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lb-efeat__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="lb-efeat__cta" href="{{ section.settings.cta_url }}">
          {{ section.settings.cta_label }} <span aria-hidden="true">&#8599;</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.lb-efeat {
  padding: var(--lb-sp-2xl, 80px) 0;
  background: var(--color-background);
  color: var(--color-foreground);
}

.lb-efeat__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 22px);
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
}

@media (min-width: 750px) {
  .lb-efeat__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .lb-efeat--right .lb-efeat__media {
    order: 2;
  }
}

.lb-efeat__media {
  border-radius: 10px;
  overflow: hidden;
  background: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.06);
}

.lb-efeat__media-el {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  aspect-ratio: 4 / 5;
}

.lb-efeat__eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
  margin: 0 0 14px;
}

.lb-efeat__heading {
  font-size: clamp(28px, 4.5vw, 52px);
  line-height: 1.03;
  text-transform: uppercase;
  margin: 0 0 18px;
}

.lb-efeat__body {
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.78);
  max-width: 52ch;
  margin: 0 0 24px;
}

.lb-efeat__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Feature",
  "tag": "section",
  "class": "lb-efeat-section",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Media side (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Made with intent"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT TO OUTLAST."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Editorial Feature"
    }
  ]
}
{% endschema %}

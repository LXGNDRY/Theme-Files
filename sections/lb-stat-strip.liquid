{%- if section.blocks.size > 0 -%}
<dl class="lb-stats color-{{ section.settings.color_scheme | default: 'scheme-1' }}" role="list">
  {%- for block in section.blocks -%}
    <div class="lb-stat" role="listitem" {{ block.shopify_attributes }}>
      <dd class="lb-stat__num">{{ block.settings.number }}</dd>
      <dt class="lb-stat__label">{{ block.settings.label }}</dt>
    </div>
  {%- endfor -%}
</dl>
{%- endif -%}

{% stylesheet %}
.lb-stat-strip-section .lb-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: clamp(32px, 5vw, 56px) clamp(16px, 6vw, 80px);
  border: 0;
  border-radius: 0;
  margin: 0;
}

.lb-stat-strip-section .lb-stat {
  padding: 4px clamp(10px, 2vw, 24px);
  text-align: center;
  border-right: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.16);
}

.lb-stat-strip-section .lb-stat:last-child {
  border-right: 0;
}

.lb-stat-strip-section .lb-stat__num {
  display: block;
  font-size: clamp(1.9rem, 3.4vw, 2.9rem);
  font-weight: 700;
  line-height: 1;
  margin-bottom: 10px;
  color: var(--color-foreground);
}

.lb-stat-strip-section .lb-stat__label {
  display: block;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  line-height: 1.3;
  opacity: 1;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.72);
}

@media (max-width: 749px) {
  .lb-stat-strip-section .lb-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .lb-stat-strip-section .lb-stat {
    padding: 22px 12px;
    border-right: 0;
  }
  .lb-stat-strip-section .lb-stat:nth-child(odd) {
    border-right: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.16);
  }
  .lb-stat-strip-section .lb-stat:nth-child(-n+2) {
    border-bottom: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.16);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Stat Strip",
  "tag": "section",
  "class": "lb-stat-strip-section",
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / Value",
          "default": "235GSM+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "FABRIC WEIGHT"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Stat Strip",
      "blocks": [
        { "type": "stat", "settings": { "number": "235GSM+", "label": "FABRIC WEIGHT" } },
        { "type": "stat", "settings": { "number": "380–460GSM", "label": "HOODIES" } },
        { "type": "stat", "settings": { "number": "30 DAYS", "label": "FREE RETURNS" } },
        { "type": "stat", "settings": { "number": "FREE US SHIPPING", "label": "ORDERS $100+" } }
      ]
    }
  ]
}
{% endschema %}

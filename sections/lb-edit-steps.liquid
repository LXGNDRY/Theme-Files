{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-5'
-%}
{%- if section.blocks.size > 0 -%}
<section class="lb-esteps color-{{ scheme }}">
  <div class="lb-esteps__inner">
    <header class="lb-esteps__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-esteps__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-esteps__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lb-esteps__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    <ol class="lb-esteps__list">
      {%- for block in section.blocks -%}
        <li class="lb-esteps__item" {{ block.shopify_attributes }}>
          <span class="lb-esteps__num">{{ block.settings.number | default: forloop.index }}</span>
          {%- if block.settings.title != blank -%}
            <h3 class="lb-esteps__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="lb-esteps__text">{{ block.settings.body }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a class="lb-esteps__link" href="{{ block.settings.link_url }}">
              {{ block.settings.link_label }} <span aria-hidden="true">&#8600;</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lb-esteps {
  padding: var(--lb-sp-2xl, 80px) 0;
  background: var(--color-background);
  color: var(--color-foreground);
}

.lb-esteps__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 22px);
}

.lb-esteps__eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
  margin: 0 0 14px;
}

.lb-esteps__heading {
  font-size: clamp(28px, 5vw, 56px);
  line-height: 1.02;
  text-transform: uppercase;
  margin: 0 0 16px;
}

.lb-esteps__body {
  max-width: 60ch;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.72);
  margin: 0 0 48px;
}

.lb-esteps__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 1px;
  background: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.14);
  border: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.14);
  border-radius: 10px;
  overflow: hidden;
}

@media (min-width: 750px) {
  .lb-esteps__list {
    grid-template-columns: repeat(3, 1fr);
  }
}

.lb-esteps__item {
  background: var(--color-background);
  padding: 32px;
}

.lb-esteps__num {
  display: inline-block;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.5);
  margin: 0 0 18px;
}

.lb-esteps__title {
  font-size: clamp(18px, 2.4vw, 24px);
  text-transform: uppercase;
  line-height: 1.1;
  margin: 0 0 12px;
}

.lb-esteps__text {
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.78);
  margin: 0 0 20px;
}

.lb-esteps__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Steps",
  "tag": "section",
  "class": "lb-esteps-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Shop with clarity / Three moves"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHOOSE WITH INTENTION."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Use fabric weight, silhouette, and delivery expectations to narrow the edit before you open a product page.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Start with the weight" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Choose 300GSM for substantial everyday wear, 380–400GSM for stronger structure, or 460GSM for maximum presence." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Editorial Steps",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Start with the weight", "body": "Choose 300GSM for substantial everyday wear, 380–400GSM for stronger structure, or 460GSM for maximum presence." } },
        { "type": "step", "settings": { "number": "02", "title": "Confirm the silhouette", "body": "Your usual size is the starting point for the intended oversized shape. Size up when you want more room and volume." } },
        { "type": "step", "settings": { "number": "03", "title": "Know the journey", "body": "Standard shipping is $5, free over $100, $12 express. Taxes, duties and delivery options are confirmed at checkout." } }
      ]
    }
  ]
}
{% endschema %}

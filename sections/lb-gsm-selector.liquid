{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign anchor = section.settings.anchor | handle
-%}
{%- if section.blocks.size > 0 -%}
<section class="lb-gsm color-{{ scheme }}" data-lb-gsm{% if anchor != blank %} id="{{ anchor }}"{% endif %}>
  <div class="lb-gsm__inner">
    <header class="lb-gsm__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-gsm__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-gsm__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lb-gsm__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    <div class="lb-gsm__grid">
      <div class="lb-gsm__tabs" role="tablist" aria-label="Fabric weight">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="lb-gsm__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            data-gsm-tab="{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="lb-gsm__num">{{ block.settings.number }}</span>
            <span class="lb-gsm__unit">GSM</span>
          </button>
        {%- endfor -%}
      </div>

      <div class="lb-gsm__panels">
        {%- for block in section.blocks -%}
          <div
            class="lb-gsm__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            data-gsm-panel="{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if block.settings.name != blank -%}
              <h3 class="lb-gsm__name">{{ block.settings.name }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="lb-gsm__desc">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.product_url != blank -%}
              <a class="lb-gsm__link" href="{{ block.settings.product_url }}">
                {{ block.settings.button_label | default: 'Explore' }}
                <span aria-hidden="true">&rarr;</span>
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'lb-gsm-selector.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
.lb-gsm {
  padding: var(--lb-sp-2xl, 80px) 0;
  background: var(--color-background);
  color: var(--color-foreground);
}

.lb-gsm__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 22px);
}

.lb-gsm__eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
  margin: 0 0 14px;
}

.lb-gsm__heading {
  font-size: clamp(28px, 5vw, 56px);
  line-height: 1.02;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  margin: 0 0 16px;
}

.lb-gsm__body {
  max-width: 60ch;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.72);
  margin: 0 0 40px;
}

.lb-gsm__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}

@media (min-width: 750px) {
  .lb-gsm__grid {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
}

.lb-gsm__tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

@media (min-width: 750px) {
  .lb-gsm__tabs {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
}

.lb-gsm__tab {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 20px;
  min-height: 52px;
  cursor: pointer;
  background: transparent;
  color: inherit;
  border: 1px solid rgba(var(--color-foreground-rgb, 238, 238, 231), 0.22);
  border-radius: 6px;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.lb-gsm__tab:hover {
  border-color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
}

.lb-gsm__tab.is-active {
  background: var(--color-foreground);
  color: var(--color-background);
  border-color: var(--color-foreground);
}

.lb-gsm__num {
  font-size: clamp(30px, 5vw, 46px);
  font-weight: 700;
  line-height: 1;
}

.lb-gsm__unit {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0.7;
}

.lb-gsm__panel {
  display: none;
}

.lb-gsm__panel.is-active {
  display: block;
}

.lb-gsm__name {
  font-size: clamp(20px, 3vw, 28px);
  text-transform: uppercase;
  margin: 0 0 12px;
}

.lb-gsm__desc {
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.78);
  margin: 0 0 20px;
  max-width: 48ch;
}

.lb-gsm__link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "GSM Weight Selector",
  "tag": "section",
  "class": "lb-gsm-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "02 / Fabric system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE DIFFERENCE IS IN THE WEIGHT."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>GSM measures fabric weight in grams per square metre. Higher weight changes structure, drape, and the physical presence of the garment.</p>"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links jump here, e.g. weight",
      "default": "weight"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "weight",
      "name": "Weight tier",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "GSM number",
          "default": "300"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Tier name",
          "default": "Substantial everyday weight"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Everyday wear with real body and drape, without heat or bulk."
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Explore link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link label",
          "default": "Explore this weight"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "GSM Weight Selector",
      "blocks": [
        { "type": "weight", "settings": { "number": "300", "name": "Substantial everyday weight" } },
        { "type": "weight", "settings": { "number": "380", "name": "Stronger structure" } },
        { "type": "weight", "settings": { "number": "400", "name": "Heavyweight presence" } },
        { "type": "weight", "settings": { "number": "460", "name": "Maximum weight" } }
      ]
    }
  ]
}
{% endschema %}

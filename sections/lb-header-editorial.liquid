{% comment %}
  lb-header-editorial.liquid
  LEGENDARY BRANDING — Complete Redesign
  Editorial header / navbar matching the preview site design.
  Features:
    - Fixed header with scroll blur effect
    - LB wordmark logo (Bebas Neue)
    - Nav links from menu
    - Search icon
    - Cart icon with count
    - Optional countdown pill (drop timer)
    - Mobile drawer menu
    - Transparent on hero, opaque on scroll
{% endcomment %}

{%- liquid
  assign menu = linklists[section.settings.menu] | default: linklists.main-menu
  assign show_search = section.settings.show_search | default: true
  assign show_countdown = section.settings.show_countdown | default: false
  assign countdown_target = section.settings.countdown_datetime | default: ''
-%}

{%- style -%}
  .lb-header-editorial {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: all 0.3s var(--lb-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .lb-header-editorial.is-scrolled {
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .lb-header-editorial__inner {
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .lb-header-editorial__left {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .lb-header-editorial__hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 24px;
  }

  .lb-header-editorial__hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: all 0.3s;
  }

  .lb-header-editorial__logo {
    font-family: var(--font-heading--family, 'Bebas Neue'), Impact, sans-serif;
    font-size: 1.75rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: inherit;
    font-weight: 400;
  }

  .lb-header-editorial__logo-accent {
    opacity: 0.4;
  }

  .lb-header-editorial__nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lb-header-editorial__nav a {
    color: inherit;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .lb-header-editorial__nav a:hover {
    opacity: 1;
  }

  .lb-header-editorial__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lb-header-editorial__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .lb-header-editorial__pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: lb-header-pulse 2s ease-in-out infinite;
  }

  @keyframes lb-header-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(1.3); }
  }

  .lb-header-editorial__cart {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    opacity: 0.7;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lb-header-editorial__cart:hover {
    opacity: 1;
  }

  .lb-header-editorial__cart-count {
    padding: 2px 6px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.625rem;
  }

  /* Mobile drawer */
  .lb-header-editorial__drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s var(--lb-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .lb-header-editorial__drawer-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lb-header-editorial__drawer-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: min(360px, 85vw);
    height: 100%;
    background: #000;
    color: #fff;
    border-right: 1px solid rgba(255,255,255,0.1);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.4s var(--lb-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .lb-header-editorial__drawer-overlay.is-open .lb-header-editorial__drawer-panel {
    transform: translateX(0);
  }

  .lb-header-editorial__drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .lb-header-editorial__drawer-logo {
    font-family: var(--font-heading--family, 'Bebas Neue'), Impact, sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: #fff;
  }

  .lb-header-editorial__drawer-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.5rem;
  }

  .lb-header-editorial__drawer-nav {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.25rem;
  }

  .lb-header-editorial__drawer-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    font-family: var(--font-heading--family, 'Bebas Neue'), Impact, sans-serif;
    font-size: 2rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    opacity: 0;
    transform: translateX(-20px);
    animation: lb-drawer-link-in 0.5s var(--lb-ease-out, cubic-bezier(0.16,1,0.3,1)) forwards;
  }

  .lb-header-editorial__drawer-overlay.is-open .lb-header-editorial__drawer-link {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes lb-drawer-link-in {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .lb-header-editorial__drawer-link-num {
    font-family: 'IBM Plex Sans Condensed', 'Helvetica Neue', Arial, sans-serif;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    opacity: 0.4;
  }

  .lb-header-editorial__drawer-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lb-header-editorial__drawer-countdown {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
    color: #fff;
  }

  .lb-header-editorial__drawer-countdown strong {
    font-variant-numeric: tabular-nums;
    opacity: 1;
    color: #fff;
  }

  .lb-header-editorial__drawer-socials {
    display: flex;
    gap: 1.25rem;
  }

  .lb-header-editorial__drawer-socials a {
    color: #fff;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .lb-header-editorial__drawer-socials a:hover {
    opacity: 1;
  }

  @media screen and (max-width: 900px) {
    .lb-header-editorial__nav {
      display: none;
    }
    .lb-header-editorial__hamburger {
      display: flex;
    }
    .lb-header-editorial__pill {
      display: none;
    }
  }

  @media screen and (max-width: 500px) {
    .lb-header-editorial__inner {
      padding: 1rem;
    }
    .lb-header-editorial__cart {
      font-size: 0;
      gap: 0;
    }
    .lb-header-editorial__cart::after {
      content: "🛒";
      font-size: 1rem;
    }
  }
{%- endstyle -%}

<header class="lb-header-editorial color-scheme-5" {{ block.shopify_attributes }} id="lb-editorial-header">
  <div class="lb-header-editorial__inner">
    <div class="lb-header-editorial__left">
      <!-- Mobile hamburger -->
      <button
        type="button"
        class="lb-header-editorial__hamburger"
        id="lb-editorial-hamburger"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <a href="{{ routes.root_url }}" class="lb-header-editorial__logo">
        L<span class="lb-header-editorial__logo-accent">B</span>
      </a>

      <nav class="lb-header-editorial__nav">
        {% for link in menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    </div>

    <div class="lb-header-editorial__right">
      {% if show_countdown and countdown_target != blank %}
        <span class="lb-header-editorial__pill">
          <span class="lb-header-editorial__pill-dot"></span>
          <span id="lb-editorial-countdown">DROP SOON</span>
        </span>
      {% endif %}

      {% if show_search %}
        <a href="{{ routes.search_url }}" class="lb-header-editorial__cart" aria-label="Search">
          🔍
        </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="lb-header-editorial__cart">
        Cart<span class="lb-header-editorial__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="lb-header-editorial__drawer-overlay" id="lb-editorial-drawer">
    <div class="lb-header-editorial__drawer-panel" role="dialog" aria-modal="true">
      <div class="lb-header-editorial__drawer-header">
        <span class="lb-header-editorial__drawer-logo">LEGENDARY</span>
        <button
          type="button"
          class="lb-header-editorial__drawer-close"
          id="lb-editorial-drawer-close"
          aria-label="Close menu"
        >
          ✕
        </button>
      </div>
      <nav class="lb-header-editorial__drawer-nav">
        {% for link in menu.links %}
          <a href="{{ link.url }}" class="lb-header-editorial__drawer-link" style="animation-delay: {{ forloop.index | minus: 1 | times: 60 | plus: 100 }}ms">
            <span class="lb-header-editorial__drawer-link-num">{{ forloop.index | string | pad_left: 2, '0' }}</span>
            {{ link.title }}
          </a>
        {% endfor %}
      </nav>
      <div class="lb-header-editorial__drawer-footer">
        {% if show_countdown and countdown_target != blank %}
          <div class="lb-header-editorial__drawer-countdown">
            <span class="lb-header-editorial__pill-dot"></span>
            <span>NEXT DROP IN <strong id="lb-editorial-countdown-mobile">--:--:--</strong></span>
          </div>
        {% endif %}
        <div class="lb-header-editorial__drawer-socials">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}">IG</a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}">TT</a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}">YT</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (function() {
    var header = document.getElementById('lb-editorial-header');
    var hamburger = document.getElementById('lb-editorial-hamburger');
    var drawer = document.getElementById('lb-editorial-drawer');
    var drawerClose = document.getElementById('lb-editorial-drawer-close');

    // Scroll effect
    function onScroll() {
      if (window.scrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Drawer toggle
    if (hamburger && drawer) {
      hamburger.addEventListener('click', function() {
        drawer.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
      drawerClose.addEventListener('click', function() {
        drawer.classList.remove('is-open');
        document.body.style.overflow = '';
      });
      drawer.addEventListener('click', function(e) {
        if (e.target === drawer) {
          drawer.classList.remove('is-open');
          document.body.style.overflow = '';
        }
      });
    }

    // Countdown timer
    var targetDate = {{ countdown_target | json }};
    var countdownEl = document.getElementById('lb-editorial-countdown');
    var countdownMobileEl = document.getElementById('lb-editorial-countdown-mobile');

    if (targetDate && countdownEl) {
      var target = new Date(targetDate).getTime();
      function pad(n) { return (n < 10 ? '0' : '') + n; }
      function tick() {
        var diff = target - Date.now();
        if (diff <= 0) {
          if (countdownEl) countdownEl.textContent = 'LIVE NOW';
          if (countdownMobileEl) countdownMobileEl.textContent = 'LIVE NOW';
          return;
        }
        var h = Math.floor(diff / 3600000);
        var m = Math.floor((diff % 3600000) / 60000);
        var s = Math.floor((diff % 60000) / 1000);
        var time = pad(h) + ':' + pad(m) + ':' + pad(s);
        if (countdownEl) countdownEl.textContent = time;
        if (countdownMobileEl) countdownMobileEl.textContent = time;
      }
      tick();
      setInterval(tick, 1000);
    }
  })();
</script>

{% schema %}
{
  "name": "Header (Editorial)",
  "tag": "header",
  "class": "lb-header-editorial",
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Elements"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Drop countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown pill",
      "default": false
    },
    {
      "type": "text",
      "id": "countdown_datetime",
      "label": "Countdown target (ISO datetime)",
      "info": "e.g. 2026-09-01T12:00:00-05:00"
    },
    {
      "type": "header",
      "content": "Social links (mobile drawer)"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ]
}
{% endschema %}

{%- if section.blocks.size > 0 -%}
<section class="lb-lookbook color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank -%}
    <div class="lb-lookbook__header page-width">
      <p class="lb-lookbook__eyebrow">{{ section.settings.eyebrow | default: 'Lookbook' }}</p>
      <h2 class="lb-lookbook__heading lb-display-md">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  <div class="lb-lookbook__grid lb-lookbook__grid--{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      <div class="lb-lookbook__cell lb-lookbook__cell--{{ forloop.index }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="lb-lookbook__link">{%- endif -%}

          <div class="lb-lookbook__media-wrap">
            <img
              src="{{ block.settings.image | image_url: width: 800, format: 'webp'}}"
              srcset="{{ block.settings.image | image_url: width: 400, format: 'webp'}} 400w, {{ block.settings.image | image_url: width: 800, format: 'webp'}} 800w, {{ block.settings.image | image_url: width: 1200, format: 'webp'}} 1200w"
              sizes="(max-width: 749px) 100vw, 50vw"
              alt="{{ block.settings.image.alt | default: block.settings.overlay_text | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              class="lb-lookbook__img"
            >
            {%- if block.settings.overlay_text != blank -%}
              <div class="lb-lookbook__overlay" aria-hidden="true">
                <span class="lb-lookbook__overlay-text">{{ block.settings.overlay_text }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lb-lookbook {
  overflow: hidden;
}

.lb-lookbook__header {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--lb-sp-xl, 48px) var(--lb-sp-md, 20px) var(--lb-sp-lg, 32px);
}

.lb-lookbook__eyebrow {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #C9A84C;
  margin: 0 0 8px;
}

.lb-lookbook__heading {
  margin: 0;
}

.lb-lookbook__grid {
  display: grid;
  gap: 4px;
}

.lb-lookbook__grid--1 { grid-template-columns: 1fr; }
.lb-lookbook__grid--2 { grid-template-columns: repeat(2, 1fr); }
.lb-lookbook__grid--3 { grid-template-columns: 2fr 1fr; }
.lb-lookbook__grid--4 {
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto auto;
}
.lb-lookbook__grid--4 .lb-lookbook__cell--1 {
  grid-column: 1 / 2;
  grid-row: 1 / 3;
}
.lb-lookbook__grid--5 {
  grid-template-columns: repeat(3, 1fr);
}
.lb-lookbook__grid--5 .lb-lookbook__cell--1 {
  grid-column: 1 / 3;
}
.lb-lookbook__grid--6 {
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: auto auto;
}
.lb-lookbook__grid--6 .lb-lookbook__cell--1,
.lb-lookbook__grid--6 .lb-lookbook__cell--4 {
  grid-column: span 2;
}

@media (max-width: 749px) {
  .lb-lookbook__grid--3,
  .lb-lookbook__grid--4,
  .lb-lookbook__grid--5,
  .lb-lookbook__grid--6 {
    grid-template-columns: repeat(2, 1fr);
  }
  .lb-lookbook__cell--1 { grid-column: 1 / -1 !important; grid-row: auto !important; }
}

@media (max-width: 499px) {
  .lb-lookbook__grid { grid-template-columns: 1fr !important; }
  .lb-lookbook__cell { grid-column: auto !important; grid-row: auto !important; }
}

.lb-lookbook__link {
  display: block;
  text-decoration: none;
}

.lb-lookbook__media-wrap {
  position: relative;
  overflow: hidden;
  line-height: 0;
}

.lb-lookbook__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 480ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

@media (hover: hover) {
  .lb-lookbook__media-wrap:hover .lb-lookbook__img {
    transform: scale(1.04);
  }
  .lb-lookbook__media-wrap:hover .lb-lookbook__overlay {
    opacity: 1;
  }
}

.lb-lookbook__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 50%);
  display: flex;
  align-items: flex-end;
  padding: 20px 18px;
  opacity: 0;
  transition: opacity 280ms ease;
}

.lb-lookbook__overlay-text {
  font-family: 'Bebas Neue', 'Arial Black', sans-serif;
  font-size: clamp(18px, 2.5vw, 28px);
  color: #F5F5F0;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  line-height: 1;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "lb-lookbook-section",
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay text (on hover)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SS26 COLLECTION"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}

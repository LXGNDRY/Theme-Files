<section class="lb-col-editorial color-{{ section.settings.color_scheme }}">
  {%- if section.settings.bg_image != blank -%}
    <div class="lb-col-editorial__bg" aria-hidden="true">
      <img
        src="{{ section.settings.bg_image | image_url: width: 1800 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 900 }} 900w, {{ section.settings.bg_image | image_url: width: 1400 }} 1400w, {{ section.settings.bg_image | image_url: width: 1800 }} 1800w"
        sizes="100vw"
        alt=""
        width="{{ section.settings.bg_image.width }}"
        height="{{ section.settings.bg_image.height }}"
        loading="eager"
        class="lb-col-editorial__bg-img"
      >
    </div>
  {%- endif -%}

  <div class="lb-col-editorial__inner page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="lb-col-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.headline != blank -%}
      <h1 class="lb-col-editorial__headline lb-display-2xl">{{ section.settings.headline }}</h1>
    {%- endif -%}
    {%- if section.settings.descriptor != blank -%}
      <p class="lb-col-editorial__descriptor"><em>{{ section.settings.descriptor }}</em></p>
    {%- endif -%}
    <hr class="lb-rule" aria-hidden="true">
  </div>
</section>

{% stylesheet %}
.lb-col-editorial {
  position: relative;
  overflow: hidden;
  min-height: 320px;
  display: flex;
  align-items: flex-end;
  padding-bottom: 0;
}

.lb-col-editorial__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.lb-col-editorial__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.lb-col-editorial__bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.2) 60%, transparent 100%);
}

.lb-col-editorial__inner {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--lb-sp-2xl, 80px) var(--lb-sp-md, 20px) var(--lb-sp-lg, 32px);
  width: 100%;
}

.lb-col-editorial__eyebrow {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #C9A84C;
  margin: 0 0 12px;
}

.lb-col-editorial__headline {
  text-transform: uppercase;
  margin: 0 0 12px;
  line-height: 0.88;
  letter-spacing: -0.01em;
}

.lb-col-editorial__descriptor {
  font-size: 15px;
  line-height: 1.5;
  color: rgba(var(--color-foreground-rgb, 245,245,240), 0.65);
  margin: 0 0 24px;
  max-width: 520px;
}

.lb-rule {
  border: none;
  border-top: 1px solid #C9A84C;
  margin: 0;
  opacity: 0.4;
}

@media (max-width: 749px) {
  .lb-col-editorial {
    min-height: 220px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Editorial Header",
  "tag": "section",
  "class": "lb-col-editorial-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Marque Légendaire"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "LUXURY STREETWEAR"
    },
    {
      "type": "text",
      "id": "descriptor",
      "label": "Italic descriptor",
      "default": "235GSM+ tees and 380–460GSM hoodies — made for the ones who know the difference."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Collection Editorial Header"
    }
  ]
}
{% endschema %}

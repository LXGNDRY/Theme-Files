{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-5'
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show | default: 4
  assign anchor = section.settings.anchor | handle
-%}
<section class="lb-egrid color-{{ scheme }}"{% if anchor != blank %} id="{{ anchor }}"{% endif %}>
  <div class="lb-egrid__inner">
    <header class="lb-egrid__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lb-egrid__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lb-egrid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if col != blank -%}
        <a class="lb-egrid__all" href="{{ col.url }}">
          {{ section.settings.link_label | default: 'Explore the full collection' }}
          <span aria-hidden="true">&#8599;</span>
        </a>
      {%- endif -%}
    </header>

    {%- if col != blank and col.products.size > 0 -%}
      <div class="lb-egrid__grid">
        {%- for product in col.products limit: limit -%}
          <article class="lb-egrid__card">
            <a class="lb-egrid__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_image -%}
                <img
                  class="lb-egrid__img"
                  src="{{ product.featured_image | image_url: width: 800, format: 'webp' }}"
                  srcset="{{ product.featured_image | image_url: width: 500, format: 'webp' }} 500w, {{ product.featured_image | image_url: width: 800, format: 'webp' }} 800w, {{ product.featured_image | image_url: width: 1100, format: 'webp' }} 1100w"
                  sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="800"
                  height="800"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if section.settings.ribbon_text != blank -%}
                <span class="lb-egrid__ribbon">{{ section.settings.ribbon_text }}</span>
              {%- endif -%}
              <span class="lb-egrid__explore">Explore the piece <b>+</b></span>
            </a>
            <div class="lb-egrid__meta">
              {%- if product.vendor != blank -%}
                <span class="lb-egrid__brand">{{ product.vendor }}</span>
              {%- endif -%}
              <a class="lb-egrid__name" href="{{ product.url }}">{{ product.title }}</a>
              <span class="lb-egrid__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="lb-egrid__price-sale">{{ product.price | money }}</span>
                  <s class="lb-egrid__price-was">{{ product.compare_at_price | money }}</s>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </span>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.disclaimer != blank -%}
        <p class="lb-egrid__note">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="lb-egrid__empty">Select a collection for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lb-egrid {
  padding: var(--lb-sp-2xl, 80px) 0;
  background: var(--color-background);
  color: var(--color-foreground);
}

.lb-egrid__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 22px);
}

.lb-egrid__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin: 0 0 40px;
}

.lb-egrid__eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
  margin: 0 0 12px;
}

.lb-egrid__heading {
  font-size: clamp(28px, 5vw, 56px);
  line-height: 1.0;
  text-transform: uppercase;
  margin: 0;
}

.lb-egrid__all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
  white-space: nowrap;
}

.lb-egrid__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

@media (min-width: 750px) {
  .lb-egrid__grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
}

.lb-egrid__card {
  display: flex;
  flex-direction: column;
}

.lb-egrid__media {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
  background: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.06);
}

.lb-egrid__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.lb-egrid__media:hover .lb-egrid__img {
  transform: scale(1.04);
}

.lb-egrid__ribbon {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 6px 10px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: var(--color-foreground);
  color: var(--color-background);
  border-radius: 2px;
}

.lb-egrid__explore {
  position: absolute;
  left: 12px;
  bottom: 12px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: rgba(8, 9, 7, 0.72);
  color: #fff;
  border-radius: 2px;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.lb-egrid__media:hover .lb-egrid__explore,
.lb-egrid__media:focus-visible .lb-egrid__explore {
  opacity: 1;
  transform: translateY(0);
}

.lb-egrid__meta {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 16px 2px 0;
}

.lb-egrid__brand {
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.5);
}

.lb-egrid__name {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.25;
  color: inherit;
  text-decoration: none;
}

.lb-egrid__name:hover {
  text-decoration: underline;
}

.lb-egrid__price {
  font-size: 14px;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.82);
}

.lb-egrid__price-was {
  margin-left: 8px;
  opacity: 0.55;
}

.lb-egrid__note,
.lb-egrid__empty {
  font-size: 12px;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.5);
  margin: 28px 0 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Product Grid",
  "tag": "section",
  "class": "lb-egrid-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "01 / The curated rotation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND YOUR NEXT STAPLE."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Card ribbon text",
      "info": "Leave blank for no ribbon.",
      "default": "BOGO 50%"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View-all link label",
      "default": "Explore the full collection"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets links jump here, e.g. edit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Editorial Product Grid"
    }
  ]
}
{% endschema %}

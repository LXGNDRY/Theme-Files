  "tag": "section",
  "class": "lb-brand-story-section",
  "settings": [
    {
      "type": "header",
      "content": "Section index"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Index label (left)",
      "default": "04 / THE BRAND"
    },
    {
      "type": "text",
      "id": "index_meta",
      "label": "Index meta (right)",
      "default": "EST. 2024"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",

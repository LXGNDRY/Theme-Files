{%- if section.settings.image != blank or section.settings.heading != blank -%}
<section class="lb-brand-story color-{{ section.settings.color_scheme }}">
  <div class="lb-brand-story__inner lb-brand-story__inner--{{ section.settings.image_side }}">
    {%- if section.settings.image != blank -%}
      <div class="lb-brand-story__media">
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 749px) 100vw, 50vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          class="lb-brand-story__img"
        >
      </div>
    {%- endif -%}

    <div class="lb-brand-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-brand-story__heading lb-display-xl">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lb-brand-story__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <a href="{{ section.settings.button_url }}" class="lb-brand-story__cta lb-btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lb-brand-story {
  overflow: hidden;
}

.lb-brand-story__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 560px;
}

.lb-brand-story__inner--right {
  direction: rtl;
}

.lb-brand-story__inner--right > * {
  direction: ltr;
}

.lb-brand-story__media {
  position: relative;
  overflow: hidden;
  line-height: 0;
}

.lb-brand-story__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.lb-brand-story__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: var(--lb-sp-2xl, 80px) var(--lb-sp-xl, 48px);
}

.lb-brand-story__eyebrow {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #C9A84C;
  margin: 0 0 16px;
}

.lb-brand-story__heading {
  margin: 0 0 24px;
  text-transform: uppercase;
  line-height: 0.92;
}

.lb-brand-story__body {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(var(--color-foreground-rgb, 255,255,255), 0.75);
  margin: 0 0 32px;
  max-width: 460px;
}

.lb-brand-story__body p {
  margin: 0 0 1em;
}

.lb-brand-story__body p:last-child {
  margin-bottom: 0;
}

.lb-brand-story__cta {
  align-self: flex-start;
}

@media (max-width: 899px) {
  .lb-brand-story__inner,
  .lb-brand-story__inner--right {
    grid-template-columns: 1fr;
    direction: ltr;
    min-height: auto;
  }

  .lb-brand-story__media {
    height: 60vw;
    max-height: 480px;
  }

  .lb-brand-story__content {
    padding: var(--lb-sp-xl, 48px) var(--lb-sp-md, 20px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "lb-brand-story-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "QUALITY OVER QUANTITY"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>We build for the ones who know the difference. 235GSM+ tees. 380–460GSM hoodies. Every garment DTG printed and built to outlast.</p><p>Legendary Branding isn't a brand — it's a standard.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "OUR PROCESS"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}

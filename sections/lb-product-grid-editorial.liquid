{% comment %}
  lb-product-grid-editorial.liquid
  LEGENDARY BRANDING — Complete Redesign
  Editorial product grid that renders lb-card-editorial cards.
  Features:
    - Blueprint grid markers
    - Index numbering (Piece 01/12)
    - Section index header (01 / LATEST DROP)
    - Massive display heading
    - Featured collection picker (works on homepage and collection pages)
    - Category filter bar
    - Sort dropdown
    - Works on collection, search, homepage, and via dynamic sources
{% endcomment %}

{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign show_index = section.settings.show_index | default: true
  assign show_price = section.settings.show_price | default: true
  assign grid_gap = section.settings.grid_gap | default: 1.5
  assign index_label = section.settings.index_label | default: '01 / LATEST DROP'
  assign heading = section.settings.heading | default: 'DROP SEVEN'

  # Determine products source: featured collection setting or current collection
  assign source_collection = nil
  if section.settings.collection != blank
    assign source_collection = collections[section.settings.collection]
  elsif collection != blank and collection.products_count > 0
    assign source_collection = collection
  endif
-%}

{%- style -%}
  .lb-product-grid-editorial {
    padding: var(--lb-section-padding) 1.5rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .lb-product-grid-editorial__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    gap: 2rem;
  }

  .lb-product-grid-editorial__heading {
    font-family: var(--font-heading--family, 'Bebas Neue'), Impact, sans-serif;
    font-size: var(--lb-display-2);
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0;
    max-width: 10ch;
  }

  /* Filter bar */
  .lb-product-grid-editorial__filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    border-top-color: rgba(0,0,0,0.08);
    border-bottom-color: rgba(0,0,0,0.08);
    padding: 0.75rem 0;
  }

  .color-scheme-5 .lb-product-grid-editorial__filters,
  .color-scheme-4 .lb-product-grid-editorial__filters {
    border-top-color: rgba(255,255,255,0.08);
    border-bottom-color: rgba(255,255,255,0.08);
  }

  .lb-product-grid-editorial__filter-list {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .lb-product-grid-editorial__filter-btn {
    background: none;
    border: none;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0;
    opacity: 0.5;
    color: inherit;
    transition: opacity var(--lb-duration-fast) var(--lb-ease-out);
  }

  .lb-product-grid-editorial__filter-btn:hover {
    opacity: 1;
  }

  .lb-product-grid-editorial__filter-btn.is-active {
    opacity: 1;
    font-weight: 600;
  }

  .lb-product-grid-editorial__sort {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lb-product-grid-editorial__sort-select {
    background: none;
    border: none;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    color: inherit;
  }

  .lb-product-grid-editorial__grid {
    display: grid;
    grid-template-columns: repeat({{ columns_mobile }}, 1fr);
    gap: {{ grid_gap }}rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lb-product-grid-editorial__item {
    position: relative;
  }

  /* Blueprint crosshair on each grid cell */
  .lb-product-grid-editorial__item::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 14px;
    height: 14px;
    border-right: 1px solid currentColor;
    border-top: 1px solid currentColor;
    opacity: 0.15;
    pointer-events: none;
    z-index: 2;
  }

  @media screen and (min-width: 750px) {
    .lb-product-grid-editorial__grid {
      grid-template-columns: repeat({{ columns_desktop }}, 1fr);
    }
  }

  @media screen and (max-width: 1100px) {
    .lb-product-grid-editorial__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .lb-product-grid-editorial {
      padding: 4rem 1rem;
    }
    .lb-product-grid-editorial__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .lb-product-grid-editorial__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .lb-product-grid-editorial__filters {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .lb-product-grid-editorial__filter-list {
      gap: 1rem;
    }
    .lb-product-grid-editorial__sort {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* Empty state */
  .lb-product-grid-editorial__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--lb-space-xl) 0;
    opacity: 0.6;
  }

  /* Load more */
  .lb-product-grid-editorial__more {
    display: flex;
    justify-content: center;
    margin-top: var(--lb-space-lg);
  }

  .lb-product-grid-editorial__more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 2rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-size: var(--lb-label);
    letter-spacing: var(--lb-label-spacing);
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--lb-duration-base) var(--lb-ease-out);
  }

  .lb-product-grid-editorial__more-btn:hover {
    background: currentColor;
    color: var(--color-background, #fff);
  }
{%- endstyle -%}

<section class="lb-product-grid-editorial color-{{ section.settings.color_scheme }}">
  <!-- Section index -->
  <div class="lb-section-index">
    <span>{{ index_label }}</span>
    <span>{{ section.settings.index_meta | default: source_collection.products_count | default: '' | append: ' PIECES' }}</span>
  </div>

  <!-- Heading -->
  {%- if heading != blank -%}
    <div class="lb-product-grid-editorial__header">
      <h2 class="lb-product-grid-editorial__heading">{{ heading }}</h2>
    </div>
  {%- endif -%}

  <!-- Filter bar -->
  <div class="lb-product-grid-editorial__filters">
    <div class="lb-product-grid-editorial__filter-list">
      <button class="lb-product-grid-editorial__filter-btn is-active">ALL</button>
      {%- if section.settings.filter_1 != blank -%}
        <button class="lb-product-grid-editorial__filter-btn">{{ section.settings.filter_1 }}</button>
      {%- endif -%}
      {%- if section.settings.filter_2 != blank -%}
        <button class="lb-product-grid-editorial__filter-btn">{{ section.settings.filter_2 }}</button>
      {%- endif -%}
      {%- if section.settings.filter_3 != blank -%}
        <button class="lb-product-grid-editorial__filter-btn">{{ section.settings.filter_3 }}</button>
      {%- endif -%}
      {%- if section.settings.filter_4 != blank -%}
        <button class="lb-product-grid-editorial__filter-btn">{{ section.settings.filter_4 }}</button>
      {%- endif -%}
    </div>
    <div class="lb-product-grid-editorial__sort">
      <span class="lb-label">SORT BY</span>
      {%- assign sort_by = collection.sort_by | default: 'manual' -%}
      <select class="lb-product-grid-editorial__sort-select" onchange="window.location.href=this.value;">
        <option value="{{ collection.sort_by_url | default: '#' }}" {% if sort_by == 'manual' %}selected{% endif %}>Featured</option>
        <option value="{{ collection.sort_by_url | default: '#' }}" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
        <option value="{{ collection.sort_by_url | default: '#' }}" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
        <option value="{{ collection.sort_by_url | default: '#' }}" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
      </select>
    </div>
  </div>

  {%- if source_collection != blank and source_collection.products.size > 0 -%}
    {%- paginate source_collection.products by products_per_page -%}
      <ul class="lb-product-grid-editorial__grid" role="list">
        {%- for product in source_collection.products -%}
          <li class="lb-product-grid-editorial__item">
            {% render 'lb-card-editorial',
              product: product,
              index: forloop.index,
              total: source_collection.products.size,
              show_index: show_index,
              show_price: show_price
            %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <div class="lb-product-grid-editorial__more">
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="lb-product-grid-editorial__more-btn">
              Load more <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="lb-product-grid-editorial__empty">
      <p>No products found. Select a collection in the section settings.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product Grid (Editorial)",
  "tag": "section",
  "class": "lb-product-grid-editorial",
  "settings": [
    {
      "type": "header",
      "content": "Section index"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Index label (left)",
      "default": "01 / LATEST DROP"
    },
    {
      "type": "text",
      "id": "index_meta",
      "label": "Index meta (right)",
      "default": "12 PIECES"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DROP SEVEN"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection",
      "info": "Select a collection to display products. If blank, uses the current collection context."
    },
    {
      "type": "header",
      "content": "Filter bar"
    },
    {
      "type": "text",
      "id": "filter_1",
      "label": "Filter 1",
      "default": "HOODIES"
    },
    {
      "type": "text",
      "id": "filter_2",
      "label": "Filter 2",
      "default": "TEES"
    },
    {
      "type": "text",
      "id": "filter_3",
      "label": "Filter 3",
      "default": "PANTS"
    },
    {
      "type": "text",
      "id": "filter_4",
      "label": "Filter 4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap (rem)",
      "min": 0.5,
      "max": 3,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "header",
      "content": "Card options"
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Show index numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "Color scheme"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Light (White)" },
        { "value": "scheme-2", "label": "Light Alt" },
        { "value": "scheme-4", "label": "Dark Grey" },
        { "value": "scheme-5", "label": "True Black" }
      ],
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product Grid (Editorial)",
      "category": "Collection",
      "settings": {
        "columns_desktop": 4,
        "columns_mobile": 2,
        "products_per_page": 12,
        "show_index": true,
        "show_price": true,
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}

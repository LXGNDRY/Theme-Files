{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-5'
-%}
<section class="lb-ereviews color-{{ scheme }}">
  <div class="lb-ereviews__inner">
    <header class="lb-ereviews__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-ereviews__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-ereviews__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="lb-ereviews__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="lb-ereviews__app">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="lb-ereviews__empty">Add your Judge.me reviews block to this section in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lb-ereviews {
  padding: var(--lb-sp-2xl, 80px) 0;
  background: var(--color-background);
  color: var(--color-foreground);
}

.lb-ereviews__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 22px);
}

.lb-ereviews__head {
  text-align: center;
  margin: 0 0 44px;
}

.lb-ereviews__eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.55);
  margin: 0 0 14px;
}

.lb-ereviews__heading {
  font-size: clamp(28px, 5vw, 56px);
  line-height: 1.02;
  text-transform: uppercase;
  margin: 0 0 14px;
}

.lb-ereviews__sub {
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.72);
  max-width: 54ch;
  margin: 0 auto;
}

.lb-ereviews__empty {
  text-align: center;
  color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.5);
}

/* Keep the Judge.me mount from reserving a large empty block while it loads. */
.lb-ereviews__app,
.lb-ereviews__app > div,
.lb-ereviews__app .jdgm-carousel-wrapper,
.lb-ereviews__app .jdgm-carousel,
.lb-ereviews .jdgm-horizon-widget:has(.jdgm-review-widget) {
  min-height: 0 !important;
  height: auto !important;
}

/* Judge.me overrides to match the editorial theme */
.lb-ereviews .jdgm-rev,
.lb-ereviews .jdgm-rev-widg,
.lb-ereviews .jdgm-carousel {
  background: transparent !important;
  color: var(--color-foreground) !important;
}

.lb-ereviews .jdgm-rev__body,
.lb-ereviews .jdgm-rev__title,
.lb-ereviews .jdgm-rev__author,
.lb-ereviews .jdgm-rev__timestamp,
.lb-ereviews .jdgm-carousel-item__body,
.lb-ereviews .jdgm-carousel-item__reviewer-name {
  color: var(--color-foreground) !important;
}

.lb-ereviews .jdgm-rev__timestamp,
.lb-ereviews .jdgm-rev__product-link {
  opacity: 0.6;
}

.lb-ereviews .jdgm-carousel-item,
.lb-ereviews .jdgm-rev {
  border-color: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.16) !important;
  border-radius: 8px;
}

.lb-ereviews .jdgm-carousel-wrapper .flickity-button,
.lb-ereviews .jdgm-carousel__arrow {
  background: rgba(var(--color-foreground-rgb, 238, 238, 231), 0.12) !important;
  color: var(--color-foreground) !important;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Reviews",
  "tag": "section",
  "class": "lb-ereviews-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "From the community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT THEY'RE SAYING."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Editorial Reviews"
    }
  ]
}
{% endschema %}

{% comment %}
  lb-hero-editorial.liquid
  LEGENDARY BRANDING — Complete Redesign
  Editorial drop hero inspired by Fuel (Westhill Studio) brutalism-lite aesthetic.
  Features:
    - Massive display headline (drop name / collection name) layered behind model image
    - Blueprint grid markers at corners
    - Index / archive numbering (DROP 07 / 12 PIECES / © YEAR)
    - Live drop status pill (countdown, live, sold out)
    - Subhead + CTA
    - Full-bleed with color scheme control
    - Mobile: type stacks, image stays prominent
  Schema: configurable text, image, drop status, CTA, color scheme
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'DROP 07'
  assign subheading = section.settings.subheading
  assign cta_label = section.settings.cta_label | default: 'Shop the drop'
  assign cta_url = section.settings.cta_url
  assign drop_status = section.settings.drop_status
  assign drop_countdown = section.settings.drop_countdown_datetime
  assign image = section.settings.image
  assign image_position = section.settings.image_position | default: 'center'
  assign index_label = section.settings.index_label | default: 'DROP 07'
  assign meta_label = section.settings.meta_label | default: '12 PIECES'
  assign text_align = section.settings.text_align | default: 'left'
  assign image_opacity = section.settings.image_opacity | default: 85
  assign heading_size = section.settings.heading_size | default: 'medium'
-%}

{%- style -%}
  .lb-hero-editorial {
    position: relative;
    min-height: min(90vh, 900px);
    display: flex;
    align-items: flex-end;
    padding: var(--lb-section-padding) var(--lb-space-md);
    padding-bottom: var(--lb-space-lg);
    overflow: hidden;
  }

  .lb-hero-editorial__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 70% 30%, rgba(80,80,80,0.5) 0%, transparent 60%),
      linear-gradient(180deg, #000 0%, #0a0a0a 100%);
  }

  .lb-hero-editorial__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ image_opacity | divided_by: 100.0 }};
    filter: grayscale(0);
  }

  .lb-hero-editorial__bg-scrim {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  .lb-hero-editorial__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  /* Blueprint grid markers */
  .lb-hero-editorial__blueprint {
    position: absolute;
    inset: var(--lb-space-md);
    border: 1px solid currentColor;
    border-color: rgba(255,255,255,0.12);
    z-index: 1;
    pointer-events: none;
  }

  .color-scheme-1 .lb-hero-editorial__blueprint,
  .color-scheme-3 .lb-hero-editorial__blueprint {
    border-color: rgba(0,0,0,0.1);
  }

  /* Corner crosshairs */
  .lb-hero-editorial::before,
  .lb-hero-editorial::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 24px;
    border: 1px solid currentColor;
    opacity: 0.2;
    z-index: 3;
    pointer-events: none;
  }

  .lb-hero-editorial::before {
    top: calc(var(--lb-space-md) + 16px);
    left: calc(var(--lb-space-md) + 16px);
    border-right: none;
    border-bottom: none;
  }

  .lb-hero-editorial::after {
    bottom: calc(var(--lb-space-md) + 16px);
    right: calc(var(--lb-space-md) + 16px);
    border-left: none;
    border-top: none;
  }

  /* Top meta row */
  .lb-hero-editorial__meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--lb-label);
    letter-spacing: var(--lb-label-spacing);
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: auto;
    padding-bottom: var(--lb-space-lg);
  }

  .lb-hero-editorial__index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .lb-hero-editorial__index::before {
    content: '';
    width: 20px;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }

  /* Heading — massive layered type */
  .lb-hero-editorial__heading {
    font-size: var(--lb-display-1);
    line-height: 0.82;
    letter-spacing: -0.03em;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0;
    margin-bottom: var(--lb-space-sm);
    position: relative;
    z-index: 2;
  }

  .lb-hero-editorial__heading--size-small {
    font-size: var(--lb-display-2);
  }

  .lb-hero-editorial__heading--size-large {
    font-size: clamp(6rem, 22vw, 22rem);
    line-height: 0.78;
  }

  .lb-hero-editorial__heading-row {
    display: block;
  }

  .lb-hero-editorial__heading-row--accent {
    font-style: italic;
    font-weight: 400;
    opacity: 0.15;
  }

  /* Model image (foreground, overlaps heading) */
  .lb-hero-editorial__model {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    pointer-events: none;
    width: min(42vw, 480px);
    height: 75vh;
  }

  .lb-hero-editorial__model img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 20px 60px rgba(0,0,0,0.5));
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }

  /* Subtext + CTA row */
  .lb-hero-editorial__content-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 4rem;
    margin-top: var(--lb-space-md);
    position: relative;
    z-index: 2;
  }

  .lb-hero-editorial__subhead {
    max-width: 28ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.7;
    margin-bottom: 1rem;
  }

  .lb-hero-editorial__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 1rem 0;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
    width: fit-content;
    transition: all var(--lb-duration-base) var(--lb-ease-out);
  }

  .lb-hero-editorial__cta-arrow {
    transition: transform var(--lb-duration-base) var(--lb-ease-out);
    font-size: 1rem;
  }

  .lb-hero-editorial__cta:hover .lb-hero-editorial__cta-arrow {
    transform: translateX(6px);
  }

  /* Bottom meta row */
  .lb-hero-editorial__meta-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--lb-label);
    letter-spacing: var(--lb-label-spacing);
    text-transform: uppercase;
    opacity: 0.4;
    margin-top: var(--lb-space-lg);
  }

  /* Drop status pill */
  .lb-drop-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    opacity: 0.9;
  }

  .lb-drop-status__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .lb-drop-status--live .lb-drop-status__dot {
    animation: lb-blink 1.5s ease-in-out infinite;
  }

  .lb-drop-status--countdown .lb-drop-status__dot {
    animation: lb-pulse 2s ease-in-out infinite;
  }

  .lb-drop-status--sold-out {
    opacity: 0.6;
  }

  .lb-drop-status--sold-out .lb-drop-status__dot {
    opacity: 0.4;
  }

  @keyframes lb-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  @keyframes lb-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  /* Text alignment variants */
  .lb-hero-editorial--align-center {
    text-align: center;
  }
  .lb-hero-editorial--align-center .lb-hero-editorial__meta-top {
    justify-content: center;
  }
  .lb-hero-editorial--align-center .lb-hero-editorial__bottom-row {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .lb-hero-editorial--align-center .lb-hero-editorial__model {
    right: 50%;
    transform: translateX(50%);
  }

  .lb-hero-editorial--align-right {
    text-align: right;
  }
  .lb-hero-editorial--align-right .lb-hero-editorial__meta-top {
    flex-direction: row-reverse;
  }
  .lb-hero-editorial--align-right .lb-hero-editorial__model {
    right: auto;
    left: 5%;
  }
  .lb-hero-editorial--align-right .lb-hero-editorial__bottom-row {
    flex-direction: row-reverse;
  }

  /* Mobile */
  @media screen and (max-width: 900px) {
    .lb-hero-editorial__content-bottom {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .lb-hero-editorial__model {
      opacity: 0.3;
      right: -10%;
    }
    .lb-hero-editorial__subhead {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .lb-hero-editorial {
      min-height: 80vh;
      padding: var(--lb-space-md);
      padding-bottom: var(--lb-space-lg);
    }

    .lb-hero-editorial__blueprint {
      inset: var(--lb-space-sm);
    }

    .lb-hero-editorial::before {
      top: calc(var(--lb-space-sm) + 12px);
      left: calc(var(--lb-space-sm) + 12px);
    }
    .lb-hero-editorial::after {
      bottom: calc(var(--lb-space-sm) + 12px);
      right: calc(var(--lb-space-sm) + 12px);
    }

    .lb-hero-editorial__model {
      height: 70%;
      right: 0;
      opacity: 0.3;
    }

    .lb-hero-editorial__content-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--lb-space-md);
    }

    .lb-hero-editorial__cta {
      width: 100%;
      justify-content: flex-start;
    }

    .lb-hero-editorial--align-center .lb-hero-editorial__cta {
      width: auto;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .lb-drop-status__dot {
      animation: none;
    }
  }
{%- endstyle -%}

<section
  class="lb-hero-editorial lb-hero-editorial--align-{{ text_align }} lb-hero-editorial--heading-{{ heading_size }} lb-indexed-section color-{{ section.settings.color_scheme }} lb-blueprint-grid"
  style="color: var(--color-foreground); background: var(--color-background);"
  {{ block.shopify_attributes }}
>
  <!-- Background image + scrim -->
  {% if image != blank %}
    <div class="lb-hero-editorial__background" aria-hidden="true">
      {{
        image
        | image_url: width: 2000
        | image_tag:
          class: 'lb-hero-editorial__bg-image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000',
          alt: ''
      }}
      <div class="lb-hero-editorial__bg-scrim"></div>
    </div>
  {% endif %}

  <!-- Model image (foreground, overlaps heading) -->
  {% if section.settings.model_image != blank %}
    <div class="lb-hero-editorial__model" aria-hidden="true">
      {{
        section.settings.model_image
        | image_url: width: 1200, format: 'webp'
        | image_tag:
          class: '',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '(max-width: 749px) 60vw, 35vw',
          widths: '400, 600, 800, 1200',
          alt: ''
      }}
    </div>
  {% endif %}

  <!-- Content -->
  <div class="lb-hero-editorial__content">
    <!-- Top meta row -->
    <div class="lb-hero-editorial__meta-top">
      <div class="lb-hero-editorial__index">
        <span class="lb-index-number">{{ index_label }}</span>
      </div>

      {% if drop_status != 'none' %}
        <div class="lb-drop-status lb-drop-status--{{ drop_status }}">
          <span class="lb-drop-status__dot"></span>
          {% case drop_status %}
            {% when 'live' %}
              <span>{{ section.settings.live_label | default: 'LIVE NOW' }}</span>
            {% when 'countdown' %}
              <span>{{ section.settings.countdown_label | default: 'DROP SOON' }}</span>
            {% when 'sold-out' %}
              <span>{{ section.settings.sold_out_label | default: 'SOLD OUT' }}</span>
            {% when 'restock' %}
              <span>{{ section.settings.restock_label | default: 'RESTOCKING' }}</span>
          {% endcase %}
        </div>
      {% endif %}
    </div>

    <!-- Heading -->
    <h1 class="lb-hero-editorial__heading">
      {% for line in heading | split: '\n' %}
        <span class="lb-hero-editorial__heading-row">{{ line }}</span>
      {% endfor %}
    </h1>

    <!-- Bottom row: subhead + CTA -->
    <div class="lb-hero-editorial__content-bottom">
      {% if subheading != blank %}
        <div>
          <p class="lb-hero-editorial__subhead">{{ subheading }}</p>
          {% if cta_url != blank and cta_label != blank %}
            <a href="{{ cta_url }}" class="lb-hero-editorial__cta">
              {{ cta_label }}
              <span class="lb-hero-editorial__cta-arrow">→</span>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Bottom meta -->
    <div class="lb-hero-editorial__meta-bottom">
      <span class="lb-label">{{ meta_label }}</span>
      <span class="lb-label">{{ section.settings.meta_bottom_right | default: 'NO RESTOCKS' }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Drop Hero",
  "tag": "section",
  "class": "lb-hero-editorial",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DROP\n07",
      "info": "Use \\n for line breaks"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Massive" }
      ],
      "default": "medium"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Essentials reimagined. 235GSM heavyweight tees. 380-460GSM hoodies. Every garment DTG printed and built to outlast."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Drop status"
    },
    {
      "type": "select",
      "id": "drop_status",
      "label": "Status pill",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "live", "label": "Live now" },
        { "value": "countdown", "label": "Dropping soon" },
        { "value": "sold-out", "label": "Sold out" },
        { "value": "restock", "label": "Restocking" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "live_label",
      "label": "Live label",
      "default": "LIVE NOW"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "DROP SOON"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "restock_label",
      "label": "Restock label",
      "default": "RESTOCKING"
    },
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "model_image",
      "label": "Foreground model image",
      "info": "PNG with transparent background works best for the layered effect"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Background image opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 85,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Labels & index"
    },
    {
      "type": "text",
      "id": "index_label",
      "label": "Index label (top left)",
      "default": "DROP 07"
    },
    {
      "type": "text",
      "id": "meta_label",
      "label": "Meta label (bottom left)",
      "default": "12 PIECES"
    },
    {
      "type": "text",
      "id": "meta_bottom_right",
      "label": "Meta label (bottom right)",
      "default": "NO RESTOCKS"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Color scheme"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Light (White)" },
        { "value": "scheme-2", "label": "Light Alt" },
        { "value": "scheme-4", "label": "Dark Grey" },
        { "value": "scheme-5", "label": "True Black" }
      ],
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Editorial Drop Hero",
      "category": "Hero",
      "settings": {
        "heading": "DROP\n07",
        "heading_size": "medium",
        "subheading": "Essentials reimagined. 235GSM heavyweight tees. 380-460GSM hoodies. Every garment DTG printed and built to outlast.",
        "cta_label": "Shop the drop",
        "drop_status": "live",
        "index_label": "DROP 07",
        "meta_label": "12 PIECES",
        "color_scheme": "scheme-5"
      }
    }
  ]
}
{% endschema %}

{% comment %}
  lb-veonn-collections.liquid
  VEONN-STYLE COLLECTIONS / CATEGORIES GRID
  3-column grid of category tiles with image overlay + title + CTA.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Shop by Category'
  assign view_all_label = section.settings.view_all_label
  assign view_all_url = section.settings.view_all_url
-%}

{%- style -%}
  .vn-collections {
    padding: var(--vn-section-padding, 8rem) 0;
    background: var(--vn-bg, #fff);
  }

  .vn-collections__inner {
    max-width: var(--vn-page-width, 1440px);
    margin: 0 auto;
    padding: 0 var(--vn-page-padding, 2rem);
  }

  .vn-collections__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    gap: 2rem;
  }

  .vn-collections__heading {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: var(--vn-h2, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-collections__view-all {
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vn-ink, #0A0A0A);
    text-decoration: none;
    border-bottom: 1px solid var(--vn-ink, #0A0A0A);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: opacity var(--vn-dur-fast, 200ms);
  }

  .vn-collections__view-all:hover {
    opacity: 0.5;
  }

  .vn-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
  }

  .vn-collection-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: #fff;
    overflow: hidden;
    aspect-ratio: 3/4;
  }

  .vn-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--vn-dur-slow, 600ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-collection-card:hover .vn-collection-card__image {
    transform: scale(1.05);
  }

  .vn-collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.7) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    transition: background var(--vn-dur-base, 400ms);
  }

  .vn-collection-card:hover .vn-collection-card__overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
  }

  .vn-collection-card__title {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    color: #fff;
    line-height: 1.1;
  }

  .vn-collection-card__cta {
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.8);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all var(--vn-dur-fast, 200ms);
  }

  .vn-collection-card:hover .vn-collection-card__cta {
    color: #fff;
    gap: 0.75rem;
  }

  .vn-collection-card__cta::after {
    content: '→';
  }

  @media screen and (max-width: 900px) {
    .vn-collections__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 600px) {
    .vn-collections__head {
      margin-bottom: 2rem;
    }
    .vn-collections__heading {
      font-size: 1.5rem;
    }
    .vn-collections__grid {
      grid-template-columns: 1fr;
    }
    .vn-collection-card {
      aspect-ratio: 4/3;
    }
  }
{%- endstyle -%}

<section class="vn-section vn-collections">
  <div class="vn-collections__inner">
    <div class="vn-collections__head">
      <h2 class="vn-collections__heading">{{ heading }}</h2>
      {% if view_all_url != blank %}
        <a href="{{ view_all_url }}" class="vn-collections__view-all">{{ view_all_label }} →</a>
      {% endif %}
    </div>

    <div class="vn-collections__grid">
      {% for block in section.blocks %}
        {% assign col_img = block.settings.image %}
        {% assign col_title = block.settings.title | default: 'Collection ' | append: forloop.index %}
        {% assign col_url = block.settings.link | default: '#' %}

        <a href="{{ col_url }}" class="vn-collection-card">
          {% if col_img != blank %}
            {{
              col_img
              | image_url: width: 800
              | image_tag:
                class: 'vn-collection-card__image',
                loading: 'lazy',
                sizes: '(max-width: 768px) 100vw, 33vw',
                widths: '400, 600, 800, 1200',
                alt: col_title
            }}
          {% else %}
            <div class="vn-collection-card__image" style="background: var(--vn-ink-8, #EDEDED);"></div>
          {% endif %}
          <div class="vn-collection-card__overlay">
            <h3 class="vn-collection-card__title">{{ col_title }}</h3>
            <span class="vn-collection-card__cta">Shop now</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veonn Collections",
  "tag": "section",
  "class": "vn-collections-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Collection title",
          "default": "Outerwear"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veonn Collections",
      "category": "Veonn",
      "blocks": [
        { "type": "collection", "settings": { "title": "Outerwear" } },
        { "type": "collection", "settings": { "title": "Knitwear" } },
        { "type": "collection", "settings": { "title": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}

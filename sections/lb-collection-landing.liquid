{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-5'
  assign collection_description = collection.description | strip_html | strip
-%}

<section class="lb-collection-landing color-{{ scheme }}">
  <div class="lb-collection-landing__inner">
    <p class="lb-collection-landing__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <div class="lb-collection-landing__title-row">
      <h1 class="lb-collection-landing__title">{{ collection.title | escape }}</h1>
      <p class="lb-collection-landing__count">{{ collection.products_count }} pieces</p>
    </div>
    {%- if collection_description != blank -%}
      <p class="lb-collection-landing__intro">{{ collection_description }}</p>
    {%- endif -%}
    <p class="lb-collection-landing__promise">{{ section.settings.promise | escape }}</p>
  </div>
</section>

{% stylesheet %}
.lb-collection-landing {
  background: #050505;
  color: #fff;
  border-block-end: 1px solid rgba(255, 255, 255, 0.16);
}

.lb-collection-landing__inner {
  width: min(100% - 40px, 1440px);
  margin: 0 auto;
  padding: clamp(40px, 7vw, 88px) 0 clamp(28px, 4vw, 56px);
}

.lb-collection-landing__eyebrow,
.lb-collection-landing__count,
.lb-collection-landing__promise {
  margin: 0;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  line-height: 1.3;
  text-transform: uppercase;
}

.lb-collection-landing__eyebrow,
.lb-collection-landing__promise {
  color: rgba(255, 255, 255, 0.62);
}

.lb-collection-landing__title-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-top: 14px;
}

.lb-collection-landing__title {
  max-width: 16ch;
  margin: 0;
  font-family: 'Bebas Neue', 'Arial Narrow', sans-serif;
  font-size: clamp(3rem, 9vw, 8rem);
  font-weight: 400;
  letter-spacing: 0.015em;
  line-height: 0.86;
  text-transform: uppercase;
}

.lb-collection-landing__count {
  flex: 0 0 auto;
  padding-bottom: 0.45rem;
  color: rgba(255, 255, 255, 0.62);
}

.lb-collection-landing__intro {
  max-width: 62ch;
  margin: 28px 0 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: clamp(1rem, 1.4vw, 1.25rem);
  line-height: 1.55;
}

.lb-collection-landing__promise {
  margin-top: 28px;
}

@media screen and (max-width: 749px) {
  .lb-collection-landing__inner {
    width: min(100% - 32px, 1440px);
    padding-block: 36px 28px;
  }

  .lb-collection-landing__title-row {
    display: block;
    margin-top: 12px;
  }

  .lb-collection-landing__title {
    max-width: none;
    font-size: clamp(2.75rem, 15vw, 4.75rem);
  }

  .lb-collection-landing__count {
    margin-top: 18px;
    padding: 0;
  }

  .lb-collection-landing__intro {
    margin-top: 22px;
  }

  .lb-collection-landing__promise {
    margin-top: 22px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection landing",
  "tag": "section",
  "class": "lb-collection-landing-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Legendary Branding / The Edit"
    },
    {
      "type": "text",
      "id": "promise",
      "label": "Collection promise",
      "default": "Heavyweight pieces. Built to be worn on repeat."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "presets": [
    {
      "name": "Collection landing"
    }
  ]
}
{% endschema %}
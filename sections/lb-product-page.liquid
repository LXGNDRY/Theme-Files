{% comment %}
  lb-product-page.liquid
  LEGENDARY BRANDING — Conversion-Optimised Product Page
  Two-column layout: sticky image gallery left, details panel right.
  Features: variant switching with JS, low-stock urgency, trust strip,
  review stars, size guide accordion, sticky ATC bar, schema-driven content.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image   = current_variant.featured_image | default: product.featured_image
  assign form_id          = 'lb-pdp-form-' | append: product.id
  assign on_sale          = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign show_size_guide  = false
  for option in product.options
    if option == 'Size'
      assign show_size_guide = true
    endif
  endfor
  assign trust_1_label = section.settings.trust_1_label | default: 'Free Returns'
  assign trust_1_sub   = section.settings.trust_1_sub   | default: '30-day hassle-free'
  assign trust_2_label = section.settings.trust_2_label | default: 'Premium Fabric'
  assign trust_2_sub   = section.settings.trust_2_sub   | default: 'Heavyweight quality'
  assign trust_3_label = section.settings.trust_3_label | default: 'Free Shipping'
  assign trust_3_sub   = section.settings.trust_3_sub   | default: 'On orders over $100'
  assign trust_4_label = section.settings.trust_4_label | default: 'Secure Checkout'
  assign trust_4_sub   = section.settings.trust_4_sub   | default: 'SSL encrypted'
-%}

{%- comment -%}CSS is in assets/lb-product-page.css — loaded conditionally in layout/theme.liquid{%- endcomment -%}


{%- comment -%} ── Sticky ATC bar ── {%- endcomment -%}
<div class="lb-pdp-sticky-bar" id="lb-pdp-sticky" role="complementary" aria-label="Quick add to cart">
  <div class="lb-pdp-sticky-bar__info">
    <span class="lb-pdp-sticky-bar__title">{{ product.title }}</span>
    <span class="lb-pdp-sticky-bar__price" id="lb-pdp-sticky-price">
      {{ current_variant.price | money }}
    </span>
  </div>
  <button
    class="lb-pdp-sticky-bar__atc"
    id="lb-pdp-sticky-btn"
    {% unless current_variant.available %}disabled{% endunless %}
  >
    {%- if current_variant.available -%}
      {{ section.settings.atc_label | default: 'Add to Cart' }}
    {%- else -%}
      Sold Out
    {%- endif -%}
  </button>
</div>

{%- comment -%} ── Size guide modal ── {%- endcomment -%}
<div class="lb-pdp-sg-overlay" id="lb-pdp-sg-overlay" role="dialog" aria-modal="true" aria-label="Size guide">
  <div class="lb-pdp-sg-modal">
    <div class="lb-pdp-sg-modal__header">
      <span class="lb-pdp-sg-modal__title">Size Guide</span>
      <button class="lb-pdp-sg-modal__close" id="lb-pdp-sg-close" aria-label="Close size guide">&#215;</button>
    </div>
    {%- if product.metafields.custom.size_guide != blank -%}
      <div>{{ product.metafields.custom.size_guide.value }}</div>
    {%- else -%}
      <p style="font-size:.75rem;color:rgba(10,10,10,.5);margin-bottom:1rem;">All measurements in inches (in) — measure over a flat surface.</p>
      <table class="lb-pdp-sg-table">
        <thead>
          <tr>
            <th>Size</th><th>Chest</th><th>Length</th><th>Sleeve</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>S</td><td>38–40</td><td>27</td><td>33</td></tr>
          <tr><td>M</td><td>40–42</td><td>28</td><td>34</td></tr>
          <tr><td>L</td><td>42–44</td><td>29</td><td>35</td></tr>
          <tr><td>XL</td><td>44–46</td><td>30</td><td>36</td></tr>
          <tr><td>2XL</td><td>46–48</td><td>31</td><td>37</td></tr>
        </tbody>
      </table>
      <p class="lb-pdp-sg-hint">Our pieces run true to size. For an oversized fit, size up one. If you're between sizes, size down for a cleaner shoulder line.</p>
    {%- endif -%}
  </div>
</div>

{%- comment -%} ── Main product section ── {%- endcomment -%}
<section class="lb-pdp" id="lb-pdp-section">

  <div class="lb-pdp__grid">

    {%- comment -%} ════ GALLERY ════ {%- endcomment -%}
    <div class="lb-pdp__gallery" id="lb-pdp-gallery">

      <div class="lb-pdp__gallery-main" id="lb-pdp-gallery-main">
        {%- comment -%} Badge stack {%- endcomment -%}
        <div class="lb-pdp__badge-stack">
          {%- if on_sale -%}
            <span class="lb-pdp__badge lb-pdp__badge--sale">Sale</span>
          {%- endif -%}
          {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 9 -%}
            <span class="lb-pdp__badge lb-pdp__badge--stock">Only {{ current_variant.inventory_quantity }} left</span>
          {%- endif -%}
        </div>

        {%- if featured_image -%}
          <img
            id="lb-pdp-main-img"
            src="{{ featured_image | image_url: width: 1000, format: 'webp' }}"
            srcset="
              {{ featured_image | image_url: width: 600,  format: 'webp' }} 600w,
              {{ featured_image | image_url: width: 900,  format: 'webp' }} 900w,
              {{ featured_image | image_url: width: 1200, format: 'webp' }} 1200w
            "
            sizes="(max-width: 960px) 100vw, 55vw"
            alt="{{ featured_image.alt | escape | default: product.title | escape }}"
            width="{{ featured_image.width }}"
            height="{{ featured_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="lb-pdp__gallery-thumbs">
          {%- for image in product.images limit: 8 -%}
            <button
              class="lb-pdp__thumb{% if image == featured_image %} is-active{% endif %}"
              data-src="{{ image | image_url: width: 1000, format: 'webp' }}"
              data-srcset="{{ image | image_url: width: 600, format: 'webp' }} 600w, {{ image | image_url: width: 900, format: 'webp' }} 900w, {{ image | image_url: width: 1200, format: 'webp' }} 1200w"
              data-alt="{{ image.alt | escape | default: product.title | escape }}"
              aria-label="Product image {{ forloop.index }}"
              type="button"
            >
              <img
                src="{{ image | image_url: width: 220, format: 'webp' }}"
                alt="{{ image.alt | escape | default: product.title | escape }}"
                width="220"
                height="{{ 220 | divided_by: image.aspect_ratio | round }}"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} ════ DETAILS PANEL ════ {%- endcomment -%}
    <div class="lb-pdp__details" id="lb-pdp-details">

      {%- comment -%} Breadcrumb {%- endcomment -%}
      <nav class="lb-pdp__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        {%- if product.collections.first -%}
          &nbsp;/&nbsp;<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        {%- endif -%}
        &nbsp;/&nbsp;{{ product.title | truncate: 40 }}
      </nav>

      {%- comment -%} Title {%- endcomment -%}
      <h1 class="lb-pdp__title">{{ product.title }}</h1>

      {%- comment -%} Reviews row — Judge.me or plain stars from metafield {%- endcomment -%}
      {%- assign review_count  = product.metafields.judgeme.reviews_count.value  | default: product.metafields.reviews.rating_count.value -%}
      {%- assign review_rating = product.metafields.judgeme.avg_rating.value     | default: product.metafields.reviews.rating.value -%}
      {%- if section.settings.show_reviews and review_count != blank and review_count != '0' -%}
        <div class="lb-pdp__reviews-row">
          <div class="lb-pdp__stars" aria-label="{{ review_rating }} out of 5 stars">
            {%- assign full_stars = review_rating | round -%}
            {%- for i in (1..5) -%}
              {%- if i <= full_stars -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </div>
          <span class="lb-pdp__reviews-count" role="button" tabindex="0">
            {{ review_count }} {%- if review_count == '1' -%}review{%- else -%}reviews{%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} Price {%- endcomment -%}
      <div class="lb-pdp__price-row" id="lb-pdp-price-row">
        {%- if on_sale -%}
          {%- assign saved = current_variant.compare_at_price | minus: current_variant.price -%}
          <span class="lb-pdp__price lb-pdp__price--sale" id="lb-pdp-price">{{ current_variant.price | money }}</span>
          <s class="lb-pdp__price--compare" id="lb-pdp-compare">{{ current_variant.compare_at_price | money }}</s>
          <span class="lb-pdp__save-pill">Save {{ saved | money }}</span>
        {%- else -%}
          <span class="lb-pdp__price" id="lb-pdp-price">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Product form {%- endcomment -%}
      {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}

        {%- comment -%} Variant options {%- endcomment -%}
        {%- comment -%}
          Pre-build per-option availability lookup to avoid O(n²) variant loops.
          available_for_opt{N} is a space-separated string of available values
          for option index N. A value is available if at least one variant with
          that value responds to variant.available == true.
        {%- endcomment -%}
        {%- liquid
          assign available_for_opt1 = ''
          assign available_for_opt2 = ''
          assign available_for_opt3 = ''
          for variant in product.variants
            if variant.available
              unless available_for_opt1 contains variant.option1
                assign available_for_opt1 = available_for_opt1 | append: variant.option1 | append: '|'
              endunless
              unless available_for_opt2 contains variant.option2
                assign available_for_opt2 = available_for_opt2 | append: variant.option2 | append: '|'
              endunless
              unless available_for_opt3 contains variant.option3
                assign available_for_opt3 = available_for_opt3 | append: variant.option3 | append: '|'
              endunless
            endif
          endfor
        -%}

        {%- for option in product.options_with_values -%}
          {%- liquid
            assign opt_name_lower = option.name | downcase
            assign is_color = false
            if opt_name_lower == 'color' or opt_name_lower == 'colour'
              assign is_color = true
            endif
            assign opt_key = 'option' | append: forloop.index
            assign selected_val = current_variant[opt_key]
            case forloop.index
              when 1
                assign avail_lookup = available_for_opt1
              when 2
                assign avail_lookup = available_for_opt2
              when 3
                assign avail_lookup = available_for_opt3
            endcase
          -%}
          <div class="lb-pdp__option" data-option-index="{{ forloop.index0 }}">
            <p class="lb-pdp__option-label">
              {{ option.name }}
              <span class="lb-pdp__option-value" id="lb-pdp-opt-val-{{ forloop.index }}">— {{ selected_val }}</span>
            </p>
            <div class="lb-pdp__option-btns">
              {%- for value in option.values -%}
                {%- liquid
                  assign available = false
                  assign val_with_pipe = value | append: '|'
                  if avail_lookup contains val_with_pipe
                    assign available = true
                  endif
                  assign is_selected = false
                  if value == selected_val
                    assign is_selected = true
                  endif
                -%}
                <button
                  type="button"
                  class="lb-pdp__opt-btn{% if is_color %} lb-pdp__opt-btn--swatch{% endif %}{% if is_selected %} is-selected{% endif %}{% unless available %} is-unavailable{% endunless %}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-option-value="{{ value | escape }}"
                  {% unless available %}aria-label="{{ value }} — Sold out" aria-disabled="true"{% else %}aria-label="{{ option.name }}: {{ value }}"{% endunless %}
                  {%- if is_color -%}
                    {%- assign swatch_hex = product.metafields.color_swatches[value].value -%}
                    {%- if swatch_hex != blank -%}
                      style="background-color: {{ swatch_hex | escape }};"
                    {%- else -%}
                      style="background-color: {{ value | downcase | replace: ' ', '-' }};"
                    {%- endif -%}
                  {%- endif -%}
                >
                  {%- unless is_color -%}{{ value }}{%- endunless -%}
                </button>
              {%- endfor -%}
            </div>

            {%- if option.name == 'Size' and show_size_guide -%}
              <button type="button" class="lb-pdp__size-guide-link" id="lb-pdp-sg-trigger">
                Size Guide &amp; Fit
              </button>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- comment -%} Low-stock urgency {%- endcomment -%}
        <div
          class="lb-pdp__low-stock{% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity >= 1 and current_variant.inventory_quantity <= 9 %} is-visible{% endif %}"
          id="lb-pdp-low-stock"
          aria-live="polite"
          aria-atomic="true"
        >
          <span class="lb-pdp__low-stock-dot" aria-hidden="true"></span>
          Only <span id="lb-pdp-stock-count">{{ current_variant.inventory_quantity }}</span> left — order soon
        </div>

        {%- comment -%} Hidden variant id {%- endcomment -%}
        <input type="hidden" name="id" id="lb-pdp-variant-id" value="{{ current_variant.id }}">

        {%- comment -%} Quantity selector {%- endcomment -%}
        {%- if section.settings.show_quantity -%}
          <div class="lb-pdp__qty-row">
            <span class="lb-pdp__qty-label">Qty</span>
            <div class="lb-pdp__qty-ctrl">
              <button type="button" class="lb-pdp__qty-btn" id="lb-pdp-qty-minus" aria-label="Decrease quantity">−</button>
              <input
                type="number"
                name="quantity"
                id="lb-pdp-qty"
                class="lb-pdp__qty-input"
                value="1"
                min="1"
                aria-label="Quantity"
              >
              <button type="button" class="lb-pdp__qty-btn" id="lb-pdp-qty-plus" aria-label="Increase quantity">+</button>
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="quantity" value="1">
        {%- endif -%}

        {%- comment -%} Add to cart zone {%- endcomment -%}
        <div class="lb-pdp__atc-zone">
          <button
            type="submit"
            name="add"
            id="lb-pdp-atc"
            class="lb-pdp__atc"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'Add to Cart' }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
          <p class="lb-pdp__payment-note">
            {%- if section.settings.payment_note != blank -%}
              {{ section.settings.payment_note }}
            {%- else -%}
              Secure checkout &middot; SSL encrypted &middot; All major cards accepted
            {%- endif -%}
          </p>
        </div>

      {%- endform -%}

      {%- comment -%} Trust strip {%- endcomment -%}
      <div class="lb-pdp__trust" role="list" aria-label="Trust signals">
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_1_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_1_sub }}</span>
        </div>
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_2_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_2_sub }}</span>
        </div>
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_3_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_3_sub }}</span>
        </div>
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_4_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_4_sub }}</span>
        </div>
      </div>

      {%- comment -%} Accordions {%- endcomment -%}
      <div class="lb-pdp__accordion-wrap">

        {%- if product.description != blank -%}
          <details class="lb-pdp__accordion" open>
            <summary>
              Description
              <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
            </summary>
            <div class="lb-pdp__accordion-body">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.fabric_details != blank -%}
          <details class="lb-pdp__accordion">
            <summary>
              Fabric &amp; Details
              <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
            </summary>
            <div class="lb-pdp__accordion-body">{{ section.settings.fabric_details }}</div>
          </details>
        {%- endif -%}

        <details class="lb-pdp__accordion">
          <summary>
            Shipping &amp; Returns
            <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
          </summary>
          <div class="lb-pdp__accordion-body">
            {%- if section.settings.shipping_text != blank -%}
              {{ section.settings.shipping_text }}
            {%- else -%}
              <p>We ship worldwide — for free. Orders are processed within 1–2 business days. Domestic delivery takes 5–8 business days; international orders typically arrive within 10–20 business days depending on destination.</p>
              <p>Returns are accepted within 30 days of delivery. Items must be unworn, unwashed, and in original condition. <a href="/pages/return-and-refund-policy" style="color:inherit;">Full return policy →</a></p>
            {%- endif -%}
            <a class="lb-pdp__shipping-calc" href="{{ routes.root_url }}policies/shipping-policy">View shipping policy</a>
          </div>
        </details>

        {%- if section.settings.care_text != blank -%}
          <details class="lb-pdp__accordion">
            <summary>
              Care Instructions
              <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
            </summary>
            <div class="lb-pdp__accordion-body">{{ section.settings.care_text }}</div>
          </details>
        {%- endif -%}

      </div>

    </div>{%- comment -%} end .lb-pdp__details {%- endcomment -%}

  </div>{%- comment -%} end .lb-pdp__grid {%- endcomment -%}

</section>

{%- comment -%} ── Variant JSON for JS ── {%- endcomment -%}
<script id="lb-pdp-variants-json" type="application/json">
  {{ product.variants | json }}
</script>

<script id="lb-pdp-config" type="application/json">
  { "moneyFormat": {{ shop.money_format | json }}, "atcLabel": {{ section.settings.atc_label | default: 'Add to Cart' | json }} }
</script>
<script src="{{ 'lb-product-page.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "LB Product Page",
  "tag": "section",
  "class": "lb-pdp-section",
  "settings": [
    {
      "type": "header",
      "content": "Add to Cart"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "payment_note",
      "label": "Payment note (below button)",
      "default": "Secure checkout · SSL encrypted · All major cards accepted"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": false
    },
    {
      "type": "header",
      "content": "Product Tabs"
    },
    {
      "type": "richtext",
      "id": "fabric_details",
      "label": "Fabric & Details tab content",
      "info": "Leave blank to hide this tab."
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & Returns tab content",
      "info": "Leave blank to use the default text."
    },
    {
      "type": "richtext",
      "id": "care_text",
      "label": "Care Instructions tab content",
      "info": "Leave blank to hide this tab."
    },
    {
      "type": "header",
      "content": "Trust Strip"
    },
    {
      "type": "text",
      "id": "trust_1_label",
      "label": "Trust 1 — label",
      "default": "Free Returns"
    },
    {
      "type": "text",
      "id": "trust_1_sub",
      "label": "Trust 1 — sub-label",
      "default": "30-day hassle-free"
    },
    {
      "type": "text",
      "id": "trust_2_label",
      "label": "Trust 2 — label",
      "default": "Premium Fabric"
    },
    {
      "type": "text",
      "id": "trust_2_sub",
      "label": "Trust 2 — sub-label",
      "default": "Heavyweight quality"
    },
    {
      "type": "text",
      "id": "trust_3_label",
      "label": "Trust 3 — label",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_3_sub",
      "label": "Trust 3 — sub-label",
      "default": "On orders over $100"
    },
    {
      "type": "text",
      "id": "trust_4_label",
      "label": "Trust 4 — label",
      "default": "Secure Checkout"
    },
    {
      "type": "text",
      "id": "trust_4_sub",
      "label": "Trust 4 — sub-label",
      "default": "SSL encrypted"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show review stars (requires Judge.me or reviews metafield)",
      "default": true
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "LB Product Page",
      "category": "Legendary Branding"
    }
  ]
}
{% endschema %}

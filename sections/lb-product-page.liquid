{% comment %}
  lb-product-page.liquid
  LEGENDARY BRANDING — Conversion-Optimised Product Page
  Two-column layout: sticky image gallery left, details panel right.
  Features: variant switching with JS, low-stock urgency, trust strip,
  review stars, size guide accordion, sticky ATC bar, schema-driven content.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image   = current_variant.featured_image | default: product.featured_image
  assign form_id          = 'lb-pdp-form-' | append: product.id
  assign on_sale          = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
  assign show_size_guide  = false
  for option in product.options
    if option == 'Size'
      assign show_size_guide = true
    endif
  endfor
  assign trust_1_label = section.settings.trust_1_label | default: 'Free Returns'
  assign trust_1_sub   = section.settings.trust_1_sub   | default: '30-day hassle-free'
  assign trust_2_label = section.settings.trust_2_label | default: 'Premium Fabric'
  assign trust_2_sub   = section.settings.trust_2_sub   | default: 'Heavyweight quality'
  assign trust_3_label = section.settings.trust_3_label | default: 'Free Shipping'
  assign trust_3_sub   = section.settings.trust_3_sub   | default: 'On orders over $100'
  assign trust_4_label = section.settings.trust_4_label | default: 'Secure Checkout'
  assign trust_4_sub   = section.settings.trust_4_sub   | default: 'SSL encrypted'
-%}

{%- style -%}
/* ============================================================
   LB PRODUCT PAGE — base tokens
   ============================================================ */
.lb-pdp {
  --pdp-max-w: 1360px;
  --pdp-pad-x: clamp(1rem, 4vw, 3rem);
  --pdp-gap: clamp(2rem, 5vw, 5rem);
  --pdp-ink: #0A0A0A;
  --pdp-ink-50: rgba(10,10,10,.5);
  --pdp-ink-15: rgba(10,10,10,.15);
  --pdp-ink-06: rgba(10,10,10,.06);
  --pdp-bg: #fff;
  --pdp-cream: #FAFAF8;
  --pdp-accent: #C9A84C;
  --pdp-radius: 2px;
  --pdp-dur: 220ms;
  --pdp-ease: cubic-bezier(.16,1,.3,1);
  max-width: var(--pdp-max-w);
  margin: 0 auto;
  padding: clamp(1.5rem, 3vw, 2.5rem) var(--pdp-pad-x) clamp(4rem, 8vw, 7rem);
}

/* ============================================================
   GRID
   ============================================================ */
.lb-pdp__grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: var(--pdp-gap);
  align-items: start;
}

/* ============================================================
   GALLERY
   ============================================================ */
.lb-pdp__gallery { display: flex; flex-direction: column; gap: .5rem; }

.lb-pdp__gallery-main {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: var(--pdp-cream);
  cursor: zoom-in;
}

.lb-pdp__gallery-main img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform var(--pdp-dur) var(--pdp-ease);
}

.lb-pdp__gallery-main:hover img { transform: scale(1.035); }

.lb-pdp__badge-stack {
  position: absolute;
  top: 1rem; left: 1rem;
  display: flex; flex-direction: column; gap: .375rem;
  z-index: 2;
}

.lb-pdp__badge {
  display: inline-block;
  padding: .3rem .6rem;
  font-size: .625rem;
  font-weight: 700;
  letter-spacing: .13em;
  text-transform: uppercase;
  line-height: 1;
}
.lb-pdp__badge--sale  { background: var(--pdp-ink); color: var(--pdp-bg); }
.lb-pdp__badge--stock { background: var(--pdp-accent); color: var(--pdp-bg); }

.lb-pdp__gallery-thumbs {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: .375rem;
}

.lb-pdp__thumb {
  aspect-ratio: 1;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  background: var(--pdp-cream);
  transition: border-color var(--pdp-dur);
  padding: 0;
}

.lb-pdp__thumb.is-active,
.lb-pdp__thumb:hover { border-color: var(--pdp-ink); }

.lb-pdp__thumb img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}

/* ============================================================
   DETAILS PANEL
   ============================================================ */
.lb-pdp__details {
  position: sticky;
  top: 6rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* Breadcrumb */
.lb-pdp__breadcrumb {
  font-size: .6875rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--pdp-ink-50);
}
.lb-pdp__breadcrumb a { color: inherit; text-decoration: none; }
.lb-pdp__breadcrumb a:hover { color: var(--pdp-ink); }

/* Title */
.lb-pdp__title {
  font-size: clamp(1.5rem, 3vw, 2.125rem);
  font-weight: 700;
  letter-spacing: -.025em;
  line-height: 1.1;
  margin: 0;
  color: var(--pdp-ink);
}

/* Reviews row */
.lb-pdp__reviews-row {
  display: flex;
  align-items: center;
  gap: .625rem;
}
.lb-pdp__stars {
  display: flex;
  gap: 2px;
  color: var(--pdp-accent);
  font-size: .875rem;
}
.lb-pdp__reviews-count {
  font-size: .75rem;
  color: var(--pdp-ink-50);
  letter-spacing: .04em;
  text-decoration: underline;
  cursor: pointer;
}

/* Price */
.lb-pdp__price-row {
  display: flex;
  align-items: baseline;
  gap: .75rem;
  flex-wrap: wrap;
}
.lb-pdp__price {
  font-size: 1.375rem;
  font-weight: 700;
  color: var(--pdp-ink);
  letter-spacing: -.01em;
}
.lb-pdp__price--sale { color: #B33A2A; }
.lb-pdp__price--compare {
  font-size: 1rem;
  font-weight: 400;
  color: var(--pdp-ink-50);
  text-decoration: line-through;
}
.lb-pdp__save-pill {
  font-size: .625rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  background: #B33A2A;
  color: #fff;
  padding: .25rem .5rem;
  border-radius: 2px;
}

/* Variant options */
.lb-pdp__option { display: flex; flex-direction: column; gap: .5rem; }

.lb-pdp__option-label {
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--pdp-ink);
  display: flex;
  align-items: center;
  gap: .5rem;
}
.lb-pdp__option-value {
  font-weight: 400;
  letter-spacing: 0;
  text-transform: none;
  color: var(--pdp-ink-50);
}

.lb-pdp__option-btns {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem;
}

.lb-pdp__opt-btn {
  min-width: 3rem;
  padding: .6rem 1rem;
  border: 1.5px solid var(--pdp-ink-15);
  background: transparent;
  font-size: .8125rem;
  font-weight: 600;
  letter-spacing: .03em;
  color: var(--pdp-ink);
  cursor: pointer;
  transition: border-color var(--pdp-dur), background var(--pdp-dur), color var(--pdp-dur);
  font-family: inherit;
  border-radius: var(--pdp-radius);
  line-height: 1;
}
.lb-pdp__opt-btn:hover:not(.is-unavailable) {
  border-color: var(--pdp-ink);
}
.lb-pdp__opt-btn.is-selected {
  border-color: var(--pdp-ink);
  background: var(--pdp-ink);
  color: var(--pdp-bg);
}
.lb-pdp__opt-btn.is-unavailable {
  opacity: .3;
  cursor: not-allowed;
  text-decoration: line-through;
}

/* Colour swatches */
.lb-pdp__opt-btn--swatch {
  width: 2.25rem; height: 2.25rem;
  min-width: unset;
  padding: 0;
  border-radius: 50%;
  position: relative;
}
.lb-pdp__opt-btn--swatch.is-selected::after {
  content: '';
  position: absolute;
  inset: -4px;
  border: 2px solid var(--pdp-ink);
  border-radius: 50%;
}

/* Size guide trigger */
.lb-pdp__size-guide-link {
  font-size: .6875rem;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-decoration: underline;
  color: var(--pdp-ink-50);
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
  font-family: inherit;
}
.lb-pdp__size-guide-link:hover { color: var(--pdp-ink); }

/* Quantity selector */
.lb-pdp__qty-row {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.lb-pdp__qty-label {
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--pdp-ink);
  white-space: nowrap;
}
.lb-pdp__qty-ctrl {
  display: flex;
  align-items: center;
  border: 1.5px solid var(--pdp-ink-15);
  border-radius: var(--pdp-radius);
  overflow: hidden;
}
.lb-pdp__qty-btn {
  width: 2.5rem; height: 2.5rem;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.125rem;
  color: var(--pdp-ink);
  display: flex; align-items: center; justify-content: center;
  transition: background var(--pdp-dur);
}
.lb-pdp__qty-btn:hover { background: var(--pdp-ink-06); }
.lb-pdp__qty-input {
  width: 3rem;
  text-align: center;
  border: none;
  border-left: 1.5px solid var(--pdp-ink-15);
  border-right: 1.5px solid var(--pdp-ink-15);
  font-size: .9375rem;
  font-weight: 600;
  color: var(--pdp-ink);
  background: transparent;
  font-family: inherit;
  padding: 0;
  height: 2.5rem;
  -moz-appearance: textfield;
}
.lb-pdp__qty-input::-webkit-outer-spin-button,
.lb-pdp__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; }

/* ATC zone */
.lb-pdp__atc-zone {
  display: flex;
  flex-direction: column;
  gap: .625rem;
}
.lb-pdp__atc {
  width: 100%;
  padding: 1.0625rem 2rem;
  background: var(--pdp-ink);
  color: var(--pdp-bg);
  border: 2px solid var(--pdp-ink);
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background var(--pdp-dur), color var(--pdp-dur);
  font-family: inherit;
  border-radius: var(--pdp-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
}
.lb-pdp__atc:hover:not(:disabled) {
  background: transparent;
  color: var(--pdp-ink);
}
.lb-pdp__atc:disabled {
  opacity: .4;
  cursor: not-allowed;
}

/* Payment icons row */
.lb-pdp__payment-note {
  font-size: .6875rem;
  color: var(--pdp-ink-50);
  text-align: center;
  letter-spacing: .04em;
}

/* Low-stock */
.lb-pdp__low-stock {
  display: none;
  align-items: center;
  gap: .4rem;
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--pdp-accent);
}
.lb-pdp__low-stock.is-visible { display: flex; }
.lb-pdp__low-stock-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--pdp-accent);
  animation: lb-pdp-pulse 1.6s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes lb-pdp-pulse {
  0%,100% { opacity: 1; } 50% { opacity: .35; }
}
@media (prefers-reduced-motion: reduce) { .lb-pdp__low-stock-dot { animation: none; } }

/* Trust strip */
.lb-pdp__trust {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .75rem;
  padding: 1.125rem 0;
  border-top: 1px solid var(--pdp-ink-15);
  border-bottom: 1px solid var(--pdp-ink-15);
}
.lb-pdp__trust-item {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  align-items: flex-start;
}
.lb-pdp__trust-icon {
  margin-bottom: .3rem;
  color: var(--pdp-ink-50);
}
.lb-pdp__trust-label {
  font-size: .625rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--pdp-ink);
  line-height: 1.3;
}
.lb-pdp__trust-sub {
  font-size: .625rem;
  color: var(--pdp-ink-50);
  line-height: 1.4;
}

/* Accordions */
.lb-pdp__accordion-wrap { display: flex; flex-direction: column; }

.lb-pdp__accordion {
  border-top: 1px solid var(--pdp-ink-15);
}
.lb-pdp__accordion:last-child { border-bottom: 1px solid var(--pdp-ink-15); }

.lb-pdp__accordion summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0;
  cursor: pointer;
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--pdp-ink);
  user-select: none;
}
.lb-pdp__accordion summary::-webkit-details-marker { display: none; }

.lb-pdp__acc-icon {
  width: 14px; height: 14px;
  position: relative; flex-shrink: 0;
}
.lb-pdp__acc-icon::before,
.lb-pdp__acc-icon::after {
  content: '';
  position: absolute;
  background: var(--pdp-ink);
  transition: transform var(--pdp-dur), opacity var(--pdp-dur);
}
.lb-pdp__acc-icon::before { width: 100%; height: 1px; top: 50%; left: 0; transform: translateY(-50%); }
.lb-pdp__acc-icon::after  { width: 1px; height: 100%; left: 50%; top: 0; transform: translateX(-50%); }
.lb-pdp__accordion[open] .lb-pdp__acc-icon::after {
  transform: translateX(-50%) scaleY(0);
  opacity: 0;
}

.lb-pdp__accordion-body {
  padding: 0 0 1.25rem;
  font-size: .875rem;
  color: var(--pdp-ink-50);
  line-height: 1.75;
}
.lb-pdp__accordion-body p { margin: 0 0 .75rem; }
.lb-pdp__accordion-body p:last-child { margin-bottom: 0; }
.lb-pdp__accordion-body ul { padding-left: 1.25rem; margin: 0; }
.lb-pdp__accordion-body li { margin-bottom: .25rem; }

/* Shipping calc link */
.lb-pdp__shipping-calc {
  display: inline-block;
  margin-top: .5rem;
  font-size: .6875rem;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-decoration: underline;
  color: var(--pdp-ink-50);
}

/* ============================================================
   STICKY ATC BAR (appears on scroll)
   ============================================================ */
.lb-pdp-sticky-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 200;
  background: var(--pdp-bg);
  border-top: 1px solid var(--pdp-ink-15);
  padding: .875rem var(--pdp-pad-x, 1.5rem);
  display: flex;
  align-items: center;
  gap: 1.5rem;
  transform: translateY(100%);
  transition: transform var(--pdp-dur) var(--pdp-ease);
  box-shadow: 0 -4px 24px rgba(0,0,0,.06);
}
.lb-pdp-sticky-bar.is-visible { transform: translateY(0); }

.lb-pdp-sticky-bar__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: .125rem;
  min-width: 0;
}
.lb-pdp-sticky-bar__title {
  font-size: .875rem;
  font-weight: 700;
  letter-spacing: -.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--pdp-ink);
}
.lb-pdp-sticky-bar__price {
  font-size: .8125rem;
  color: var(--pdp-ink-50);
}
.lb-pdp-sticky-bar__atc {
  flex-shrink: 0;
  padding: .875rem 2rem;
  background: var(--pdp-ink);
  color: var(--pdp-bg);
  border: none;
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  cursor: pointer;
  font-family: inherit;
  border-radius: var(--pdp-radius);
  white-space: nowrap;
  transition: opacity var(--pdp-dur);
}
.lb-pdp-sticky-bar__atc:hover:not(:disabled) { opacity: .8; }
.lb-pdp-sticky-bar__atc:disabled { opacity: .4; cursor: not-allowed; }

/* ============================================================
   SIZE GUIDE MODAL
   ============================================================ */
.lb-pdp-sg-overlay {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(0,0,0,.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--pdp-dur);
}
.lb-pdp-sg-overlay.is-open {
  opacity: 1;
  pointer-events: all;
}
.lb-pdp-sg-modal {
  background: var(--pdp-bg);
  width: 100%;
  max-width: 720px;
  max-height: 85vh;
  overflow-y: auto;
  padding: 2rem;
  transform: translateY(2rem);
  transition: transform var(--pdp-dur) var(--pdp-ease);
  border-radius: 4px 4px 0 0;
}
.lb-pdp-sg-overlay.is-open .lb-pdp-sg-modal { transform: translateY(0); }
.lb-pdp-sg-modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}
.lb-pdp-sg-modal__title {
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.lb-pdp-sg-modal__close {
  background: none; border: none; cursor: pointer;
  font-size: 1.25rem; line-height: 1; color: var(--pdp-ink);
  padding: .25rem;
}
.lb-pdp-sg-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .8125rem;
}
.lb-pdp-sg-table th,
.lb-pdp-sg-table td {
  padding: .625rem .875rem;
  text-align: left;
  border-bottom: 1px solid var(--pdp-ink-15);
}
.lb-pdp-sg-table th {
  font-size: .625rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--pdp-ink-50);
  background: var(--pdp-cream);
}
.lb-pdp-sg-table td { color: var(--pdp-ink); }
.lb-pdp-sg-hint {
  margin-top: .875rem;
  font-size: .75rem;
  color: var(--pdp-ink-50);
  line-height: 1.6;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media screen and (max-width: 960px) {
  .lb-pdp__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .lb-pdp__details { position: static; }
  .lb-pdp__trust { grid-template-columns: repeat(2, 1fr); }
  .lb-pdp__gallery-thumbs { grid-template-columns: repeat(4, 1fr); }
}

@media screen and (max-width: 640px) {
  .lb-pdp__gallery-thumbs { grid-template-columns: repeat(4, 1fr); }
  .lb-pdp__trust { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .lb-pdp-sticky-bar { gap: 1rem; }
  .lb-pdp-sg-modal { padding: 1.5rem; }
}
{%- endstyle -%}

{%- comment -%} ── Sticky ATC bar ── {%- endcomment -%}
<div class="lb-pdp-sticky-bar" id="lb-pdp-sticky" role="complementary" aria-label="Quick add to cart">
  <div class="lb-pdp-sticky-bar__info">
    <span class="lb-pdp-sticky-bar__title">{{ product.title }}</span>
    <span class="lb-pdp-sticky-bar__price" id="lb-pdp-sticky-price">
      {{ current_variant.price | money }}
    </span>
  </div>
  <button
    class="lb-pdp-sticky-bar__atc"
    id="lb-pdp-sticky-btn"
    {% unless current_variant.available %}disabled{% endunless %}
  >
    {%- if current_variant.available -%}
      {{ section.settings.atc_label | default: 'Add to Cart' }}
    {%- else -%}
      Sold Out
    {%- endif -%}
  </button>
</div>

{%- comment -%} ── Size guide modal ── {%- endcomment -%}
<div class="lb-pdp-sg-overlay" id="lb-pdp-sg-overlay" role="dialog" aria-modal="true" aria-label="Size guide">
  <div class="lb-pdp-sg-modal">
    <div class="lb-pdp-sg-modal__header">
      <span class="lb-pdp-sg-modal__title">Size Guide</span>
      <button class="lb-pdp-sg-modal__close" id="lb-pdp-sg-close" aria-label="Close size guide">&#215;</button>
    </div>
    {%- if product.metafields.custom.size_guide != blank -%}
      <div>{{ product.metafields.custom.size_guide.value }}</div>
    {%- else -%}
      <p style="font-size:.75rem;color:rgba(10,10,10,.5);margin-bottom:1rem;">All measurements in inches (in) — measure over a flat surface.</p>
      <table class="lb-pdp-sg-table">
        <thead>
          <tr>
            <th>Size</th><th>Chest</th><th>Length</th><th>Sleeve</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>S</td><td>38–40</td><td>27</td><td>33</td></tr>
          <tr><td>M</td><td>40–42</td><td>28</td><td>34</td></tr>
          <tr><td>L</td><td>42–44</td><td>29</td><td>35</td></tr>
          <tr><td>XL</td><td>44–46</td><td>30</td><td>36</td></tr>
          <tr><td>2XL</td><td>46–48</td><td>31</td><td>37</td></tr>
        </tbody>
      </table>
      <p class="lb-pdp-sg-hint">Our pieces run true to size. For an oversized fit, size up one. If you're between sizes, size down for a cleaner shoulder line.</p>
    {%- endif -%}
  </div>
</div>

{%- comment -%} ── Main product section ── {%- endcomment -%}
<section class="lb-pdp" id="lb-pdp-section">

  <div class="lb-pdp__grid">

    {%- comment -%} ════ GALLERY ════ {%- endcomment -%}
    <div class="lb-pdp__gallery" id="lb-pdp-gallery">

      <div class="lb-pdp__gallery-main" id="lb-pdp-gallery-main">
        {%- comment -%} Badge stack {%- endcomment -%}
        <div class="lb-pdp__badge-stack">
          {%- if on_sale -%}
            <span class="lb-pdp__badge lb-pdp__badge--sale">Sale</span>
          {%- endif -%}
          {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 9 -%}
            <span class="lb-pdp__badge lb-pdp__badge--stock">Only {{ current_variant.inventory_quantity }} left</span>
          {%- endif -%}
        </div>

        {%- if featured_image -%}
          <img
            id="lb-pdp-main-img"
            src="{{ featured_image | image_url: width: 1000, format: 'webp' }}"
            srcset="
              {{ featured_image | image_url: width: 600,  format: 'webp' }} 600w,
              {{ featured_image | image_url: width: 900,  format: 'webp' }} 900w,
              {{ featured_image | image_url: width: 1200, format: 'webp' }} 1200w
            "
            sizes="(max-width: 960px) 100vw, 55vw"
            alt="{{ featured_image.alt | escape | default: product.title | escape }}"
            width="{{ featured_image.width }}"
            height="{{ featured_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="lb-pdp__gallery-thumbs">
          {%- for image in product.images limit: 8 -%}
            <button
              class="lb-pdp__thumb{% if image == featured_image %} is-active{% endif %}"
              data-src="{{ image | image_url: width: 1000, format: 'webp' }}"
              data-srcset="{{ image | image_url: width: 600, format: 'webp' }} 600w, {{ image | image_url: width: 900, format: 'webp' }} 900w, {{ image | image_url: width: 1200, format: 'webp' }} 1200w"
              data-alt="{{ image.alt | escape | default: product.title | escape }}"
              aria-label="Product image {{ forloop.index }}"
              type="button"
            >
              <img
                src="{{ image | image_url: width: 220, format: 'webp' }}"
                alt="{{ image.alt | escape | default: product.title | escape }}"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} ════ DETAILS PANEL ════ {%- endcomment -%}
    <div class="lb-pdp__details" id="lb-pdp-details">

      {%- comment -%} Breadcrumb {%- endcomment -%}
      <nav class="lb-pdp__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        {%- if product.collections.first -%}
          &nbsp;/&nbsp;<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        {%- endif -%}
        &nbsp;/&nbsp;{{ product.title | truncate: 40 }}
      </nav>

      {%- comment -%} Title {%- endcomment -%}
      <h1 class="lb-pdp__title">{{ product.title }}</h1>

      {%- comment -%} Reviews row — Judge.me or plain stars from metafield {%- endcomment -%}
      {%- assign review_count  = product.metafields.judgeme.reviews_count.value  | default: product.metafields.reviews.rating_count.value -%}
      {%- assign review_rating = product.metafields.judgeme.avg_rating.value     | default: product.metafields.reviews.rating.value -%}
      {%- if section.settings.show_reviews and review_count != blank and review_count != '0' -%}
        <div class="lb-pdp__reviews-row">
          <div class="lb-pdp__stars" aria-label="{{ review_rating }} out of 5 stars">
            {%- assign full_stars = review_rating | round -%}
            {%- for i in (1..5) -%}
              {%- if i <= full_stars -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </div>
          <span class="lb-pdp__reviews-count" role="button" tabindex="0">
            {{ review_count }} {{ review_count == '1' | ternary: 'review', 'reviews' }}
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} Price {%- endcomment -%}
      <div class="lb-pdp__price-row" id="lb-pdp-price-row">
        {%- if on_sale -%}
          {%- assign saved = current_variant.compare_at_price | minus: current_variant.price -%}
          <span class="lb-pdp__price lb-pdp__price--sale" id="lb-pdp-price">{{ current_variant.price | money }}</span>
          <s class="lb-pdp__price--compare" id="lb-pdp-compare">{{ current_variant.compare_at_price | money }}</s>
          <span class="lb-pdp__save-pill">Save {{ saved | money }}</span>
        {%- else -%}
          <span class="lb-pdp__price" id="lb-pdp-price">{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Product form {%- endcomment -%}
      {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}

        {%- comment -%} Variant options {%- endcomment -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign opt_name_lower = option.name | downcase
            assign is_color = false
            if opt_name_lower == 'color' or opt_name_lower == 'colour'
              assign is_color = true
            endif
            assign selected_val = current_variant['option' | append: forloop.index]
          -%}
          <div class="lb-pdp__option" data-option-index="{{ forloop.index0 }}">
            <p class="lb-pdp__option-label">
              {{ option.name }}
              <span class="lb-pdp__option-value" id="lb-pdp-opt-val-{{ forloop.index }}">— {{ selected_val }}</span>
            </p>
            <div class="lb-pdp__option-btns">
              {%- for value in option.values -%}
                {%- liquid
                  assign available = false
                  for variant in product.variants
                    if variant['option' | append: forloop.parentloop.index] == value
                      if variant.available
                        assign available = true
                      endif
                    endif
                  endfor
                  assign is_selected = false
                  if value == selected_val
                    assign is_selected = true
                  endif
                -%}
                <button
                  type="button"
                  class="lb-pdp__opt-btn{% if is_color %} lb-pdp__opt-btn--swatch{% endif %}{% if is_selected %} is-selected{% endif %}{% unless available %} is-unavailable{% endunless %}"
                  data-option-index="{{ forloop.parentloop.index0 }}"
                  data-option-value="{{ value | escape }}"
                  {% unless available %}aria-label="{{ value }} — Sold out" aria-disabled="true"{% else %}aria-label="{{ option.name }}: {{ value }}"{% endunless %}
                  {% if is_color %}style="background: {{ value | downcase | replace: ' ', '' }};"{% endif %}
                >
                  {%- unless is_color -%}{{ value }}{%- endunless -%}
                </button>
              {%- endfor -%}
            </div>

            {%- if option.name == 'Size' and show_size_guide -%}
              <button type="button" class="lb-pdp__size-guide-link" id="lb-pdp-sg-trigger">
                Size Guide &amp; Fit
              </button>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- comment -%} Low-stock urgency {%- endcomment -%}
        <div
          class="lb-pdp__low-stock{% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity >= 1 and current_variant.inventory_quantity <= 9 %} is-visible{% endif %}"
          id="lb-pdp-low-stock"
          aria-live="polite"
          aria-atomic="true"
        >
          <span class="lb-pdp__low-stock-dot" aria-hidden="true"></span>
          Only <span id="lb-pdp-stock-count">{{ current_variant.inventory_quantity }}</span> left — order soon
        </div>

        {%- comment -%} Hidden variant id {%- endcomment -%}
        <input type="hidden" name="id" id="lb-pdp-variant-id" value="{{ current_variant.id }}">

        {%- comment -%} Quantity selector {%- endcomment -%}
        {%- if section.settings.show_quantity -%}
          <div class="lb-pdp__qty-row">
            <span class="lb-pdp__qty-label">Qty</span>
            <div class="lb-pdp__qty-ctrl">
              <button type="button" class="lb-pdp__qty-btn" id="lb-pdp-qty-minus" aria-label="Decrease quantity">−</button>
              <input
                type="number"
                name="quantity"
                id="lb-pdp-qty"
                class="lb-pdp__qty-input"
                value="1"
                min="1"
                aria-label="Quantity"
              >
              <button type="button" class="lb-pdp__qty-btn" id="lb-pdp-qty-plus" aria-label="Increase quantity">+</button>
            </div>
          </div>
        {%- else -%}
          <input type="hidden" name="quantity" value="1">
        {%- endif -%}

        {%- comment -%} Add to cart zone {%- endcomment -%}
        <div class="lb-pdp__atc-zone">
          <button
            type="submit"
            name="add"
            id="lb-pdp-atc"
            class="lb-pdp__atc"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'Add to Cart' }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
          <p class="lb-pdp__payment-note">
            {%- if section.settings.payment_note != blank -%}
              {{ section.settings.payment_note }}
            {%- else -%}
              Secure checkout &middot; SSL encrypted &middot; All major cards accepted
            {%- endif -%}
          </p>
        </div>

      {%- endform -%}

      {%- comment -%} Trust strip {%- endcomment -%}
      <div class="lb-pdp__trust" role="list" aria-label="Trust signals">
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_1_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_1_sub }}</span>
        </div>
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_2_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_2_sub }}</span>
        </div>
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_3_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_3_sub }}</span>
        </div>
        <div class="lb-pdp__trust-item" role="listitem">
          <svg class="lb-pdp__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span class="lb-pdp__trust-label">{{ trust_4_label }}</span>
          <span class="lb-pdp__trust-sub">{{ trust_4_sub }}</span>
        </div>
      </div>

      {%- comment -%} Accordions {%- endcomment -%}
      <div class="lb-pdp__accordion-wrap">

        {%- if product.description != blank -%}
          <details class="lb-pdp__accordion" open>
            <summary>
              Description
              <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
            </summary>
            <div class="lb-pdp__accordion-body">{{ product.description }}</div>
          </details>
        {%- endif -%}

        {%- if section.settings.fabric_details != blank -%}
          <details class="lb-pdp__accordion">
            <summary>
              Fabric &amp; Details
              <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
            </summary>
            <div class="lb-pdp__accordion-body">{{ section.settings.fabric_details }}</div>
          </details>
        {%- endif -%}

        <details class="lb-pdp__accordion">
          <summary>
            Shipping &amp; Returns
            <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
          </summary>
          <div class="lb-pdp__accordion-body">
            {%- if section.settings.shipping_text != blank -%}
              {{ section.settings.shipping_text }}
            {%- else -%}
              <p>We ship worldwide — for free. Orders are processed within 1–2 business days. Domestic delivery takes 5–8 business days; international orders typically arrive within 10–20 business days depending on destination.</p>
              <p>Returns are accepted within 30 days of delivery. Items must be unworn, unwashed, and in original condition. <a href="/pages/return-and-refund-policy" style="color:inherit;">Full return policy →</a></p>
            {%- endif -%}
            <a class="lb-pdp__shipping-calc" href="{{ routes.root_url }}policies/shipping-policy">View shipping policy</a>
          </div>
        </details>

        {%- if section.settings.care_text != blank -%}
          <details class="lb-pdp__accordion">
            <summary>
              Care Instructions
              <span class="lb-pdp__acc-icon" aria-hidden="true"></span>
            </summary>
            <div class="lb-pdp__accordion-body">{{ section.settings.care_text }}</div>
          </details>
        {%- endif -%}

      </div>

    </div>{%- comment -%} end .lb-pdp__details {%- endcomment -%}

  </div>{%- comment -%} end .lb-pdp__grid {%- endcomment -%}

</section>

{%- comment -%} ── Variant JSON for JS ── {%- endcomment -%}
<script id="lb-pdp-variants-json" type="application/json">
  {{ product.variants | json }}
</script>

<script>
(function () {
  'use strict';

  /* ── DOM refs ── */
  var gallery      = document.getElementById('lb-pdp-gallery');
  var mainImg      = document.getElementById('lb-pdp-main-img');
  var thumbs       = gallery ? gallery.querySelectorAll('.lb-pdp__thumb') : [];
  var optBtns      = document.querySelectorAll('.lb-pdp__opt-btn');
  var variantInput = document.getElementById('lb-pdp-variant-id');
  var atcBtn       = document.getElementById('lb-pdp-atc');
  var stickyBar    = document.getElementById('lb-pdp-sticky');
  var stickyBtn    = document.getElementById('lb-pdp-sticky-btn');
  var stickyPrice  = document.getElementById('lb-pdp-sticky-price');
  var priceEl      = document.getElementById('lb-pdp-price');
  var compareEl    = document.getElementById('lb-pdp-compare');
  var lowStock     = document.getElementById('lb-pdp-low-stock');
  var stockCount   = document.getElementById('lb-pdp-stock-count');
  var priceRow     = document.getElementById('lb-pdp-price-row');
  var sgOverlay    = document.getElementById('lb-pdp-sg-overlay');
  var sgTrigger    = document.getElementById('lb-pdp-sg-trigger');
  var sgClose      = document.getElementById('lb-pdp-sg-close');
  var qtyInput     = document.getElementById('lb-pdp-qty');
  var qtyMinus     = document.getElementById('lb-pdp-qty-minus');
  var qtyPlus      = document.getElementById('lb-pdp-qty-plus');
  var details      = document.getElementById('lb-pdp-details');

  /* ── Parse variants ── */
  var variantsJson = document.getElementById('lb-pdp-variants-json');
  var variants     = variantsJson ? JSON.parse(variantsJson.textContent) : [];

  /* ── Current selections (0-indexed per option) ── */
  var selections = {};
  optBtns.forEach(function (btn) {
    var idx = btn.dataset.optionIndex;
    if (btn.classList.contains('is-selected')) {
      selections[idx] = btn.dataset.optionValue;
    }
  });

  /* ── Gallery ── */
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      if (mainImg) {
        mainImg.src    = thumb.dataset.src;
        mainImg.srcset = thumb.dataset.srcset || '';
        mainImg.alt    = thumb.dataset.alt || '';
      }
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      thumb.classList.add('is-active');
    });
  });

  /* ── Variant matching ── */
  function findVariant() {
    return variants.find(function (v) {
      return Object.keys(selections).every(function (idx) {
        return v['option' + (parseInt(idx, 10) + 1)] === selections[idx];
      });
    });
  }

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function updateUI(variant) {
    if (!variant) return;

    /* price */
    if (priceEl) {
      priceEl.textContent = formatMoney(variant.price);
      priceEl.classList.toggle('lb-pdp__price--sale', variant.compare_at_price > variant.price);
    }
    if (compareEl) {
      if (variant.compare_at_price > variant.price) {
        compareEl.style.display = '';
        compareEl.textContent   = formatMoney(variant.compare_at_price);
      } else {
        compareEl.style.display = 'none';
      }
    }

    /* variant id + ATC state */
    if (variantInput) variantInput.value = variant.id;
    if (atcBtn) {
      atcBtn.disabled    = !variant.available;
      atcBtn.textContent = variant.available ? atcBtn.dataset.label || '{{ section.settings.atc_label | default: "Add to Cart" }}' : 'Sold Out';
    }
    if (stickyBtn) {
      stickyBtn.disabled    = !variant.available;
      stickyBtn.textContent = variant.available ? '{{ section.settings.atc_label | default: "Add to Cart" }}' : 'Sold Out';
    }

    /* sticky price */
    if (stickyPrice) stickyPrice.textContent = formatMoney(variant.price);

    /* low-stock */
    if (lowStock && stockCount) {
      var qty  = variant.inventory_quantity;
      var show = variant.inventory_management === 'shopify' && qty >= 1 && qty <= 9;
      lowStock.classList.toggle('is-visible', show);
      if (show) stockCount.textContent = qty;
    }

    /* gallery image — switch to variant image if different */
    if (variant.featured_image && mainImg) {
      var src = variant.featured_image.src;
      if (mainImg.src !== src) {
        mainImg.src    = src;
        mainImg.srcset = '';
        thumbs.forEach(function (t) { t.classList.remove('is-active'); });
        thumbs.forEach(function (t) {
          if (t.dataset.src && t.dataset.src.indexOf(src.split('?')[0].split('/').pop()) !== -1) {
            t.classList.add('is-active');
          }
        });
      }
    }

    /* option value label update */
    document.querySelectorAll('[id^="lb-pdp-opt-val-"]').forEach(function (el) {
      var pos = el.id.replace('lb-pdp-opt-val-', '');
      var sel = selections[String(parseInt(pos, 10) - 1)];
      if (sel) el.textContent = '— ' + sel;
    });

    /* fire event for other scripts */
    document.dispatchEvent(new CustomEvent('variant:update', { detail: { variant: variant } }));
  }

  /* ── Option button clicks ── */
  optBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.classList.contains('is-unavailable')) return;
      var idx = btn.dataset.optionIndex;
      var val = btn.dataset.optionValue;
      selections[idx] = val;

      /* update active state for this option group */
      document.querySelectorAll('.lb-pdp__opt-btn[data-option-index="' + idx + '"]').forEach(function (b) {
        b.classList.toggle('is-selected', b.dataset.optionValue === val);
      });

      var v = findVariant();
      if (v) updateUI(v);
    });
  });

  /* ── Quantity controls ── */
  if (qtyMinus && qtyInput) {
    qtyMinus.addEventListener('click', function () {
      var v = parseInt(qtyInput.value, 10) || 1;
      if (v > 1) qtyInput.value = v - 1;
    });
  }
  if (qtyPlus && qtyInput) {
    qtyPlus.addEventListener('click', function () {
      var v = parseInt(qtyInput.value, 10) || 1;
      qtyInput.value = v + 1;
    });
  }

  /* ── Sticky ATC bar — show when ATC scrolls out of view ── */
  if (stickyBar && atcBtn) {
    var obs = new IntersectionObserver(function (entries) {
      stickyBar.classList.toggle('is-visible', !entries[0].isIntersecting);
    }, { threshold: 0 });
    obs.observe(atcBtn);

    stickyBtn.addEventListener('click', function () {
      atcBtn.click();
    });
  }

  /* ── Size guide modal ── */
  if (sgTrigger && sgOverlay) {
    sgTrigger.addEventListener('click', function () {
      sgOverlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    });
  }
  if (sgClose && sgOverlay) {
    sgClose.addEventListener('click', closeModal);
  }
  if (sgOverlay) {
    sgOverlay.addEventListener('click', function (e) {
      if (e.target === sgOverlay) closeModal();
    });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });
  function closeModal() {
    if (sgOverlay) sgOverlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  /* ── Reviews count scroll ── */
  var reviewsCount = document.querySelector('.lb-pdp__reviews-count');
  if (reviewsCount) {
    reviewsCount.addEventListener('click', function () {
      var target = document.querySelector('.jdgm-widget, .shopify-section-product-reviews, #shopify-product-reviews, #lb-judgeme-widget');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

})();
</script>

{% schema %}
{
  "name": "LB Product Page",
  "tag": "section",
  "class": "lb-pdp-section",
  "settings": [
    {
      "type": "header",
      "content": "Add to Cart"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "payment_note",
      "label": "Payment note (below button)",
      "default": "Secure checkout · SSL encrypted · All major cards accepted"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": false
    },
    {
      "type": "header",
      "content": "Product Tabs"
    },
    {
      "type": "richtext",
      "id": "fabric_details",
      "label": "Fabric & Details tab content",
      "info": "Leave blank to hide this tab."
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & Returns tab content",
      "info": "Leave blank to use the default text."
    },
    {
      "type": "richtext",
      "id": "care_text",
      "label": "Care Instructions tab content",
      "info": "Leave blank to hide this tab."
    },
    {
      "type": "header",
      "content": "Trust Strip"
    },
    {
      "type": "text",
      "id": "trust_1_label",
      "label": "Trust 1 — label",
      "default": "Free Returns"
    },
    {
      "type": "text",
      "id": "trust_1_sub",
      "label": "Trust 1 — sub-label",
      "default": "30-day hassle-free"
    },
    {
      "type": "text",
      "id": "trust_2_label",
      "label": "Trust 2 — label",
      "default": "Premium Fabric"
    },
    {
      "type": "text",
      "id": "trust_2_sub",
      "label": "Trust 2 — sub-label",
      "default": "Heavyweight quality"
    },
    {

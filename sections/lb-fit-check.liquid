{%- if section.settings.image != blank and section.blocks.size > 0 -%}
<section class="lb-fit-check color-{{ section.settings.color_scheme }}">
  <div class="lb-fit-check__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="lb-fit-check__header page-width">
        {%- if section.settings.heading != blank -%}
          <h2 class="lb-fit-check__heading lb-display-md">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lb-fit-check__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="lb-fit-check__canvas">
      <img
        src="{{ section.settings.image | image_url: width: 1400, format: 'webp'}}"
        srcset="{{ section.settings.image | image_url: width: 750, format: 'webp'}} 750w, {{ section.settings.image | image_url: width: 1100, format: 'webp'}} 1100w, {{ section.settings.image | image_url: width: 1400, format: 'webp'}} 1400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
        class="lb-fit-check__image"
      >

      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- assign hotspot_product = block.settings.product -%}
          <div
            class="lb-fit-check__hotspot"
            style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
            {{ block.shopify_attributes }}
          >
            <button
              class="lb-fit-check__dot"
              aria-expanded="false"
              aria-label="View {{ hotspot_product.title }}"
            >
              <span class="lb-fit-check__dot-ring" aria-hidden="true"></span>
            </button>
            <div class="lb-fit-check__popup" role="region" aria-label="{{ hotspot_product.title }}">
              <a href="{{ hotspot_product.url }}" class="lb-fit-check__popup-inner">
                {%- if hotspot_product.featured_media -%}
                  <img
                    src="{{ hotspot_product.featured_media.preview_image | image_url: width: 120, format: 'webp'}}"
                    alt="{{ hotspot_product.featured_media.alt | default: hotspot_product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                    class="lb-fit-check__popup-img"
                  >
                {%- endif -%}
                <div class="lb-fit-check__popup-info">
                  {%- if block.settings.label != blank -%}
                    <p class="lb-fit-check__popup-label">{{ block.settings.label }}</p>
                  {%- endif -%}
                  <p class="lb-fit-check__popup-title">{{ hotspot_product.title }}</p>
                  <p class="lb-fit-check__popup-price">{{ hotspot_product.price | money }}</p>
                </div>
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function() {
  var dots = document.querySelectorAll('.lb-fit-check__dot');
  dots.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      dots.forEach(function(d) { d.setAttribute('aria-expanded', 'false'); });
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  });
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.lb-fit-check__hotspot')) {
      dots.forEach(function(d) { d.setAttribute('aria-expanded', 'false'); });
    }
  });
})();
</script>
{%- endif -%}

{% stylesheet %}
.lb-fit-check {
  overflow: hidden;
}

.lb-fit-check__header {
  padding: var(--lb-sp-xl, 48px) var(--lb-sp-md, 20px) var(--lb-sp-lg, 32px);
  max-width: 1200px;
  margin: 0 auto;
}

.lb-fit-check__heading {
  margin: 0 0 8px;
}

.lb-fit-check__sub {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.5);
  margin: 0;
}

.lb-fit-check__canvas {
  position: relative;
  display: block;
  line-height: 0;
}

.lb-fit-check__image {
  width: 100%;
  height: auto;
  display: block;
}

.lb-fit-check__hotspot {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 2;
}

.lb-fit-check__dot {
  position: relative;
  width: 28px;
  height: 28px;
  background: #0A0A0A;
  border: 2px solid #C9A84C;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 180ms ease, background 180ms ease;
  outline: none;
}

.lb-fit-check__dot::after {
  content: '+';
  color: #C9A84C;
  font-size: 16px;
  line-height: 1;
  transition: transform 200ms ease;
}

.lb-fit-check__dot[aria-expanded="true"]::after {
  transform: rotate(45deg);
}

.lb-fit-check__dot-ring {
  position: absolute;
  inset: -6px;
  border: 1.5px solid rgba(201, 168, 76, 0.4);
  border-radius: 50%;
  animation: lb-hotspot-ring 2.4s ease-in-out infinite;
}

@keyframes lb-hotspot-ring {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50%       { transform: scale(1.3); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .lb-fit-check__dot-ring { animation: none; }
}

.lb-fit-check__popup {
  position: absolute;
  bottom: calc(100% + 12px);
  left: 50%;
  transform: translateX(-50%) scale(0.92);
  transform-origin: bottom center;
  background: #0A0A0A;
  border: 1px solid rgba(201,168,76,0.25);
  border-radius: 6px;
  width: 220px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease, transform 180ms ease;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  z-index: 10;
}

.lb-fit-check__dot[aria-expanded="true"] + .lb-fit-check__popup {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) scale(1);
}

.lb-fit-check__popup-inner {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px;
  text-decoration: none;
  color: inherit;
}

.lb-fit-check__popup-img {
  width: 72px;
  height: 72px;
  object-fit: cover;
  border-radius: 4px;
  flex-shrink: 0;
}

.lb-fit-check__popup-info {
  flex: 1;
  min-width: 0;
}

.lb-fit-check__popup-label {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: #C9A84C;
  margin: 0 0 4px;
}

.lb-fit-check__popup-title {
  font-size: 13px;
  font-weight: 600;
  color: #F2F2F2;
  margin: 0 0 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lb-fit-check__popup-price {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 11px;
  color: #C8C8C8;
  margin: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Fit Check",
  "tag": "section",
  "class": "lb-fit-check-section",
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (optional)",
          "placeholder": "e.g. Wearing on top"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position (%)",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position (%)",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE FIT CHECK"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tap the dots to shop the look"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Fit Check"
    }
  ]
}
{% endschema %}

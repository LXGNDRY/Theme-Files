{%- if section.settings.target_date != blank and section.settings.show_section -%}
<section class="lb-countdown color-{{ section.settings.color_scheme }}">
  <div class="lb-countdown__inner page-width">
    {%- if section.settings.heading != blank -%}
      <p class="lb-countdown__eyebrow">{{ section.settings.eyebrow | default: 'Dropping In' }}</p>
      <h2 class="lb-countdown__heading lb-display-lg">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="lb-countdown__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div
      class="lb-countdown__digits"
      data-lb-countdown="{{ section.settings.target_date }}"
      data-lb-countdown-end="{{ section.settings.end_message | escape }}"
    >
      <div class="lb-countdown__unit">
        <span class="lb-countdown__num lb-display-xl" data-cd-d>00</span>
        <span class="lb-countdown__label">Days</span>
      </div>
      <span class="lb-countdown__sep lb-display-xl" aria-hidden="true">:</span>
      <div class="lb-countdown__unit">
        <span class="lb-countdown__num lb-display-xl" data-cd-h>00</span>
        <span class="lb-countdown__label">Hours</span>
      </div>
      <span class="lb-countdown__sep lb-display-xl" aria-hidden="true">:</span>
      <div class="lb-countdown__unit">
        <span class="lb-countdown__num lb-display-xl" data-cd-m>00</span>
        <span class="lb-countdown__label">Minutes</span>
      </div>
      <span class="lb-countdown__sep lb-display-xl" aria-hidden="true">:</span>
      <div class="lb-countdown__unit">
        <span class="lb-countdown__num lb-display-xl" data-cd-s>00</span>
        <span class="lb-countdown__label">Seconds</span>
      </div>
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <a href="{{ section.settings.button_url }}" class="lb-countdown__cta lb-btn">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'lb-countdown.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
.lb-countdown {
  padding: var(--lb-sp-xl, 48px) 0 var(--lb-sp-2xl, 80px);
  text-align: center;
}

.lb-countdown__inner {
  max-width: 960px;
  margin: 0 auto;
  padding-inline: var(--lb-sp-md, 20px);
}

.lb-countdown__eyebrow {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #C9A84C;
  margin: 0 0 12px;
}

.lb-countdown__heading {
  margin: 0 0 8px;
  text-transform: uppercase;
}

.lb-countdown__sub {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 255,255,255), 0.5);
  margin: 0 0 40px;
}

.lb-countdown__digits {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 0;
}

.lb-countdown__unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100px;
}

.lb-countdown__num {
  display: block;
  font-variant-numeric: tabular-nums;
  color: #C9A84C;
  line-height: 1;
  letter-spacing: -0.01em;
}

.lb-countdown__sep {
  color: rgba(201, 168, 76, 0.35);
  line-height: 1;
  padding: 0 4px;
  margin-top: -2px;
}

.lb-countdown__label {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 255,255,255), 0.4);
  margin-top: 8px;
}

.lb-countdown__ended {
  font-family: 'Bebas Neue', 'Arial Black', sans-serif;
  font-size: clamp(24px, 4vw, 48px);
  letter-spacing: 0.06em;
  color: #C9A84C;
  text-transform: uppercase;
  margin: 0;
}

.lb-countdown__cta {
  display: inline-block;
  margin-top: 40px;
}

@media (max-width: 749px) {
  .lb-countdown__unit {
    min-width: 68px;
  }
}

@media (max-width: 479px) {
  .lb-countdown__unit {
    min-width: 52px;
  }
  .lb-countdown__sep {
    padding: 0 2px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown Timer",
  "tag": "section",
  "class": "lb-countdown-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Dropping In"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SS26 DROP 001"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited quantities. No restocks."
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target date & time (ISO 8601)",
      "info": "Format: YYYY-MM-DDTHH:MM:SS e.g. 2026-09-01T12:00:00",
      "default": "2026-09-01T12:00:00"
    },
    {
      "type": "text",
      "id": "end_message",
      "label": "Post-countdown message",
      "default": "THE DROP IS LIVE"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "NOTIFY ME"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer"
    }
  ]
}
{% endschema %}

{% comment %}
  lb-veonn-footer.liquid — synced: complete-redesign
  VEONN-STYLE FOOTER
  Clean minimalist footer: logo, newsletter signup, link columns,
  social links, copyright.
{% endcomment %}

{%- liquid
  assign logo_text = section.settings.logo_text | default: 'VÉON'
  assign newsletter_heading = section.settings.newsletter_heading | default: 'Stay in the loop'
  assign newsletter_subtext = section.settings.newsletter_subtext
  assign copyright = section.settings.copyright_text | default: '© 2025 Véon. All rights reserved.'
-%}

{%- style -%}
  .vn-footer {
    background: var(--vn-bg, #fff);
    color: var(--vn-ink, #0A0A0A);
    padding-top: var(--vn-space-4xl, 8rem);
    border-top: 1px solid var(--vn-ink-8, #EDEDED);
  }

  .vn-footer__inner {
    max-width: var(--vn-page-width, 1440px);
    margin: 0 auto;
    padding: 0 var(--vn-page-padding, 2rem);
  }

  .vn-footer__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .vn-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .vn-footer__logo {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--vn-ink, #0A0A0A);
    text-decoration: none;
  }

  .vn-footer__tagline {
    font-size: var(--vn-body-sm, 0.875rem);
    color: var(--vn-ink-50, #7A7A7A);
    line-height: 1.6;
    max-width: 28ch;
  }

  .vn-footer__socials {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .vn-footer__social-link {
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vn-ink-50, #7A7A7A);
    text-decoration: none;
    transition: color var(--vn-dur-fast, 200ms);
  }

  .vn-footer__social-link:hover {
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-footer__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .vn-footer__col-title {
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vn-ink, #0A0A0A);
    margin: 0 0 0.5rem;
  }

  .vn-footer__col-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .vn-footer__col-link {
    font-size: var(--vn-body-sm, 0.875rem);
    color: var(--vn-ink-50, #7A7A7A);
    text-decoration: none;
    transition: color var(--vn-dur-fast, 200ms);
    line-height: 1.4;
  }

  .vn-footer__col-link:hover {
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-footer__newsletter {
    margin-bottom: 4rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--vn-ink-8, #EDEDED);
    border-bottom: 1px solid var(--vn-ink-8, #EDEDED);
    text-align: center;
  }

  .vn-footer__newsletter-heading {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-footer__newsletter-subtext {
    font-size: var(--vn-body-sm, 0.875rem);
    color: var(--vn-ink-50, #7A7A7A);
    margin: 0 auto 1.5rem;
    max-width: 40ch;
  }

  .vn-footer__newsletter-form {
    display: flex;
    max-width: 420px;
    margin: 0 auto;
    gap: 0;
    border-bottom: 1px solid var(--vn-ink, #0A0A0A);
  }

  .vn-footer__newsletter-input {
    flex: 1;
    padding: 0.875rem 0;
    border: none;
    background: transparent;
    font-size: var(--vn-body-sm, 0.875rem);
    color: var(--vn-ink, #0A0A0A);
    outline: none;
    font-family: inherit;
  }

  .vn-footer__newsletter-input::placeholder {
    color: var(--vn-ink-50, #7A7A7A);
  }

  .vn-footer__newsletter-btn {
    padding: 0.875rem 0;
    background: none;
    border: none;
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vn-ink, #0A0A0A);
    cursor: pointer;
    transition: opacity var(--vn-dur-fast, 200ms);
  }

  .vn-footer__newsletter-btn:hover {
    opacity: 0.6;
  }

  .vn-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .vn-footer__copyright {
    font-size: var(--vn-caption, 0.75rem);
    color: var(--vn-ink-50, #7A7A7A);
  }

  .vn-footer__bottom-links {
    display: flex;
    gap: 2rem;
  }

  .vn-footer__bottom-link {
    font-size: var(--vn-caption, 0.75rem);
    color: var(--vn-ink-50, #7A7A7A);
    text-decoration: none;
    transition: color var(--vn-dur-fast, 200ms);
  }

  .vn-footer__bottom-link:hover {
    color: var(--vn-ink, #0A0A0A);
  }

  @media screen and (max-width: 900px) {
    .vn-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .vn-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 600px) {
    .vn-footer__top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .vn-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .vn-footer__bottom-links {
      gap: 1.25rem;
    }
  }
{%- endstyle -%}

<footer class="vn-section vn-footer">
  <div class="vn-footer__inner">
    <!-- Newsletter -->
    <div class="vn-footer__newsletter">
      <h3 class="vn-footer__newsletter-heading">{{ newsletter_heading }}</h3>
      {% if newsletter_subtext != blank %}
        <p class="vn-footer__newsletter-subtext">{{ newsletter_subtext }}</p>
      {% endif %}
      <form class="vn-footer__newsletter-form" action="{{ routes.newsletter_url }}" method="post">
        <input
          type="email"
          name="contact[email]"
          class="vn-footer__newsletter-input"
          placeholder="Enter your email"
          required
        >
        <button type="submit" class="vn-footer__newsletter-btn">Subscribe →</button>
      </form>
    </div>

    <!-- Link columns -->
    <div class="vn-footer__top">
      <div class="vn-footer__brand">
        <a href="{{ routes.root_url }}" class="vn-footer__logo">{{ logo_text }}</a>
        {% if section.settings.tagline != blank %}
          <p class="vn-footer__tagline">{{ section.settings.tagline }}</p>
        {% endif %}
        <div class="vn-footer__socials">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="vn-footer__social-link">IG</a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" class="vn-footer__social-link">TT</a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" class="vn-footer__social-link">PIN</a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a href="{{ section.settings.youtube_url }}" class="vn-footer__social-link">YT</a>
          {% endif %}
        </div>
      </div>

      {% for i in (1..3) %}
        <div class="vn-footer__col">
          {% assign menu_id = section.settings['footer_menu_' | append: i] %}
          {% assign menu = linklists[menu_id] %}
          <h4 class="vn-footer__col-title">{{ section.settings['footer_title_' | append: i] | default: 'Menu ' | append: i }}</h4>
          <div class="vn-footer__col-links">
            {% if menu != blank %}
              {% for link in menu.links %}
                <a href="{{ link.url }}" class="vn-footer__col-link">{{ link.title }}</a>
              {% endfor %}
            {% else %}
              <span class="vn-footer__col-link" style="opacity: 0.4;">Configure in theme editor</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Bottom bar -->
    <div class="vn-footer__bottom">
      <span class="vn-footer__copyright">{{ copyright }}</span>
      <div class="vn-footer__bottom-links">
        {% if section.settings.privacy_url != blank %}
          <a href="{{ section.settings.privacy_url }}" class="vn-footer__bottom-link">Privacy Policy</a>
        {% endif %}
        {% if section.settings.terms_url != blank %}
          <a href="{{ section.settings.terms_url }}" class="vn-footer__bottom-link">Terms of Service</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>


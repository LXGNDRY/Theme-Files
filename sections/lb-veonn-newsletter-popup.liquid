{% comment %}
  lb-veonn-newsletter-popup.liquid
  VEONN-STYLE NEWSLETTER POPUP
  Clean minimalist modal popup for email signup.
  Triggers after delay, uses cookie to remember dismissal.
{% endcomment %}

{%- liquid
  assign enabled = section.settings.enabled | default: true
  assign delay = section.settings.delay | default: 5
  assign cookie_days = section.settings.cookie_days | default: 7
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading | default: 'Stay in the loop'
  assign body = section.settings.body
  assign discount_teaser = section.settings.discount_teaser
  assign input_placeholder = section.settings.input_placeholder | default: 'Enter your email'
  assign button_label = section.settings.button_label | default: 'Subscribe'
  assign success_message = section.settings.success_message | default: 'Thanks for subscribing!'
  assign disclaimer = section.settings.disclaimer
-%}

{%- if enabled -%}
{%- style -%}
  .vn-newsletter-popup {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .vn-newsletter-popup.is-visible {
    display: flex;
  }

  .vn-newsletter-popup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-newsletter-popup.is-visible .vn-newsletter-popup__overlay {
    opacity: 1;
  }

  .vn-newsletter-popup__modal {
    position: relative;
    background: #fff;
    color: var(--vn-ink, #0A0A0A);
    max-width: 520px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    transition: all var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-newsletter-popup.is-visible .vn-newsletter-popup__modal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .vn-newsletter-popup__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--vn-ink-50, #7A7A7A);
    padding: 0.5rem;
    line-height: 1;
    transition: color var(--vn-dur-fast, 200ms);
  }

  .vn-newsletter-popup__close:hover {
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-newsletter-popup__eyebrow {
    font-size: var(--vn-eyebrow, 0.6875rem);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--vn-ink-50, #7A7A7A);
    margin: 0 0 0.75rem;
  }

  .vn-newsletter-popup__heading {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.75rem;
    color: var(--vn-ink, #0A0A0A);
  }

  .vn-newsletter-popup__body {
    font-size: var(--vn-body-sm, 0.875rem);
    line-height: 1.6;
    color: var(--vn-ink-70, #4A4A4A);
    margin: 0 auto 1.5rem;
    max-width: 36ch;
  }

  .vn-newsletter-popup__discount {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--vn-ink, #0A0A0A);
    margin: 0 0 1.5rem;
    letter-spacing: -0.01em;
  }

  .vn-newsletter-popup__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 360px;
    margin: 0 auto 1rem;
  }

  .vn-newsletter-popup__input {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--vn-ink-15, #D8D8D8);
    background: #fff;
    color: var(--vn-ink, #0A0A0A);
    font-size: var(--vn-body-sm, 0.875rem);
    font-family: inherit;
    transition: border-color var(--vn-dur-fast, 200ms);
    outline: none;
    box-sizing: border-box;
  }

  .vn-newsletter-popup__input:focus {
    border-color: var(--vn-ink, #0A0A0A);
  }

  .vn-newsletter-popup__input::placeholder {
    color: var(--vn-ink-50, #7A7A7A);
  }

  .vn-newsletter-popup__submit {
    width: 100%;
    padding: 0.875rem 2rem;
    background: var(--vn-ink, #0A0A0A);
    color: #fff;
    border: 1px solid var(--vn-ink, #0A0A0A);
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--vn-dur-fast, 200ms);
    font-family: inherit;
  }

  .vn-newsletter-popup__submit:hover {
    opacity: 0.85;
  }

  .vn-newsletter-popup__disclaimer {
    font-size: 0.6875rem;
    color: var(--vn-ink-50, #7A7A7A);
    line-height: 1.5;
    margin: 0;
  }

  .vn-newsletter-popup__success {
    display: none;
    padding: 1rem 0;
  }

  .vn-newsletter-popup.is-success .vn-newsletter-popup__form-wrap {
    display: none;
  }

  .vn-newsletter-popup.is-success .vn-newsletter-popup__success {
    display: block;
  }

  .vn-newsletter-popup__success-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
  }

  .vn-newsletter-popup__success-text {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--vn-ink, #0A0A0A);
    margin: 0;
  }

  @media screen and (max-width: 480px) {
    .vn-newsletter-popup__modal {
      padding: 2rem 1.5rem;
    }
  }
{%- endstyle -%}

<div class="vn-newsletter-popup" id="vn-newsletter-popup" role="dialog" aria-modal="true" aria-label="Newsletter signup">
  <div class="vn-newsletter-popup__overlay" id="vn-newsletter-overlay"></div>
  <div class="vn-newsletter-popup__modal">
    <button class="vn-newsletter-popup__close" id="vn-newsletter-close" type="button" aria-label="Close">✕</button>

    <div class="vn-newsletter-popup__form-wrap">
      {% if eyebrow != blank %}
        <p class="vn-newsletter-popup__eyebrow">{{ eyebrow }}</p>
      {% endif %}

      {% if heading != blank %}
        <h3 class="vn-newsletter-popup__heading">{{ heading }}</h3>
      {% endif %}

      {% if body != blank %}
        <p class="vn-newsletter-popup__body">{{ body }}</p>
      {% endif %}

      {% if discount_teaser != blank %}
        <p class="vn-newsletter-popup__discount">{{ discount_teaser }}</p>
      {% endif %}

      <form
        class="vn-newsletter-popup__form"
        action="{{ routes.newsletter_url }}"
        method="post"
        id="vn-newsletter-form"
        accept-charset="UTF-8"
      >
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter,popup"
        >
        <input
          type="email"
          name="contact[email]"
          class="vn-newsletter-popup__input"
          placeholder="{{ input_placeholder }}"
          required
          id="vn-newsletter-email"
        >
        <button type="submit" class="vn-newsletter-popup__submit">{{ button_label }}</button>
      </form>

      {% if disclaimer != blank %}
        <p class="vn-newsletter-popup__disclaimer">{{ disclaimer }}</p>
      {% endif %}
    </div>

    <div class="vn-newsletter-popup__success">
      <span class="vn-newsletter-popup__success-icon">✓</span>
      <p class="vn-newsletter-popup__success-text">{{ success_message }}</p>
    </div>
  </div>
</div>

<script>
  (function() {
    var popup = document.getElementById('vn-newsletter-popup');
    var overlay = document.getElementById('vn-newsletter-overlay');
    var closeBtn = document.getElementById('vn-newsletter-close');
    var form = document.getElementById('vn-newsletter-form');
    var delay = {{ delay }} * 1000;
    var cookieDays = {{ cookie_days }};
    var cookieName = 'vn_newsletter_shown';

    // Check cookie
    function getCookie(name) {
      var v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
      return v ? v[2] : null;
    }

    function setCookie(name, value, days) {
      var d = new Date();
      d.setTime(d.getTime() + 24 * 60 * 60 * 1000 * days);
      document.cookie = name + '=' + value + ';path=/;expires=' + d.toUTCString();
    }

    function showPopup() {
      popup.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
    }

    function hidePopup() {
      popup.classList.remove('is-visible');
      document.body.style.overflow = '';
      setCookie(cookieName, 'true', cookieDays);
    }

    function showSuccess() {
      popup.classList.add('is-success');
    }

    // Don't show if already dismissed or on cart/checkout
    if (!getCookie(cookieName) && !window.location.pathname.match(/\/(cart|checkout|account)/)) {
      setTimeout(showPopup, delay);
    }

    closeBtn.addEventListener('click', hidePopup);
    overlay.addEventListener('click', hidePopup);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && popup.classList.contains('is-visible')) {
        hidePopup();
      }
    });

    // Form submit (simulated success - form posts to Shopify)
    if (form) {
      form.addEventListener('submit', function(e) {
        // Let the form submit normally but also show success state
        setTimeout(function() {
          showSuccess();
          setCookie(cookieName, 'subscribed', cookieDays * 2);
        }, 500);
      });
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Veonn Newsletter Popup",
  "tag": "section",
  "class": "vn-newsletter-popup-section",
  "settings": [
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Delay before showing (seconds)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "cookie_days",
      "label": "Dismiss for (days)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Early Access"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Subscribe for exclusive drops, early access, and 10% off your first order."
    },
    {
      "type": "text",
      "id": "discount_teaser",
      "label": "Discount teaser"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "No spam. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Veonn Newsletter Popup",
      "category": "Veonn"
    }
  ]
}
{% endschema %}

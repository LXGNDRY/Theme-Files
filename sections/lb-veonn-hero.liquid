{% comment %}
  lb-veonn-hero.liquid
  VEONN-STYLE HERO SECTION
  Full-bleed hero with large image, "Bold Layers, Confident Looks" style headline
  bottom-left overlay + CTA button + slide indicator + thumbnails.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Bold Layers, Confident Looks.'
  assign subheading = section.settings.subheading
  assign cta_label = section.settings.cta_label | default: 'Browse Collection'
  assign cta_url = section.settings.cta_url | default: '/collections/all'
  assign image = section.settings.hero_image
  assign slide_count = section.settings.slide_count | default: 3
  assign current_slide = section.settings.current_slide | default: 1
-%}

{%- style -%}
  .vn-hero {
    position: relative;
    width: 100%;
    min-height: 90vh;
    overflow: hidden;
    background: var(--vn-cream, #FAFAF8);
  }

  .vn-hero__image-wrap {
    position: absolute;
    inset: 0;
  }

  .vn-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .vn-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.5) 100%);
  }

  .vn-hero__content {
    position: relative;
    z-index: 2;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(3rem, 8vw, 8rem) var(--vn-page-padding, 2rem);
    max-width: var(--vn-page-width, 1440px);
    margin: 0 auto;
    color: #fff;
  }

  .vn-hero__text-block {
    max-width: 600px;
  }

  .vn-hero__heading {
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.95;
    margin: 0 0 1.5rem;
    color: #fff;
  }

  .vn-hero__subheading {
    font-size: var(--vn-body, 1rem);
    line-height: 1.6;
    color: rgba(255,255,255,0.8);
    max-width: 42ch;
    margin: 0 0 2rem;
  }

  .vn-hero__bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 3rem;
    gap: 2rem;
  }

  .vn-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 2rem;
    border: 1px solid rgba(255,255,255,0.6);
    color: #fff;
    text-decoration: none;
    font-size: var(--vn-caption, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: all var(--vn-dur-base, 400ms) var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
    background: rgba(255,255,255,0);
  }

  .vn-hero__cta:hover {
    background: #fff;
    color: var(--vn-ink, #0A0A0A);
    border-color: #fff;
  }

  .vn-hero__cta::after {
    content: '→';
    transition: transform var(--vn-dur-fast, 200ms);
  }

  .vn-hero__cta:hover::after {
    transform: translateX(4px);
  }

  .vn-hero__slides {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .vn-hero__slide-nums {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--vn-font-display, 'Inter'), sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    font-variant-numeric: tabular-nums;
  }

  .vn-hero__slide-num--active {
    color: #fff;
    font-size: 1.5rem;
  }

  .vn-hero__slide-progress {
    width: 60px;
    height: 2px;
    background: rgba(255,255,255,0.2);
    position: relative;
    overflow: hidden;
  }

  .vn-hero__slide-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: #fff;
    width: 33%;
    transition: width 0.6s var(--vn-ease-out, cubic-bezier(0.16,1,0.3,1));
  }

  .vn-hero__thumbs {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    flex: 1;
  }

  .vn-hero__thumb {
    width: 60px;
    height: 80px;
    border-radius: var(--vn-radius-md, 4px);
    overflow: hidden;
    opacity: 0.5;
    transition: all var(--vn-dur-base, 400ms);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .vn-hero__thumb.is-active {
    opacity: 1;
    border-color: rgba(255,255,255,0.6);
  }

  .vn-hero__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 768px) {
    .vn-hero, .vn-hero__content {
      min-height: 85vh;
    }
    .vn-hero__bottom-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
    .vn-hero__thumbs {
      justify-content: flex-start;
    }
    .vn-hero__heading {
      font-size: clamp(2rem, 10vw, 3.5rem);
    }
  }
{%- endstyle -%}

<section class="vn-section vn-hero">
  <div class="vn-hero__image-wrap">
    {% if image != blank %}
      {{
        image
        | image_url: width: 2000
        | image_tag:
          class: 'vn-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000',
          alt: ''
      }}
    {% endif %}
    <div class="vn-hero__scrim"></div>
  </div>

  <div class="vn-hero__content">
    <div class="vn-hero__text-block">
      <h1 class="vn-hero__heading">{{ heading }}</h1>
      {% if subheading != blank %}
        <p class="vn-hero__subheading">{{ subheading }}</p>
      {% endif %}
    </div>

    <div class="vn-hero__bottom-row">
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        {% if cta_url != blank and cta_label != blank %}
          <a href="{{ cta_url }}" class="vn-hero__cta">{{ cta_label }}</a>
        {% endif %}
      </div>

      <div class="vn-hero__slides">
        <div class="vn-hero__slide-nums">
          <span class="vn-hero__slide-num vn-hero__slide-num--active">{{ current_slide | string | pad_left: 2, '0' }}</span>
          <span class="vn-hero__slide-progress">
            <span class="vn-hero__slide-progress-bar"></span>
          </span>
          <span>{{ slide_count | string | pad_left: 2, '0' }}</span>
        </div>
      </div>

      <div class="vn-hero__thumbs">
        {% if section.settings.thumb_1 != blank %}
          <div class="vn-hero__thumb is-active">
            {{ section.settings.thumb_1 | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
          </div>
        {% endif %}
        {% if section.settings.thumb_2 != blank %}
          <div class="vn-hero__thumb">
            {{ section.settings.thumb_2 | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
          </div>
        {% endif %}
        {% if section.settings.thumb_3 != blank %}
          <div class="vn-hero__thumb">
            {{ section.settings.thumb_3 | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veonn Hero",
  "tag": "section",
  "class": "vn-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bold Layers, Confident Looks."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Layer up with confidence and style all season."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Browse Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Slide indicator"
    },
    {
      "type": "range",
      "id": "current_slide",
      "label": "Current slide number",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "slide_count",
      "label": "Total slide count",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Thumbnails"
    },
    {
      "type": "image_picker",
      "id": "thumb_1",
      "label": "Thumbnail 1"
    },
    {
      "type": "image_picker",
      "id": "thumb_2",
      "label": "Thumbnail 2"
    },
    {
      "type": "image_picker",
      "id": "thumb_3",
      "label": "Thumbnail 3"
    }
  ],
  "presets": [
    {
      "name": "Veonn Hero",
      "category": "Veonn"
    }
  ]
}
{% endschema %}

{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    align-items: start;
  }

  .ai-editorial-featured-{{ ai_gen_id }} {
    grid-column: span 7;
    position: relative;
  }

  .ai-editorial-featured-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-featured-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-featured-caption-{{ ai_gen_id }} {
    margin-top: {{ block.settings.caption_spacing }}px;
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
    color: {{ block.settings.category_color }};
  }

  .ai-editorial-featured-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
    line-height: 1.1;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-featured-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-meta-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    font-size: {{ block.settings.meta_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: {{ block.settings.meta_color }};
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.sidebar_gap }}px;
  }

  .ai-editorial-sidebar-item-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding-bottom: {{ block.settings.sidebar_gap }}px;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-editorial-sidebar-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ai-editorial-sidebar-image-{{ ai_gen_id }} {
    width: 120px;
    height: 120px;
    object-fit: cover;
  }

  .ai-editorial-sidebar-placeholder-{{ ai_gen_id }} {
    width: 120px;
    height: 120px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-sidebar-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-sidebar-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-editorial-sidebar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_title_size }}px;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-sidebar-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_excerpt_size }}px;
    line-height: 1.5;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-editorial-read-more-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.meta_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    border-bottom: 1px solid {{ block.settings.link_color }};
    transition: opacity 0.2s ease;
  }

  .ai-editorial-read-more-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-editorial-featured-{{ ai_gen_id }},
    .ai-editorial-sidebar-{{ ai_gen_id }} {
      grid-column: span 1;
    }

    .ai-editorial-featured-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_title_size | times: 0.7 }}px;
    }

    .ai-editorial-sidebar-item-{{ ai_gen_id }} {
      grid-template-columns: 100px 1fr;
      gap: 12px;
    }

    .ai-editorial-sidebar-image-{{ ai_gen_id }},
    .ai-editorial-sidebar-placeholder-{{ ai_gen_id }} {
      width: 100px;
      height: 100px;
    }
  }
{% endstyle %}

<div class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <article class="ai-editorial-featured-{{ ai_gen_id }}">
      {% if block.settings.featured_image %}
        <img
          src="{{ block.settings.featured_image | image_url: width: 1400, format: 'webp' }}"
          srcset="{{ block.settings.featured_image | image_url: width: 400, format: 'webp' }} 400w,
                  {{ block.settings.featured_image | image_url: width: 700, format: 'webp' }} 700w,
                  {{ block.settings.featured_image | image_url: width: 1000, format: 'webp' }} 1000w,
                  {{ block.settings.featured_image | image_url: width: 1400, format: 'webp' }} 1400w"
          sizes="(min-width: 990px) 60vw, 100vw"
          alt="{{ block.settings.featured_image.alt | escape }}"
          loading="lazy"
          decoding="async"
          width="{{ block.settings.featured_image.width }}"
          height="{{ block.settings.featured_image.height }}"
          class="ai-editorial-featured-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-editorial-featured-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
            Add a featured image
          </div>
        </div>
      {% endif %}

      <div class="ai-editorial-featured-caption-{{ ai_gen_id }}">
        {% if block.settings.featured_category != blank %}
          <div class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.featured_category }}</div>
        {% endif %}

        {% if block.settings.featured_title != blank %}
          <h2 class="ai-editorial-featured-title-{{ ai_gen_id }}">{{ block.settings.featured_title }}</h2>
        {% endif %}

        {% if block.settings.featured_excerpt != blank %}
          <div class="ai-editorial-featured-excerpt-{{ ai_gen_id }}">{{ block.settings.featured_excerpt }}</div>
        {% endif %}

        <div class="ai-editorial-meta-{{ ai_gen_id }}">
          {% if block.settings.featured_author != blank %}
            <span>{{ block.settings.featured_author }}</span>
          {% endif %}
          {% if block.settings.featured_date != blank %}
            <span>{{ block.settings.featured_date }}</span>
          {% endif %}
        </div>
      </div>
    </article>

    <aside class="ai-editorial-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'sidebar_image_' | append: i
          assign category_key = 'sidebar_category_' | append: i
          assign title_key = 'sidebar_title_' | append: i
          assign excerpt_key = 'sidebar_excerpt_' | append: i
          assign link_key = 'sidebar_link_' | append: i

          assign sidebar_image = block.settings[image_key]
          assign sidebar_category = block.settings[category_key]
          assign sidebar_title = block.settings[title_key]
          assign sidebar_excerpt = block.settings[excerpt_key]
          assign sidebar_link = block.settings[link_key]
        %}

        <article class="ai-editorial-sidebar-item-{{ ai_gen_id }}">
          <div>
            {% if sidebar_image %}
              <img
                src="{{ sidebar_image | image_url: width: 240, format: 'webp' }}"
                srcset="{{ sidebar_image | image_url: width: 120, format: 'webp' }} 120w,
                        {{ sidebar_image | image_url: width: 240, format: 'webp' }} 240w"
                sizes="120px"
                alt="{{ sidebar_image.alt | escape }}"
                loading="lazy"
                decoding="async"
                width="120"
                height="120"
                class="ai-editorial-sidebar-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-editorial-sidebar-placeholder-{{ ai_gen_id }}">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-editorial-sidebar-content-{{ ai_gen_id }}">
            {% if sidebar_category != blank %}
              <div class="ai-editorial-category-{{ ai_gen_id }}">{{ sidebar_category }}</div>
            {% endif %}

            {% if sidebar_title != blank %}
              <h3 class="ai-editorial-sidebar-title-{{ ai_gen_id }}">{{ sidebar_title }}</h3>
            {% endif %}

            {% if sidebar_excerpt != blank %}
              <div class="ai-editorial-sidebar-excerpt-{{ ai_gen_id }}">{{ sidebar_excerpt }}</div>
            {% endif %}

            {% if sidebar_link != blank %}
              <a href="{{ sidebar_link }}" class="ai-editorial-read-more-{{ ai_gen_id }}">Read more</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </aside>
  </div>
</div>


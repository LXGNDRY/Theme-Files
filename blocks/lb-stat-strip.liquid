      "id": "stat_1_number",
      "label": "Value",
      "default": "Premium"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Label",
      "default": "QUALITY FABRICS"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Value",
      "default": "Satisfaction"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "GUARANTEED"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Value",
      "default": "30 Days"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Label",
      "default": "FREE RETURNS"
    },
    {
      "type": "header",
      "content": "Stat 4"
    },
    {
      "type": "text",
      "id": "stat_4_number",
      "label": "Value",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Label",
      "default": "WORLDWIDE SHIPPING"
    }
  ],
  "presets": [
    {
      "name": "Stat Strip"
    }
  ]
}
{% endschema %}

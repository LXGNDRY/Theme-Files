{% style %}
.lb-pdp-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 20px;
  padding: 14px 0;
  border-top: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.08);
  border-bottom: 1px solid rgba(var(--color-foreground-rgb, 0,0,0), 0.08);
}

.lb-pdp-stat {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.lb-pdp-stat__num {
  font-family: 'Bebas Neue', 'Arial Black', sans-serif;
  font-size: 18px;
  font-weight: 400;
  letter-spacing: 0.06em;
  line-height: 1;
  color: rgb(var(--color-foreground-heading, var(--color-foreground, 0 0 0)));
}

.lb-pdp-stat__label {
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(var(--color-foreground-rgb, 0,0,0), 0.5);
}

/* Mobile: 3-column grid, 4th stat centred on its own row */
@media screen and (max-width: 749px) {
  .lb-pdp-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 8px;
    justify-items: center;
    text-align: center;
  }

  .lb-pdp-stat:nth-child(4) {
    grid-column: 2;
  }
}
{% endstyle %}

<div class="lb-pdp-stats" {{ block.shopify_attributes }}>
  {%- if block.settings.stat_1_number != blank or block.settings.stat_1_label != blank -%}
    <div class="lb-pdp-stat">
      <span class="lb-pdp-stat__num">{{ block.settings.stat_1_number }}</span>
      <span class="lb-pdp-stat__label">{{ block.settings.stat_1_label }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.stat_2_number != blank or block.settings.stat_2_label != blank -%}
    <div class="lb-pdp-stat">
      <span class="lb-pdp-stat__num">{{ block.settings.stat_2_number }}</span>
      <span class="lb-pdp-stat__label">{{ block.settings.stat_2_label }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.stat_3_number != blank or block.settings.stat_3_label != blank -%}
    <div class="lb-pdp-stat">
      <span class="lb-pdp-stat__num">{{ block.settings.stat_3_number }}</span>
      <span class="lb-pdp-stat__label">{{ block.settings.stat_3_label }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.stat_4_number != blank or block.settings.stat_4_label != blank -%}
    <div class="lb-pdp-stat">
      <span class="lb-pdp-stat__num">{{ block.settings.stat_4_number }}</span>
      <span class="lb-pdp-stat__label">{{ block.settings.stat_4_label }}</span>
    </div>
  {%- endif -%}
</div>

{% schema %}
